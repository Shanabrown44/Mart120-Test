 background-color: transparent;\n  background-image: none;\n  box-shadow: none;\n  margin: 0 0 0 0;\n  position: relative;\n}\n\n.thumbnailIcon {\n  color: var(--text-neutral-white-fixed);\n  background-color: var(--background-brand-purple-primary);\n  border-color: var(--borders-brand-purple-primary);\n  font-size: calc(($thumbnail-size - $thumbnail-margin-height) / 2);\n  &:hover {\n    background-color: var(--background-brand-purple-strong);\n    border-color: var(--borders-brand-purple-strong);\n  }\n  &:focus {\n    background-color: var(--background-brand-purple-strong);\n    border-color: var(--borders-brand-purple-strong);\n  }\n  .label {\n    color: var(--text-neutral-white-fixed);\n  }\n}\n\n.icon {\n  padding-top: 10px;\n}\n\n.label {\n  margin-top: 3px;\n  font-size: 12px;\n  white-space: nowrap;\n  overflow: hidden;\n  color: var(--text-neutral-primary);\n}\n\n.noLabel {\n  padding-bottom: 10px;\n}\n\n.labelIcon {\n  font-style: italic;\n}\n\n.categoryImage {\n  border-radius: 10px;\n  // Keep taller-than-square images inside the tile.\n  max-height: $preview-size;\n}\n\n.multiSelectIcon {\n  position: absolute;\n  border-style: solid;\n  border-width: 2px;\n  font-size: $hover-plus-size;\n  height: $hover-plus-size;\n  width: $hover-plus-size;\n  border-radius: 5px;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n}\n\n.hoverIcon {\n  color: var(--text-brand-purple-primary);\n  background-color: var(--background-neutral-white-fixed);\n  border-color: var(--borders-brand-purple-primary);\n}\n\n.selectIcon {\n  color: var(--text-neutral-white-fixed);\n  background-color: var(--background-success-primary);\n  border-color: var(--borders-success-primary);\n}\n\n.multiSelectBorder {\n  border-style: solid;\n  border-radius: 12px;\n  cursor: pointer;\n  border-width: 3px;\n  padding: 0;\n}\n\n.hoverBorder {\n  border-color: var(--borders-brand-purple-pri