ed) !important;\n    text-decoration: none !important;\n  }\n}\n"],sourceRoot:""}]),a.locals={actionCell:"t1HqLV86KcOw3PnGtMs7",labelCell:"EE4v3EROCVULJFhTauFQ",modalBody:"Xv0Me6q72q1TzMiSx88m",versionList:"YxkIUVY_T61bhtCFysUy",cancelButton:"NLDlUAFTv6KVfu9Z5tq8",viewVersionButton:"kIZiJUhDlqq8B0RZQHD9"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".eNs_Vi6Jik9pRFIyzlbP{display:flex;align-items:center}.w7uOYxFn5Sc48zAKH7mk{flex:0 0 260px}.w7uOYxFn5Sc48zAKH7mk input{width:100%;box-sizing:border-box;cursor:copy}.zG3dHnjo9TVwJd0nonUf{flex:0 1 260px;min-width:0}.zG3dHnjo9TVwJd0nonUf input{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}","",{version:3,sources:["webpack://./src/code-studio/components/libraries/library-id-copier.module.scss"],names:[],mappings:"AAAA,sBACE,YAAA,CACA,kBAAA,CAGF,sBACE,cAAA,CAEA,4BACE,UAAA,CACA,qBAAA,CACA,WAAA,CAMJ,sBACE,cAAA,CACA,WAAA,CAEA,4BACE,eAAA,CACA,kBAAA,CACA,sBAAA",sourcesContent:[".container {\n  display: flex;\n  align-items: center;\n}\n\n.copy {\n  flex: 0 0 260px;\n\n  input {\n    width: 100%;\n    box-sizing: border-box;\n    cursor: copy;\n  }\n}\n\n// Used when this component renders in a narrower layout (e.g. next to\n// SortedTableSelect's fixed-width table) that can't always fit the full ID.\n.copyCompact {\n  flex: 0 1 260px;\n  min-width: 0;\n\n  input {\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n}\n"],sourceRoot:""}]),a.locals={container:"eNs_Vi6Jik9pRFIyzlbP",copy:"w7uOYxFn5Sc48zAKH7mk",copyCompact:"zG3dHnjo9TVwJd0nonUf"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".WCCOsBTWm3jq8AWdkzup{width:100%;align-self:stretch}","",{version:3,sources:["webpack://./src/code-studio/components/project-abuse-alert.module.scss"],names:[],mappings:"AAAA,sBACE,UAAA,CACA,kBAAA",sourcesContent:[".alert {\n  width: 100%;\n  align-self: stretch;\n}\n"],source