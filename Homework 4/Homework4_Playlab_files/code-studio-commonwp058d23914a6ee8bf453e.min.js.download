-20: #fef8c3;\n  --sentiment-warning-30: #fded8b;\n  --sentiment-warning-40: #fcdc48;\n  --sentiment-warning-50: #f9cb28;\n  --sentiment-warning-60: #e9ae09;\n  --sentiment-warning-70: #c78404;\n  --sentiment-warning-80: #a05f08;\n  --sentiment-warning-90: #7d4b07;\n}\n',"",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/primitiveColors.css"],names:[],mappings:"AAAA;;;;EAIE;;AAEF;;;;;;EAME;;AAEF,qBAAqB;AACrB,uCAAuC;AACvC;EACE,2BAA2B;EAC3B,4BAA4B;EAC5B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,2BAA2B;EAC3B,+BAA+B;EAC/B,gCAAgC;EAChC,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,wBAAwB;EACxB,yBAAyB;EACzB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,0BAA0B;EAC1B,2BAA2B;EAC3B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,yBAAyB;EACzB,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,wBAAwB;EACxB,yBAAyB;EACzB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,uBAAuB;EACvB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,wBAAwB;EACxB,6BAA6B;EAC7B,kCAAkC;EAClC,6BAA6B;EAC7B,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,kCAAkC;EAClC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,yBAAyB;EACzB,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,0BAA0B;EAC1B,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,kCAAkC;EAClC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,6BAA6B;EAC7B,8BAA8B;EAC9B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,6BAA6B;EAC7B,mCAAmC;EACnC,oCAAoC;EACpC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,mCAAmC;EACnC,+BAA+B;EAC/B,gCAAgC;EAChC,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,gCAAgC;EAChC,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;EAC/B,+BAA+B;AACjC",sourcesContent:['/* This is a collection of Primitive Colors.\n Unlike Semantic colors (colors.css) these variables will be equal to the same color value in all themes.\n Ideally, these colors should be used for components that are not theme dependent.\n In the future it\'s possible that we will only need to use these colors in Semantic colors (colors.css).\n */\n\n/* Colors are taken from DISCO Variables New Figma File - Primitive colors variables collection\n via variables2css plugin that generates css code based on Figma variables values and names.\n We\'re using css here in order to support not only scss, but also css files.\n :root is used here instead of "[data-theme="Mode 1"]" to define css variables\n that can be used in the entire app. \n Also, stylelint fix might be required for autogenerated colors, which can be done in one command.\n */\n\n/* Primitive Colors */\n/* stylelint-disable color-hex-length */\n:root {\n  --accent-orange-10: #fff6e5;\n  --accent-orange-100: #5c3b00;\n  --accent-orange-20: #ffe5b7;\n  --accent-orange-30: #ffd58a;\n  --accent-orange-40: #ffc55c;\n  --accent-orange-50: #ffb42e;\n  --accent-orange-60: #ffa400;\n  --accent-orange-70: #d68a00;\n  --accent-orange-80: #ad7000;\n  --accent-orange-90: #855500;\n  --accent-strawberry-10: #ffe3e3;\n  --accent-strawberry-100: #430d0d;\n  --accent-strawberry-20: #ffcdcd;\n  --accent-strawberry-30: #ffabab;\n  --accent-strawberry-40: #f88585;\n  --accent-strawberry-50: #ed6060;\n  --accent-strawberry-60: #cb4a4a;\n  --accent-strawberry-70: #a93737;\n  --accent-strawberry-80: #872626;\n  --accent-strawberry-90: #651818;\n  --brand-aqua-10: #ebfffe;\n  --brand-aqua-100: #005552;\n  --brand-aqua-20: #bffffc;\n  --brand-aqua-30: #94fffb;\n  --brand-aqua-40: #68fff9;\n  --brand-aqua-50: #3cfff7;\n  --brand-aqua-60: #29ddd6;\n  --brand-aqua-70: #19bbb5;\n  --brand-aqua-80: #0d9994;\n  --brand-aqua-90: #047773;\n  --brand-purple-10: #e8cbff;\n  --brand-purple-100: #2f1c3e;\n  --brand-purple-20: #d4a8f7;\n  --brand-purple-30: #c18deb;\n  --brand-purple-40: #a86cd8;\n  --brand-purple-5: #f2e2ff;\n  --brand-purple-50: #9657c7;\n  --brand-purple-60: #7f4aa9;\n  --brand-purple-70: #6c468a;\n  --brand-purple-80: #5c3778;\n  --brand-purple-90: #46295c;\n  --brand-teal-10: #bfe4e8;\n  --brand-teal-100: #00383f;\n  --brand-teal-20: #aed8dc;\n  --brand-teal-30: #85cad1;\n  --brand-teal-40: #50b2bd;\n  --brand-teal-5: #e0f8f9;\n  --brand-teal-50: #0093a4;\n  --brand-teal-60: #00818f;\n  --brand-teal-70: #007785;\n  --brand-teal-80: #00636e;\n  --brand-teal-90: #004b54;\n  --neutral-base-black: #292f36;\n  --neutral-base-true-black: #000000;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-10: #292f361a;\n  --neutral-black-alpha-20: #292f3633;\n  --neutral-black-alpha-30: #292f364d;\n  --neutral-black-alpha-40: #292f3666;\n  --neutral-black-alpha-5: #292f360d;\n  --neutral-black-alpha-50: #292f3680;\n  --neutral-black-alpha-60: #292f3699;\n  --neutral-black-alpha-70: #292f36b2;\n  --neutral-black-alpha-80: #292f36cc;\n  --neutral-black-alpha-90: #292f36e5;\n  --neutral-black-alpha-95: #292f36f2;\n  --neutral-gray-10: #dfe3e9;\n  --neutral-gray-20: #d4dae1;\n  --neutral-gray-30: #c6ced6;\n  --neutral-gray-40: #b7c1cb;\n  --neutral-gray-5: #f0f2f5;\n  --neutral-gray-50: #a1aebb;\n  --neutral-gray-60: #8896a7;\n  --neutral-gray-70: #768699;\n  --neutral-gray-80: #69788a;\n  --neutral-gray-90: #576575;\n  --neutral-gray-95: #424d59;\n  --neutral-gray-99: #121212;\n  --neutral-white-alpha-10: #ffffff1a;\n  --neutral-white-alpha-20: #ffffff33;\n  --neutral-white-alpha-30: #ffffff4d;\n  --neutral-white-alpha-40: #ffffff66;\n  --neutral-white-alpha-5: #ffffff0d;\n  --neutral-white-alpha-50: #ffffff80;\n  --neutral-white-alpha-60: #ffffff99;\n  --neutral-white-alpha-70: #ffffffb2;\n  --neutral-white-alpha-80: #ffffffcc;\n  --neutral-white-alpha-90: #ffffffe5;\n  --neutral-white-alpha-95: #fffffff2;\n  --sentiment-error-10: #ffe1dd;\n  --sentiment-error-100: #480e07;\n  --sentiment-error-20: #ffbfb6;\n  --sentiment-error-30: #ff8677;\n  --sentiment-error-40: #f95d4a;\n  --sentiment-error-50: #e02d16;\n  --sentiment-error-60: #c12814;\n  --sentiment-error-70: #aa2513;\n  --sentiment-error-80: #842418;\n  --sentiment-error-90: #6a1b11;\n  --sentiment-information-10: #dceffb;\n  --sentiment-information-100: #0b2946;\n  --sentiment-information-20: #bde0fa;\n  --sentiment-information-30: #83c7f6;\n  --sentiment-information-40: #40aaf0;\n  --sentiment-information-50: #1892e3;\n  --sentiment-information-60: #0b71be;\n  --sentiment-information-70: #0a5a9a;\n  --sentiment-information-80: #0d4d7f;\n  --sentiment-information-90: #10416a;\n  --sentiment-success-10: #e2f6e2;\n  --sentiment-success-100: #0e360f;\n  --sentiment-success-20: #c7ecc6;\n  --sentiment-success-30: #9adc99;\n  --sentiment-success-40: #66c365;\n  --sentiment-success-50: #3ea33e;\n  --sentiment-success-60: #308930;\n  --sentiment-success-70: #286d29;\n  --sentiment-success-80: #245724;\n  --sentiment-success-90: #1f4820;\n  --sentiment-warning-10: #fefce8;\n  --sentiment-warning-100: #5e330f;\n  --sentiment-warning-20: #fef8c3;\n  --sentiment-warning-30: #fded8b;\n  --sentiment-warning-40: #fcdc48;\n  --sentiment-warning-50: #f9cb28;\n  --sentiment-warning-60: #e9ae09;\n  --sentiment-warning-70: #c78404;\n  --sentiment-warning-80: #a05f08;\n  --sentiment-warning-90: #7d4b07;\n}\n'],sourceRoot:""}]);const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,"/* CADS token names under the legacy brands.\n *\n * Code migrated to the CADS token schema (colors_codeAi.css) before the\n * brand cutover must still render under the legacy brands ('code',\n * 'codeai'), where only the colors.css tokens exist. This file defines\n * every CADS-only token name in terms of its nearest legacy equivalent.\n * CADS names that also exist in the legacy schema (most neutrals and\n * sentiment primaries) are already defined by colors.css and are not\n * listed.\n *\n * This is a best-effort visual bridge, not a design statement:\n *   - the CADS brand family maps to legacy teal (the legacy brand\n *     primary); CADS light/mid map to legacy extra-light/light;\n *   - all CADS disabled-<family> tokens collapse onto the single legacy\n *     neutral disabled tokens;\n *   - selected-* and accent mids have no legacy semantic equivalent and\n *     point at legacy primitives (theme-fixed, commented below);\n *   - accent-pink maps to legacy strawberry.\n *\n * Rows that reference legacy SEMANTIC tokens follow Light/Dark\n * automatically; rows that reference legacy primitives do not, which is\n * acceptable for a pre-cutover shim (dark mode ships with the CADS\n * schema, not the legacy one).\n *\n * Under both CADS brands every one of these names is re-declared at\n * higher specificity by the brand's own token file — brandCodeAiNext.css\n * for codeai-next, brandCodeAiAudit.css for codeai-audit — so this file\n * is inert there. That is what keeps the audit brand honest: were any\n * CADS name to fall through to this shim, it would render its real\n * legacy color under an audit that claims every token is pink.\n * Delete this file at brand cutover cleanup.\n *\n * The [data-theme] selectors exist because custom properties substitute\n * their var() chains on the declaring element and inherit as resolved\n * values: without re-declaration on theme-carrying elements, a dark\n * subtree would inherit light-resolved values from <html>.\n */\n\n:root,\n[data-theme='Light'],\n[data-theme='Dark'] {\n  /* Backgrounds — alpha scale (dark overrides below) */\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n\n  /* Backgrounds — brand (legacy brand primary is teal) */\n  --background-brand-primary: var(--background-brand-teal-primary);\n  --background-brand-light: var(--background-brand-teal-extra-light);\n  --background-brand-mid: var(--background-brand-teal-light);\n  --background-brand-strong: var(--background-brand-teal-strong);\n\n  /* Backgrounds — sentiment mid steps (legacy called this step light) */\n  --background-error-mid: var(--background-error-light);\n  --background-warning-mid: var(--background-warning-light);\n  --background-success-mid: var(--background-success-light);\n  --background-info-mid: var(--background-info-light);\n\n  /* Backgrounds — selected state (no legacy equivalent; teal fill). The\n     inverse is the legacy selected-menu glyph box: white on the teal\n     row (paired with a teal check via text-selected-primary-inverse). */\n  --background-selected-primary: var(--background-brand-teal-strong);\n  --background-selected-strong: var(\n    --brand-teal-80\n  ); /* primitive: theme-fixed */\n\n  --background-selected-primary-inverse: var(--background-neutral-white-fixed);\n\n  /* Backgrounds — disabled family collapses onto legacy neutral disabled */\n  --background-disabled-brand: var(--background-neutral-disabled);\n  --background-disabled-error: var(--background-neutral-disabled);\n  --background-disabled-info: var(--background-neutral-disabled);\n  --background-disabled-neutral: var(--background-neutral-disabled);\n  --background-disabled-orange: var(--background-neutral-disabled);\n  --background-disabled-pink: var(--background-neutral-disabled);\n  --background-disabled-success: var(--background-neutral-disabled);\n  --background-disabled-warning: var(--background-neutral-disabled);\n\n  /* Backgrounds — accents (pink maps to legacy strawberry) */\n  --background-accent-orange-mid: var(\n    --accent-orange-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-primary: var(--background-accent-strawberry-primary);\n  --background-accent-pink-light: var(--background-accent-strawberry-light);\n  --background-accent-pink-mid: var(\n    --accent-strawberry-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-strong: var(--background-accent-strawberry-strong);\n\n  /* Borders — CADS drops the plural */\n  --border-neutral-primary: var(--borders-neutral-primary);\n  --border-neutral-secondary: var(--borders-neutral-strong);\n  --border-neutral-solid: var(--borders-neutral-solid);\n  --border-neutral-white-fixed: var(--borders-neutral-white-fixed);\n  --border-neutral-black-fixed: var(\n    --neutral-base-black\n  ); /* primitive: theme-fixed */\n\n  --border-brand-primary: var(--borders-brand-teal-primary);\n  --border-brand-light: var(--borders-brand-teal-light);\n  --border-brand-mid: var(--brand-teal-20); /* primitive: theme-fixed */\n  --border-brand-strong: var(--borders-brand-teal-strong);\n  --border-error-primary: var(--borders-error-primary);\n  --border-error-light: var(--borders-error-light);\n  --border-error-mid: var(--sentiment-error-30); /* primitive: theme-fixed */\n  --border-error-strong: var(--borders-error-strong);\n  --border-warning-primary: var(--borders-warning-primary);\n  --border-warning-light: var(--borders-warning-light);\n  --border-warning-mid: var(\n    --sentiment-warning-30\n  ); /* primitive: theme-fixed */\n\n  --border-warning-strong: var(--borders-warning-strong);\n  --border-success-primary: var(--borders-success-primary);\n  --border-success-light: var(--borders-success-light);\n  --border-success-mid: var(\n    --sentiment-success-30\n  ); /* primitive: theme-fixed */\n\n  --border-success-strong: var(--borders-success-strong);\n  --border-info-primary: var(--borders-info-primary);\n  --border-info-light: var(--borders-info-light);\n  --border-info-mid: var(\n    --sentiment-information-30\n  ); /* primitive: theme-fixed */\n\n  --border-info-strong: var(--borders-info-strong);\n  --border-selected-primary: var(--borders-brand-teal-strong);\n  --border-selected-strong: var(--brand-teal-80); /* primitive: theme-fixed */\n  --border-selected-primary-inverse: var(--borders-neutral-white-fixed);\n\n  /* Focus ring: legacy teal; inverse ring (on a selected fill) goes\n     white to contrast. */\n  --border-focused-primary: var(--borders-brand-teal-primary);\n  --border-focused-inverse: var(--borders-neutral-white-fixed);\n  --border-disabled-brand: var(--borders-neutral-disabled);\n  --border-disabled-error: var(--borders-neutral-disabled);\n  --border-disabled-info: var(--borders-neutral-disabled);\n  --border-disabled-neutral: var(--borders-neutral-disabled);\n  --border-disabled-orange: var(--borders-neutral-disabled);\n  --border-disabled-pink: var(--borders-neutral-disabled);\n  --border-disabled-success: var(--borders-neutral-disabled);\n  --border-disabled-warning: var(--borders-neutral-disabled);\n\n  /* Accent borders mirror the CADS ramp steps on legacy primitives\n     (theme-fixed); legacy had no semantic accent borders. */\n  --border-accent-orange-primary: var(--accent-orange-50);\n  --border-accent-orange-light: var(--accent-orange-30);\n  --border-accent-orange-mid: var(--accent-orange-30);\n  --border-accent-orange-strong: var(--accent-orange-70);\n  --border-accent-pink-primary: var(--accent-strawberry-50);\n  --border-accent-pink-light: var(--accent-strawberry-30);\n  --border-accent-pink-mid: var(--accent-strawberry-30);\n  --border-accent-pink-strong: var(--accent-strawberry-70);\n\n  /* Text */\n  --text-neutral-primary-inverse: var(--text-neutral-inverse);\n  --text-brand-primary: var(--text-brand-teal-primary);\n  --text-brand-secondary: var(--text-brand-teal-secondary);\n  --text-brand-primary-fixed: var(--text-brand-teal-primary-fixed);\n  --text-selected-primary: var(--text-neutral-inverse);\n  --text-selected-primary-inverse: var(--text-brand-teal-primary);\n  --text-disabled-brand: var(--text-neutral-disabled);\n  --text-disabled-error: var(--text-neutral-disabled);\n  --text-disabled-info: var(--text-neutral-disabled);\n  --text-disabled-neutral: var(--text-neutral-disabled);\n  --text-disabled-neutral-inverse: var(--text-neutral-disabled-inverse);\n  --text-disabled-orange: var(--text-neutral-disabled);\n  --text-disabled-pink: var(--text-neutral-disabled);\n  --text-disabled-success: var(--text-neutral-disabled);\n  --text-disabled-warning: var(--text-neutral-disabled);\n\n  /* Accent text on legacy primitives (theme-fixed); orange sits at the\n     60 step, the darkest orange in legacy text use. */\n  --text-accent-orange-primary: var(--accent-orange-60);\n  --text-accent-orange-secondary: var(--accent-orange-80);\n  --text-accent-orange-primary-fixed: var(--accent-orange-60);\n  --text-accent-pink-primary: var(--accent-strawberry-50);\n  --text-accent-pink-secondary: var(--accent-strawberry-70);\n  --text-accent-pink-primary-fixed: var(--accent-strawberry-50);\n\n  /* CADS-only primitives with no legacy name at all (direct primitive\n     usage is rare and currently unused, but must not fall through to an\n     unresolved var() under this brand). Same-step mapping into the\n     nearest legacy family; legacy's extra \"100\" step (which CADS dropped)\n     absorbs CADS's \"95\" step, mirroring the reverse mapping in\n     brandLegacyAliases.css. brand-orange has no legacy brand\n     counterpart, so it maps to legacy's accent-orange; brand-pink maps to\n     accent-strawberry, same as the pink/strawberry semantic mapping\n     above. */\n  --brand-purple-95: var(--brand-purple-100);\n  --brand-orange-5: var(--accent-orange-10);\n  --brand-orange-10: var(--accent-orange-10);\n  --brand-orange-20: var(--accent-orange-20);\n  --brand-orange-30: var(--accent-orange-30);\n  --brand-orange-40: var(--accent-orange-40);\n  --brand-orange-50: var(--accent-orange-50);\n  --brand-orange-60: var(--accent-orange-60);\n  --brand-orange-70: var(--accent-orange-70);\n  --brand-orange-80: var(--accent-orange-80);\n  --brand-orange-90: var(--accent-orange-90);\n  --brand-orange-95: var(--accent-orange-100);\n  --brand-pink-5: var(--accent-strawberry-10);\n  --brand-pink-10: var(--accent-strawberry-10);\n  --brand-pink-20: var(--accent-strawberry-20);\n  --brand-pink-30: var(--accent-strawberry-30);\n  --brand-pink-40: var(--accent-strawberry-40);\n  --brand-pink-50: var(--accent-strawberry-50);\n  --brand-pink-60: var(--accent-strawberry-60);\n  --brand-pink-70: var(--accent-strawberry-70);\n  --brand-pink-80: var(--accent-strawberry-80);\n  --brand-pink-90: var(--accent-strawberry-90);\n  --brand-pink-95: var(--accent-strawberry-100);\n  --sentiment-error-5: var(--sentiment-error-10);\n  --sentiment-error-95: var(--sentiment-error-100);\n  --sentiment-information-5: var(--sentiment-information-10);\n  --sentiment-information-95: var(--sentiment-information-100);\n  --sentiment-success-5: var(--sentiment-success-10);\n  --sentiment-success-95: var(--sentiment-success-100);\n  --sentiment-warning-5: var(--sentiment-warning-10);\n  --sentiment-warning-95: var(--sentiment-warning-100);\n}\n\n/* Dark: the alpha scale flips to white, mirroring the CADS dark block. */\n[data-theme='Dark'] {\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n}\n","",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/brandLegacyShim.css"],names:[],mappings:"AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EAoCE;;AAEF;;;EAGE,qDAAqD;EACrD,0DAA0D;EAC1D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;;EAE5D,uDAAuD;EACvD,gEAAgE;EAChE,kEAAkE;EAClE,0DAA0D;EAC1D,8DAA8D;;EAE9D,sEAAsE;EACtE,qDAAqD;EACrD,yDAAyD;EACzD,yDAAyD;EACzD,mDAAmD;;EAEnD;;wEAEsE;EACtE,kEAAkE;EAClE;;GAEC,EAAE,2BAA2B;;EAE9B,4EAA4E;;EAE5E,yEAAyE;EACzE,+DAA+D;EAC/D,+DAA+D;EAC/D,8DAA8D;EAC9D,iEAAiE;EACjE,gEAAgE;EAChE,8DAA8D;EAC9D,iEAAiE;EACjE,iEAAiE;;EAEjE,2DAA2D;EAC3D;;GAEC,EAAE,2BAA2B;;EAE9B,6EAA6E;EAC7E,yEAAyE;EACzE;;GAEC,EAAE,2BAA2B;;EAE9B,2EAA2E;;EAE3E,oCAAoC;EACpC,wDAAwD;EACxD,yDAAyD;EACzD,oDAAoD;EACpD,gEAAgE;EAChE;;GAEC,EAAE,2BAA2B;;EAE9B,yDAAyD;EACzD,qDAAqD;EACrD,wCAAwC,EAAE,2BAA2B;EACrE,uDAAuD;EACvD,oDAAoD;EACpD,gDAAgD;EAChD,6CAA6C,EAAE,2BAA2B;EAC1E,kDAAkD;EAClD,wDAAwD;EACxD,oDAAoD;EACpD;;GAEC,EAAE,2BAA2B;;EAE9B,sDAAsD;EACtD,wDAAwD;EACxD,oDAAoD;EACpD;;GAEC,EAAE,2BAA2B;;EAE9B,sDAAsD;EACtD,kDAAkD;EAClD,8CAA8C;EAC9C;;GAEC,EAAE,2BAA2B;;EAE9B,gDAAgD;EAChD,2DAA2D;EAC3D,8CAA8C,EAAE,2BAA2B;EAC3E,qEAAqE;;EAErE;yBACuB;EACvB,2DAA2D;EAC3D,4DAA4D;EAC5D,wDAAwD;EACxD,wDAAwD;EACxD,uDAAuD;EACvD,0DAA0D;EAC1D,yDAAyD;EACzD,uDAAuD;EACvD,0DAA0D;EAC1D,0DAA0D;;EAE1D;4DAC0D;EAC1D,uDAAuD;EACvD,qDAAqD;EACrD,mDAAmD;EACnD,sDAAsD;EACtD,yDAAyD;EACzD,uDAAuD;EACvD,qDAAqD;EACrD,wDAAwD;;EAExD,SAAS;EACT,2DAA2D;EAC3D,oDAAoD;EACpD,wDAAwD;EACxD,gEAAgE;EAChE,oDAAoD;EACpD,+DAA+D;EAC/D,mDAAmD;EACnD,mDAAmD;EACnD,kDAAkD;EAClD,qDAAqD;EACrD,qEAAqE;EACrE,oDAAoD;EACpD,kDAAkD;EAClD,qDAAqD;EACrD,qDAAqD;;EAErD;sDACoD;EACpD,qDAAqD;EACrD,uDAAuD;EACvD,2DAA2D;EAC3D,uDAAuD;EACvD,yDAAyD;EACzD,6DAA6D;;EAE7D;;;;;;;;aAQW;EACX,0CAA0C;EAC1C,yCAAyC;EACzC,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,0CAA0C;EAC1C,2CAA2C;EAC3C,2CAA2C;EAC3C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,4CAA4C;EAC5C,6CAA6C;EAC7C,8CAA8C;EAC9C,gDAAgD;EAChD,0DAA0D;EAC1D,4DAA4D;EAC5D,kDAAkD;EAClD,oDAAoD;EACpD,kDAAkD;EAClD,oDAAoD;AACtD;;AAEA,yEAAyE;AACzE;EACE,0DAA0D;EAC1D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;EAC5D,4DAA4D;AAC9D",sourcesContent:["/* CADS token names under the legacy brands.\n *\n * Code migrated to the CADS token schema (colors_codeAi.css) before the\n * brand cutover must still render under the legacy brands ('code',\n * 'codeai'), where only the colors.css tokens exist. This file defines\n * every CADS-only token name in terms of its nearest legacy equivalent.\n * CADS names that also exist in the legacy schema (most neutrals and\n * sentiment primaries) are already defined by colors.css and are not\n * listed.\n *\n * This is a best-effort visual bridge, not a design statement:\n *   - the CADS brand family maps to legacy teal (the legacy brand\n *     primary); CADS light/mid map to legacy extra-light/light;\n *   - all CADS disabled-<family> tokens collapse onto the single legacy\n *     neutral disabled tokens;\n *   - selected-* and accent mids have no legacy semantic equivalent and\n *     point at legacy primitives (theme-fixed, commented below);\n *   - accent-pink maps to legacy strawberry.\n *\n * Rows that reference legacy SEMANTIC tokens follow Light/Dark\n * automatically; rows that reference legacy primitives do not, which is\n * acceptable for a pre-cutover shim (dark mode ships with the CADS\n * schema, not the legacy one).\n *\n * Under both CADS brands every one of these names is re-declared at\n * higher specificity by the brand's own token file — brandCodeAiNext.css\n * for codeai-next, brandCodeAiAudit.css for codeai-audit — so this file\n * is inert there. That is what keeps the audit brand honest: were any\n * CADS name to fall through to this shim, it would render its real\n * legacy color under an audit that claims every token is pink.\n * Delete this file at brand cutover cleanup.\n *\n * The [data-theme] selectors exist because custom properties substitute\n * their var() chains on the declaring element and inherit as resolved\n * values: without re-declaration on theme-carrying elements, a dark\n * subtree would inherit light-resolved values from <html>.\n */\n\n:root,\n[data-theme='Light'],\n[data-theme='Dark'] {\n  /* Backgrounds — alpha scale (dark overrides below) */\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n\n  /* Backgrounds — brand (legacy brand primary is teal) */\n  --background-brand-primary: var(--background-brand-teal-primary);\n  --background-brand-light: var(--background-brand-teal-extra-light);\n  --background-brand-mid: var(--background-brand-teal-light);\n  --background-brand-strong: var(--background-brand-teal-strong);\n\n  /* Backgrounds — sentiment mid steps (legacy called this step light) */\n  --background-error-mid: var(--background-error-light);\n  --background-warning-mid: var(--background-warning-light);\n  --background-success-mid: var(--background-success-light);\n  --background-info-mid: var(--background-info-light);\n\n  /* Backgrounds — selected state (no legacy equivalent; teal fill). The\n     inverse is the legacy selected-menu glyph box: white on the teal\n     row (paired with a teal check via text-selected-primary-inverse). */\n  --background-selected-primary: var(--background-brand-teal-strong);\n  --background-selected-strong: var(\n    --brand-teal-80\n  ); /* primitive: theme-fixed */\n\n  --background-selected-primary-inverse: var(--background-neutral-white-fixed);\n\n  /* Backgrounds — disabled family collapses onto legacy neutral disabled */\n  --background-disabled-brand: var(--background-neutral-disabled);\n  --background-disabled-error: var(--background-neutral-disabled);\n  --background-disabled-info: var(--background-neutral-disabled);\n  --background-disabled-neutral: var(--background-neutral-disabled);\n  --background-disabled-orange: var(--background-neutral-disabled);\n  --background-disabled-pink: var(--background-neutral-disabled);\n  --background-disabled-success: var(--background-neutral-disabled);\n  --background-disabled-warning: var(--background-neutral-disabled);\n\n  /* Backgrounds — accents (pink maps to legacy strawberry) */\n  --background-accent-orange-mid: var(\n    --accent-orange-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-primary: var(--background-accent-strawberry-primary);\n  --background-accent-pink-light: var(--background-accent-strawberry-light);\n  --background-accent-pink-mid: var(\n    --accent-strawberry-30\n  ); /* primitive: theme-fixed */\n\n  --background-accent-pink-strong: var(--background-accent-strawberry-strong);\n\n  /* Borders — CADS drops the plural */\n  --border-neutral-primary: var(--borders-neutral-primary);\n  --border-neutral-secondary: var(--borders-neutral-strong);\n  --border-neutral-solid: var(--borders-neutral-solid);\n  --border-neutral-white-fixed: var(--borders-neutral-white-fixed);\n  --border-neutral-black-fixed: var(\n    --neutral-base-black\n  ); /* primitive: theme-fixed */\n\n  --border-brand-primary: var(--borders-brand-teal-primary);\n  --border-brand-light: var(--borders-brand-teal-light);\n  --border-brand-mid: var(--brand-teal-20); /* primitive: theme-fixed */\n  --border-brand-strong: var(--borders-brand-teal-strong);\n  --border-error-primary: var(--borders-error-primary);\n  --border-error-light: var(--borders-error-light);\n  --border-error-mid: var(--sentiment-error-30); /* primitive: theme-fixed */\n  --border-error-strong: var(--borders-error-strong);\n  --border-warning-primary: var(--borders-warning-primary);\n  --border-warning-light: var(--borders-warning-light);\n  --border-warning-mid: var(\n    --sentiment-warning-30\n  ); /* primitive: theme-fixed */\n\n  --border-warning-strong: var(--borders-warning-strong);\n  --border-success-primary: var(--borders-success-primary);\n  --border-success-light: var(--borders-success-light);\n  --border-success-mid: var(\n    --sentiment-success-30\n  ); /* primitive: theme-fixed */\n\n  --border-success-strong: var(--borders-success-strong);\n  --border-info-primary: var(--borders-info-primary);\n  --border-info-light: var(--borders-info-light);\n  --border-info-mid: var(\n    --sentiment-information-30\n  ); /* primitive: theme-fixed */\n\n  --border-info-strong: var(--borders-info-strong);\n  --border-selected-primary: var(--borders-brand-teal-strong);\n  --border-selected-strong: var(--brand-teal-80); /* primitive: theme-fixed */\n  --border-selected-primary-inverse: var(--borders-neutral-white-fixed);\n\n  /* Focus ring: legacy teal; inverse ring (on a selected fill) goes\n     white to contrast. */\n  --border-focused-primary: var(--borders-brand-teal-primary);\n  --border-focused-inverse: var(--borders-neutral-white-fixed);\n  --border-disabled-brand: var(--borders-neutral-disabled);\n  --border-disabled-error: var(--borders-neutral-disabled);\n  --border-disabled-info: var(--borders-neutral-disabled);\n  --border-disabled-neutral: var(--borders-neutral-disabled);\n  --border-disabled-orange: var(--borders-neutral-disabled);\n  --border-disabled-pink: var(--borders-neutral-disabled);\n  --border-disabled-success: var(--borders-neutral-disabled);\n  --border-disabled-warning: var(--borders-neutral-disabled);\n\n  /* Accent borders mirror the CADS ramp steps on legacy primitives\n     (theme-fixed); legacy had no semantic accent borders. */\n  --border-accent-orange-primary: var(--accent-orange-50);\n  --border-accent-orange-light: var(--accent-orange-30);\n  --border-accent-orange-mid: var(--accent-orange-30);\n  --border-accent-orange-strong: var(--accent-orange-70);\n  --border-accent-pink-primary: var(--accent-strawberry-50);\n  --border-accent-pink-light: var(--accent-strawberry-30);\n  --border-accent-pink-mid: var(--accent-strawberry-30);\n  --border-accent-pink-strong: var(--accent-strawberry-70);\n\n  /* Text */\n  --text-neutral-primary-inverse: var(--text-neutral-inverse);\n  --text-brand-primary: var(--text-brand-teal-primary);\n  --text-brand-secondary: var(--text-brand-teal-secondary);\n  --text-brand-primary-fixed: var(--text-brand-teal-primary-fixed);\n  --text-selected-primary: var(--text-neutral-inverse);\n  --text-selected-primary-inverse: var(--text-brand-teal-primary);\n  --text-disabled-brand: var(--text-neutral-disabled);\n  --text-disabled-error: var(--text-neutral-disabled);\n  --text-disabled-info: var(--text-neutral-disabled);\n  --text-disabled-neutral: var(--text-neutral-disabled);\n  --text-disabled-neutral-inverse: var(--text-neutral-disabled-inverse);\n  --text-disabled-orange: var(--text-neutral-disabled);\n  --text-disabled-pink: var(--text-neutral-disabled);\n  --text-disabled-success: var(--text-neutral-disabled);\n  --text-disabled-warning: var(--text-neutral-disabled);\n\n  /* Accent text on legacy primitives (theme-fixed); orange sits at the\n     60 step, the darkest orange in legacy text use. */\n  --text-accent-orange-primary: var(--accent-orange-60);\n  --text-accent-orange-secondary: var(--accent-orange-80);\n  --text-accent-orange-primary-fixed: var(--accent-orange-60);\n  --text-accent-pink-primary: var(--accent-strawberry-50);\n  --text-accent-pink-secondary: var(--accent-strawberry-70);\n  --text-accent-pink-primary-fixed: var(--accent-strawberry-50);\n\n  /* CADS-only primitives with no legacy name at all (direct primitive\n     usage is rare and currently unused, but must not fall through to an\n     unresolved var() under this brand). Same-step mapping into the\n     nearest legacy family; legacy's extra \"100\" step (which CADS dropped)\n     absorbs CADS's \"95\" step, mirroring the reverse mapping in\n     brandLegacyAliases.css. brand-orange has no legacy brand\n     counterpart, so it maps to legacy's accent-orange; brand-pink maps to\n     accent-strawberry, same as the pink/strawberry semantic mapping\n     above. */\n  --brand-purple-95: var(--brand-purple-100);\n  --brand-orange-5: var(--accent-orange-10);\n  --brand-orange-10: var(--accent-orange-10);\n  --brand-orange-20: var(--accent-orange-20);\n  --brand-orange-30: var(--accent-orange-30);\n  --brand-orange-40: var(--accent-orange-40);\n  --brand-orange-50: var(--accent-orange-50);\n  --brand-orange-60: var(--accent-orange-60);\n  --brand-orange-70: var(--accent-orange-70);\n  --brand-orange-80: var(--accent-orange-80);\n  --brand-orange-90: var(--accent-orange-90);\n  --brand-orange-95: var(--accent-orange-100);\n  --brand-pink-5: var(--accent-strawberry-10);\n  --brand-pink-10: var(--accent-strawberry-10);\n  --brand-pink-20: var(--accent-strawberry-20);\n  --brand-pink-30: var(--accent-strawberry-30);\n  --brand-pink-40: var(--accent-strawberry-40);\n  --brand-pink-50: var(--accent-strawberry-50);\n  --brand-pink-60: var(--accent-strawberry-60);\n  --brand-pink-70: var(--accent-strawberry-70);\n  --brand-pink-80: var(--accent-strawberry-80);\n  --brand-pink-90: var(--accent-strawberry-90);\n  --brand-pink-95: var(--accent-strawberry-100);\n  --sentiment-error-5: var(--sentiment-error-10);\n  --sentiment-error-95: var(--sentiment-error-100);\n  --sentiment-information-5: var(--sentiment-information-10);\n  --sentiment-information-95: var(--sentiment-information-100);\n  --sentiment-success-5: var(--sentiment-success-10);\n  --sentiment-success-95: var(--sentiment-success-100);\n  --sentiment-warning-5: var(--sentiment-warning-10);\n  --sentiment-warning-95: var(--sentiment-warning-100);\n}\n\n/* Dark: the alpha scale flips to white, mirroring the CADS dark block. */\n[data-theme='Dark'] {\n  --background-neutral-alpha-5: var(--neutral-white-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-white-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-white-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-white-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-white-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-white-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-white-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-white-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-white-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-white-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-white-alpha-95);\n}\n"],sourceRoot:""}]);const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,"/* GENERATED FILE — do not edit.\n * Source: primitiveColors_codeAi.css + colors_codeAi.css (canonical CADS\n * exports), rescoped under [data-brand='codeai-next'] by\n * scripts/generateBrandCodeAiNext.mjs. Re-run that script after design\n * re-exports either source file.\n *\n * At brand cutover this file is deleted and the canonical files take over\n * at :root (see colors.css / primitiveColors.css retirement plan).\n */\n\n/* Primitive Colors */\n\n/* This file consists of primitive color tokens. These values are fixed, theme-agnostic and defined at the level of the brand guidelines. */\n\n/* Aim to use semantic color tokens (colors.css) over primitive colors in the majority of cases. Primitive colors may be used for components that are truly theme-agnostic and have no semantic meaning. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* stylelint-disable color-hex-length */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'],\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Light'],\n[data-brand='codeai-next'][data-theme='Dark'],\n[data-brand='codeai-next'] [data-theme='Dark'] {\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-40: #6f67d9;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-60: #4238c4;\n  --brand-purple-70: #3228b7;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-purple-95: #1f1976;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-10: #ffd2b3;\n  --brand-orange-20: #ffbd8a;\n  --brand-orange-30: #ffa868;\n  --brand-orange-40: #ff8b38;\n  --brand-orange-50: #f46800;\n  --brand-orange-60: #d15900;\n  --brand-orange-70: #b34800;\n  --brand-orange-80: #942f00;\n  --brand-orange-90: #701c00;\n  --brand-orange-95: #611d00;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-10: #f3c3d8;\n  --brand-pink-20: #eea1c3;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-40: #eb5895;\n  --brand-pink-50: #e11970;\n  --brand-pink-60: #ce035b;\n  --brand-pink-70: #b5004f;\n  --brand-pink-80: #a10448;\n  --brand-pink-90: #8d003d;\n  --brand-pink-95: #7d0c3d;\n  --neutral-base-black: #121212;\n  --neutral-base-true-black: #000000;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-5: #1212120d;\n  --neutral-black-alpha-10: #1212121a;\n  --neutral-black-alpha-20: #12121233;\n  --neutral-black-alpha-30: #1212124d;\n  --neutral-black-alpha-40: #12121266;\n  --neutral-black-alpha-50: #12121280;\n  --neutral-black-alpha-60: #12121299;\n  --neutral-black-alpha-70: #121212b2;\n  --neutral-black-alpha-80: #121212cc;\n  --neutral-black-alpha-90: #121212e5;\n  --neutral-black-alpha-95: #121212f2;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-60: #6e7782;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --neutral-gray-90: #363b40;\n  --neutral-gray-95: #282b2f;\n  --neutral-white-alpha-5: #ffffff0d;\n  --neutral-white-alpha-10: #ffffff1a;\n  --neutral-white-alpha-20: #ffffff33;\n  --neutral-white-alpha-30: #ffffff4d;\n  --neutral-white-alpha-40: #ffffff66;\n  --neutral-white-alpha-50: #ffffff80;\n  --neutral-white-alpha-60: #ffffff99;\n  --neutral-white-alpha-70: #ffffffb2;\n  --neutral-white-alpha-80: #ffffffcc;\n  --neutral-white-alpha-90: #ffffffe5;\n  --neutral-white-alpha-95: #fffffff2;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-10: #fac2c2;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-30: #f37272;\n  --sentiment-error-40: #ef4848;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-60: #d31212;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-error-80: #8d0c0c;\n  --sentiment-error-90: #6c0909;\n  --sentiment-error-95: #620202;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-10: #b8e5ff;\n  --sentiment-information-20: #94d7ff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-40: #38b3ff;\n  --sentiment-information-50: #0099f3;\n  --sentiment-information-60: #0082e5;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-80: #0855b2;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-information-95: #06338d;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-10: #c4f1ca;\n  --sentiment-success-20: #9be3a3;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-40: #4fcf5d;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-60: #2da43a;\n  --sentiment-success-70: #258830;\n  --sentiment-success-80: #1f7028;\n  --sentiment-success-90: #17541e;\n  --sentiment-success-95: #003f25;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-10: #ffecb8;\n  --sentiment-warning-20: #ffe08a;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-40: #fdc835;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-60: #edaf02;\n  --sentiment-warning-70: #cf8e02;\n  --sentiment-warning-80: #b27a01;\n  --sentiment-warning-90: #885d02;\n  --sentiment-warning-95: #654500;\n}\n\n/* CADS Semantic Colors */\n\n/* This file consists of Semantic colors, if you need color tokens that support multiple themes, you need to import and use this file. */\n\n/* Raw values for Semantic colors are defined in Primitive Colors (primitiveColors.css), while semantic color values are specified for every theme. */\n\n/* Generated from CADS color variables — do not hand-edit; check with the design team first and then re-export from the Color foundation page. */\n\n/* Light Theme Semantic Colors (light is the default theme, that's why :root rule is included) */\n[data-brand='codeai-next']:root,\n[data-brand='codeai-next'][data-theme='Light'],\n[data-brand='codeai-next'] [data-theme='Light'] {\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-true-base: var(--neutral-base-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-strong: var(--sentiment-success-90);\n\n  /* Bumped to level 70 (brand-guideline primary is 50) so white labels pass 4.5:1; strong sits at 90. */\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-strong: var(--sentiment-information-90);\n\n  /* Selected state is mode-inverted and cross-family by design: brand fill + seafoam text in light, seafoam fill + navy text in dark. */\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-selected-primary-inverse: var(--sentiment-success-5);\n  --background-disabled-brand: var(--brand-purple-5);\n  --background-disabled-error: var(--sentiment-error-5);\n  --background-disabled-info: var(--sentiment-information-5);\n\n  /* Matches background-neutral-quaternary by value today, but disabled intent is decoupled so the state can be restyled independently. */\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-disabled-orange: var(--brand-orange-5);\n  --background-disabled-pink: var(--brand-pink-5);\n  --background-disabled-success: var(--sentiment-success-5);\n  --background-disabled-warning: var(--sentiment-warning-5);\n\n  /* The Run button orange is an intentional a11y exception. It fails 4.5:1 contrast with white labels but we are keeping it for its deep user association with \"run\" (and Blockly's run blocks). */\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-10);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n\n  /* Stays at level 50 (unlike the bumped background primary at 70) since border contrast only needs 3:1. */\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n\n  /* Border state selected strong and primary intentionally match the background state color. */\n  --border-selected-primary: var(--brand-purple-80);\n  --border-selected-strong: var(--brand-purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --