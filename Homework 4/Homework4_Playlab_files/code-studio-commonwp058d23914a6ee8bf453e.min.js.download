pointer;\n\n  // Use important to overwrite default projects link underline.\n  text-decoration: none !important;\n\n  &:hover {\n    text-decoration: none;\n  }\n\n  &:focus {\n    // Override the default focus style to prevent outline\n    outline: none;\n  }\n\n  &:focus-visible {\n    // Use revert to allow browser default focus styles\n    outline: revert;\n  }\n}\n\ntable.progress-legend {\n  margin-top: 60px;\n  margin-bottom: 20px;\n  &:nth-of-type(2) {\n    margin-top: 0;\n  }\n  &:only-of-type {\n    width: 100%;\n  }\n}\n.progress-legend {\n  text-align: center;\n  color: var(--text-neutral-primary);\n  font-weight: 400;\n  td {\n    padding: 10px;\n  }\n  tr {\n    border: 2px solid var(--borders-neutral-primary);\n    background-color: var(--background-neutral-primary);\n  }\n  thead {\n    tr {\n      background-color: var(--background-neutral-secondary);\n      &:first-of-type {\n        background-color: var(--background-neutral-primary);\n        border: none;\n        td {\n          font-weight: 600;\n          font-size: 18px;\n        }\n      }\n      div:nth-of-type(2) {\n        font-size: 10px;\n      }\n    }\n  }\n  tbody {\n    td:first-of-type {\n      border-inline-end: 2px solid var(--borders-neutral-primary);\n    }\n  }\n  div {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .level-details {\n    padding: 10px 0;\n    white-space: nowrap;\n    div:nth-of-type(2) {\n      padding-top: 16px;\n    }\n    i {\n      margin-inline-end: 5px;\n    }\n  }\n  .end-border {\n    border-inline-end: 2px solid var(--borders-neutral-primary);\n  }\n}\n"],sourceRoot:""}]);const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,"@keyframes react-loading-skeleton {\n    100% {\n        transform: translateX(100%);\n    }\n}\n\n.react-loading-skeleton {\n    --base-color: #ebebeb;\n    --highlight-color: #f5f5f5;\n    --animation-duration: 1.5s;\n    --animation-