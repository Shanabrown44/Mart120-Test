{\n  .navLink {\n    margin: 10px 0;\n    font-size: 14px;\n    line-height: 22px;\n    color: var(--text-brand-purple-primary);\n  }\n\n  .pageTitle {\n    margin: 10px 0;\n    font-size: 32px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 40px;\n    color: var(--text-brand-purple-primary);\n  }\n\n  .unitTitle {\n    margin: 10px 0;\n    font-size: 18px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 40px;\n    color: var(--text-brand-teal-primary);\n  }\n}\n\n.lessonEntry {\n  width: 100%;\n}\n\n.lessonHeader {\n  padding: 0 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  background-color: var(--background-brand-purple-primary);\n  color: var(--text-neutral-white-fixed);\n\n  .lessonTitle {\n    margin: 10px 0;\n    font-size: 18px;\n    font-style: normal;\n    font-weight: 400;\n    color: var(--text-neutral-white-fixed);\n    text-decoration: underline;\n    line-height: 40px;\n  }\n}\n\n.lessonLink {\n  color: var(--text-neutral-white-fixed);\n}\n\n.lessonEntries {\n  display: flex;\n  flex-direction: row;\n  align-items: stretch;\n  align-content: stretch;\n}\n\n.section {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n}\n\n.sectionObject {\n  padding: 0 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  background-color: var(--background-neutral-secondary);\n  color: var(--text-neutral-tertiary);\n\n  .sectionHeading {\n    margin: 10px 0;\n    font-size: 17.5px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 20px;\n    color: inherit;\n  }\n}\n\n.sectionEntries {\n  height: 100%;\n  padding: 10px;\n  border: solid 1px var(--borders-neutral-strong);\n  color: var(--text-neutral-tertiary);\n\n  // Vocab items are bare <li> children (no <ul>); nudge them right so the\n  // bullet sits inside the container rather than spilling past the left edge.\n  > li {\n    margin-left: 15px;\n  }\n\n  .resourceHeading {\n    margin: 10px 0;\n    font-size: 14px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 20px;\n    color: inherit;\n  }\n\n  .emptyMessage {\n    margin: 0 0 10px;\n    color: inherit;\n  }\n}\n'],sourceRoot:""}]),a.locals={rollupPage:"X62qLFGjE6ys2WyAydq1",navLink:"ECmPMlacBglgG2uHyOo7",pageTitle:"tvi3hP6J4gNBpiS76wgm",unitTitle:"RdB9WvN6ovDGj_HcV06k",lessonEntry:"batmC7bHCqfKHV8WYXNg",lessonHeader:"jqGIZSjurKo8x48NL6_U",lessonTitle:"LO0pOVAYvt5TDvLBiGNS",lessonLink:"Ii9W_OAEs2x2mNJzLsDE",lessonEntries:"P8R7XqFf_EGOvDYQ8UnG",section:"EE_cYdvZk5fVm4p_ICS2",sectionObject:"wQEltgG9K4iE6Ndt2ewV",sectionHeading:"BH6gTfV5lUk5XDOnSJmf",sectionEntries:"ZIYz_Hbq66X4HqngXBqW",resourceHeading:"WK654OHMMpbFLuah_tpi",emptyMessage:"fZp6wNNMcD338NIEEVPk"};const s=a},,,,,,,(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".VmG7ABSjnGtVdoiUYJcA{display:flex;align-items:stretch;min-height:calc(100vh - 50px);background-color:var(--background-neutral-primary);font-family:var(--font-family-main);color:var(--text-neutral-primary)}.v0HJdmTJagGyuEtDmxIB{flex:1;min-width:0;padding:20px 40px 40px}.t5FhXO3KnEA7juYGMmWY{margin-bottom:24px}.Nj4hbUqDoNXSoc_DHqDG{margin:0;font-size:14px;font-weight:600;line-height:22px;letter-spacing:.84px;text-transform:uppercase;color:var(--text-brand-primary-fixed)}.Jw5VpmmQUyw1X2j6FeL4{margin:4px 0 0;font-family:var(--font-family-heading);font-size:2.75rem;font-weight:700;line-height:52px;color:var(--text-neutral-primary)}.L8EfAMSihOFSMgreukc2{margin-bottom:40px}.vbjcVLIOzHEevEJLmE5g{display:flex;align-items:baseline;gap:16px;padding-bottom:12px;margin-bottom:12px;border-bottom:1px solid var(--border-neutral-primary)}.vAyu5EIgvlTDYoBQmtlJ{margin:0;font-size:14px;font-weight:600;line-height:22px;letter-spacing:.84px;text-transform:uppercase;color:var(--text-neutral-primary)}.wD72BaP9WJxhkzroP3VL{font-size:14px;line-height:22px;color:var(--text-neutral-quaternary)}.ZATnN58sA9yW4GOrmjTx{display:grid;grid-template-columns:repeat(auto-fill, 200px);gap