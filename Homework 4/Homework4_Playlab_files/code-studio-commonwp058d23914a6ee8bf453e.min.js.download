,CACA,YAAA,CACA,eAAA,CACA,iBAAA,CACA,+CAAA,CACA,kDAAA,CACA,iBAAA,CACA,aAAA,CAGF,sBACE,iBAAA,CACA,QAAA,CACA,OAAA,CACA,UAAA,CACA,WAAA,CACA,+BAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,sBAAA,CACA,QAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,QAAA,CACA,cAAA,CACA,aAAA,CAGF,sBACE,oBAAA,CACA,iCAAA,CACA,oBAAA,CAEA,mHAIE,iCAAA,CACA,oBAAA,CAIJ,sBACE,UAAA,CACA,YAAA,CAGF,sBACE,SAAA,CACA,kBAAA,CACA,qBAAA,CAGF,sBACE,SAAA,CACA,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,sBAAA,CACA,OAAA,CAGF,sBACE,gBAAA",sourcesContent:[".modal {\n  min-width: unset;\n  width: 520px;\n  max-width: 520px;\n  max-height: calc(95vh - 80px);\n\n  > div:nth-of-type(2) {\n    flex: 1 1 auto;\n    min-height: 0;\n    max-height: none;\n    overflow: auto;\n    align-self: stretch;\n  }\n}\n\n.content {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 16px;\n  width: 100%;\n}\n\n.shareWarning {\n  font-weight: bold;\n}\n\n.thumbnailRow {\n  display: flex;\n  align-items: flex-start;\n  gap: 20px;\n}\n\n.thumbnail {\n  width: 127px;\n  height: 127px;\n  overflow: hidden;\n  border-radius: 2px;\n  border: 1px solid var(--borders-neutral-primary);\n  background-color: var(--background-neutral-primary);\n  position: relative;\n  flex-shrink: 0;\n}\n\n.thumbnailImg {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 100%;\n  height: auto;\n  transform: translate(-50%, -50%);\n}\n\n.actionsColumn {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 12px;\n}\n\n.socialLinks {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  font-size: 24px;\n  line-height: 1;\n}\n\n.socialLink {\n  display: inline-block;\n  color: var(--text-neutral-primary);\n  text-decoration: none;\n\n  &:hover,\n  &:focus,\n  &:active,\n  &:visited {\n    color: var(--text-neutral-primary);\n    text-decoration: none;\n  }\n}\n\n.sendToPhoneContainer {\n  width: 100%;\n  display: flex;\n}\n\n.sendToPhoneLeft {\n  width: 70%;\n  padding-right: 20px;\n  box-sizing: border-box;\n}\n\n.sendToPhoneRight {\n  width: 30%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n\n.thumbnailWarning {\n  font-weight: bold;\n}\n"],sourceRoot:""}]),a.locals={modal:"zeAK6kpMQfcXDtKC_Ye0",content:"lXXb0IHOgqIZ9MTvftQn",shareWarning:"cAbQEvRA1lyENLo9yAfZ",thumbnailRow:"XPEtvMp86o15TxDIVlJG",thumbnail:"dVpgJUJAck9HwxtCqOhv",thumbnailImg:"OGog7PPqzk4Nn4qJSDMc",actionsColumn:"TGRpuZfqfH2ix9TkottW",socialLinks:"QYAWNGTmszEPvd0lJ9_s",socialLink:"vUsP6hHBJ8nqeJV7ranQ",sendToPhoneContainer:"H_ZzbgM2tODqdVhOAlIh",sendToPhoneLeft:"bo0LCNvYwk67hY4vGFvl",sendToPhoneRight:"ouzs4Se_Z8KK9hlHF485",thumbnailWarning:"zJ1sJMtDSRpD_zYkurNg"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".iaPQiFWcyRfWQ5YJ8x75{max-height:calc(95vh - 100px);display:flex;flex-direction:column;background-color:#394450;color:#fff;padding:2em 3em}.iaPQiFWcyRfWQ5YJ8x75 hr{margin:1rem 0;border-color:#d1d4d8}.iaPQiFWcyRfWQ5YJ8x75 textarea{width:100%;box-sizing:border-box;resize:none;margin-bottom:20px;flex:1;background-color:#fff}.iaPQiFWcyRfWQ5YJ8x75 .cEPUHLVLJqePB9S9tbUZ,.iaPQiFWcyRfWQ5YJ8x75 .oC8xrMfIbAd17wcJCMzS,.iaPQiFWcyRfWQ5YJ8x75 .INIu64N091l7HJmSjxnE{color:#fff}.iaPQiFWcyRfWQ5YJ8x75 .INIu64N091l7HJmSjxnE:hover{color:#6c468a}.iaPQiFWcyRfWQ5YJ8x75 .QtAi8Wq4pLvAnS4nnLdd{display:flex;height:2rem}.iaPQiFWcyRfWQ5YJ8x75 .XBRhHiJv0_3mCnl_rjKS{display:flex;overflow-y:auto;flex-direction:column;margin-bottom:-10px}.iaPQiFWcyRfWQ5YJ8x75 .UWtxPTXPwoynJPqra33P{display:flex;justify-content:space-between}.iaPQiFWcyRfWQ5YJ8x75 .PSey0BDffRUpX1ZAgITk{display:flex;justify-content:flex-end;gap:1em}.iaPQiFWcyRfWQ5YJ8x75 .oi7QHUFIcH0E7mWU5CGp{display:flex;justify-content:start}.iaPQiFWcyRfWQ5YJ8x75 .xRhPzc7kdOWr0ZCn8IwW{margin-top:.5em;margin-bottom:1.5em}","",{version:3,sources:["webpack://./src/templates/projects/submitProjectDialog/submit-project-dialog.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAGA,sBACE,6BAAA,CACA,YAAA,CACA,qBAAA,CACA,wBC2Me,CD1Mf,UAAA,CACA,eAAA,CAEA,yBACE,aAAA,CACA,oBC6La,CD1Lf,+BACE,UAAA,CACA,qBAAA,CACA,WAAA,CACA,kBAAA,CACA,MAAA,CACA,qBC0NU,CDvNZ,oIACE,UCsNU,CDnNZ,kDACI,aCyHiB,CDtHrB,4CACE,YAAA,CACA,WAAA,CAGF,4CACE,YAAA,CACA,eAAA,CACA,qBAAA,CACA,mBAAA,CAGF,4CACE,YAAA,CACA,6BAAA,CAGF,4CACE,YAAA,CACA,wBAAA,CACA,OAAA,CAGF,4CACE,YAAA,CACA,qBAAA,CAGF,4CACE,eAAA,CACA,mBAAA",sourcesContent:["@import 'color';\n@import '@code-dot-org/component-library-styles/font';\n\n.submitProjectDialog {\n  max-height: calc(95vh - 100px);\n  display: flex;\n  flex-direction: column;\n  background-color: $light_gray_950;;\n  color: white;\n  padding: 2em 3em;\n\n  hr {\n    margin: 1rem 0;\n    border-color: $light_gray_200;\n  }\n\n  textarea {\n    width: 100%;\n    box-sizing: border-box;\n    resize: none;\n    margin-bottom: 20px;\n    flex: 1;\n    background-color: $light_white;\n  }\n\n  .bodyTwoText, .heading3, .link {\n    color: $light_white;\n  }\n\n  .link:hover {\n      color: $brand_secondary_dark;\n  }\n\n  .headerContainer {\n    display: flex;\n    height: 2rem;\n  }\n  \n  .submitProjectTextContainer {\n    display: flex;\n    overflow-y: auto;\n    flex-direction: column;\n    margin-bottom: -10px;\n  }\n  \n  .bottomSection {\n    display: flex;\n    justify-content: space-between;\n  }\n  \n  .bottomSectionButtons {\n    display: flex;\n    justify-content: flex-end;\n    gap: 1em;\n  }\n  \n  .bottomSectionLink {\n    display: flex;\n    justify-content: start;\n  }\n\n  .alertContainer {\n    margin-top: 0.5em;\n    margin-bottom: 1.5em;\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),a.locals={submitProjectDialog:"iaPQiFWcyRfWQ5YJ8x75",bodyTwoText:"cEPUHLVLJqePB9S9tbUZ",heading3:"oC8xrMfIbAd17wcJCMzS",link:"INIu64N091l7HJmSjxnE",headerContainer:"QtAi8Wq4pLvAnS4nnLdd",submitProjectTextContainer:"XBRhHiJv0_3mCnl_rjKS",bottomSection:"UWtxPTXPwoynJPqra33P",bottomSectionButtons:"PSey0BDffRUpX1ZAgITk",bottomSectionLink:"oi7QHUFIcH0E7mWU5CGp",alertContainer:"xRhPzc7kdOWr0ZCn8IwW"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".LqeU2PfWBjBhrtdhXjsY{background-color:rgba(0,0,0,.5);color:#292f36;position:absolute;width:100%;height:100%;display:flex;align-items:center;justify-content:center;top:0;left:0;z-index:80}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32{background-color:var(--background-neutral-secondary);color:var(--text-neutral-primary);border-radius:5px;padding:20px 32px;width:600px}.LqeU2PfWBjBhrtdhXjsY{box-sizing:border-box;padding:16px}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32{box-sizing:border-box;display:flex;flex-direction:column;position:relative;gap:20px;justify-content:space-between;font-size:14px;max-height:100%;min-height:0;overflow:hidden}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32 .cCl1k_FshEdjydPsJjID{display:flex;flex-direction:column;gap:20px;flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32 .ALIvMzqDD3YOeMahFn84{color:var(--text-neutral-primary);margin-bottom:0}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32 .BkgXgRvOkddP9WSUJBPP{display:flex;flex-direction:row;gap:40px;justify-content:space-between}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32 .BkgXgRvOkddP9WSUJBPP .MiVpnR0bYUppTm56Vfia{width:320px;display:flex;flex-direction:column;justify-content:space-between;margin:0 auto}.LqeU2PfWBjBhrtdhXjsY .TVwelWoDbubcA371fd32 .yypsEugvEnLMpD6C3cld{background-