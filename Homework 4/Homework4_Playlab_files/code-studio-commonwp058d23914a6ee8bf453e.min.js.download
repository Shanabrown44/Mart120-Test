ch;\n  gap: 15px;\n}\n\n.studentInfoGroup {\n  display: flex;\n  align-self: center;\n  justify-content: space-around;\n  flex-direction: column;\n  text-align: center;\n  gap: 0.75rem;\n\n  h3 {\n    margin: 0;\n  }\n}\n\n.learningGoalsWrapper {\n  width: 100%;\n}\n\n.studentSelector {\n  width: 300px;\n}\n\n.learningGoalsContainer {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: space-between;\n  align-self: stretch;\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-primary);\n  background: var(--background-neutral-secondary);\n  width: auto;\n}\n\n.learningGoalRing {\n  flex: 0 0 auto;\n}\n\nbutton.learningGoalButton {\n  align-self: center;\n  background: none;\n  border: none;\n  box-shadow: none;\n  flex: 0 0 auto;\n  margin: 0;\n  padding: 0.5rem;\n\n  &:active,\n  &:hover {\n    box-shadow: none;\n    // The important is needed here to override the common button:active style\n    border: none !important;\n  }\n}\n\nbutton.learningGoalButtonLeft {\n  margin-left: 0.5rem;\n  margin-right: 0.625rem;\n}\n\nbutton.learningGoalButtonRight {\n  margin-left: 0.625rem;\n  margin-right: 0.5rem;\n}\n\n.learningGoalsHeader {\n  display: flex;\n  flex-direction: row;\n  min-height: 60px;\n  justify-content: space-between;\n  align-self: stretch;\n  line-height: 154%;\n  position: relative;\n  margin: 1rem 0 0 0;\n  padding: 0 0 0.75rem 0;\n  border-bottom: 1px var(--borders-neutral-light) solid;\n  overflow: hidden;\n}\n\n.learningGoalsHeaderLeftSide {\n  @include main-font-semi-bold;\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  font-size: 14px;\n  flex: 1;\n  overflow: hidden;\n}\n\n.learningGoalsHeaderRightSideV2 {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  align-self: stretch;\n  gap: 16px;\n  font-weight: 325;\n  flex: 0 0 auto;\n}\n\n.learningGoalsHeaderText {\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-start;\n  padding: 0 0.5rem;\n  flex: 0 1 100%;\n  overflow: hidden;\n}\n\np.learningGoalsHeaderTextBody,\nh5.learningGoalsHeaderTextBody {\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  overflow: hidden;\n  flex: 1;\n  margin: 0;\n}\n\nh5.learningGoalsHeaderTextBody {\n  margin: 0 0 0.25rem;\n  display: flex;\n  flex-direction: row;\n\n  span {\n    align-self: stretch;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    overflow: hidden;\n  }\n}\n\n.learningGoalSummary {\n  display: flex;\n  flex-direction: row;\n  padding-left: 20px;\n  padding-right: 20px;\n  justify-content: space-between;\n  border-bottom: 1px var(--borders-neutral-light) solid;\n  margin: 1rem 1rem 0 1rem;\n}\n\n.aiTokenContainer {\n  align-self: start;\n  margin-left: 0.5rem;\n}\n\n.aiToken {\n  display: flex;\n  height: 24px;\n  padding: 2px 12px 2px 12px;\n  justify-content: center;\n  align-items: center;\n  gap: 4px;\n  white-space: nowrap;\n  border-radius: 30px;\n  background: var(--background-brand-aqua-primary);\n}\n\np.aiTokenText {\n  color: var(--text-neutral-white-fixed);\n  font-size: 0.7rem;\n  line-height: 1rem;\n  margin-bottom: 0;\n}\n\n.progressRing {\n  transition: stroke-dashoffset 0.35s;\n  transform: rotate(-90deg);\n  transform-origin: 50% 50%;\n}\n\n.progressRingTrack {\n  stroke: var(--borders-neutral-primary);\n}\n\n.progressRingCurrent {\n  stroke: var(--borders-neutral-strong);\n}\n\n.progressRingAssessed {\n  stroke: var(--borders-brand-teal-primary);\n}\n\n.progressRingText {\n  text-anchor: middle;\n  font-size: smaller;\n  fill: var(--text-neutral-primary);\n}\n\n.learningGoalsTips {\n  padding: 0.5rem;\n  border-radius: 0.25rem;\n  border: 1px solid var(--borders-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\np.evidenceLevelHeaderText {\n  margin: 0 0 0.25rem;\n}\n\n.evidenceLevelSetHorizontalV2 {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  width: 100%;\n  gap: 8px;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.evidenceLevelDescriptionV2 {\n  // Always occupy its own full-width line and reserve a constant height so the\n  // container doesn't resize as descriptions of different lengths are shown.\n  // 1.64 is the body-four line-height; reserve room for 3 lines.\n  flex-basis: 100%;\n  min-height: calc(3 * 1.64em);\n}\n\n.evidenceLevelOptionV2 {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\n.evidenceLevelLabelV2 {\n  @include main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 154%;\n  margin-bottom: 0;\n}\n\n.evidenceLevel {\n  border-radius: 100px;\n  border-width: 1px;\n  border-style: solid;\n  margin: 0;\n  padding: 0 16px 0;\n  font-size: 0.875rem;\n  height: 32px;\n  text-align: center;\n}\n\n.evidenceLevelUnselected {\n  border-color: var(--borders-neutral-solid);\n  background: var(--background-neutral-primary);\n\n  &:hover {\n    box-shadow: none;\n    background-color: var(--background-neutral-tertiary);\n  }\n\n  &:disabled {\n    border-color: var(--borders-neutral-solid);\n    background: var(--background-neutral-primary);\n  }\n}\n\n.evidenceLevelSelected {\n  border-color: var(--borders-brand-teal-primary);\n  background: var(--background-brand-teal-primary);\n  color: var(--text-neutral-white-fixed);\n\n  &:hover {\n    box-shadow: none;\n    background-color: var(--background-brand-teal-strong);\n  }\n\n  &:disabled {\n    border-color: var(--borders-brand-teal-primary);\n    background: var(--background-brand-teal-primary);\n    color: var(--text-neutral-white-fixed);\n  }\n}\n\n.evidenceLevelSuggested {\n  border-radius: 100px;\n  border: 1px solid var(--borders-neutral-solid);\n  background: var(--background-neutral-primary);\n  gap: 10px;\n  font-size: 0.875rem;\n  height: 32px;\n  box-shadow: 0 0 0 0.125rem var(--background-brand-aqua-primary);\n\n  &:hover {\n    box-shadow: 0 0 0 0.125rem var(--background-brand-aqua-primary);\n    background-color: var(--background-neutral-tertiary);\n  }\n\n  &:disabled {\n    border-radius: 100px;\n    border: 1px solid var(--borders-neutral-solid);\n    background: var(--background-neutral-primary);\n    gap: 10px;\n    padding: 3px 16px 0;\n    font-size: 0.875rem;\n    height: 32px;\n    box-shadow: 0 0 0 0.125rem var(--background-brand-aqua-primary);\n  }\n}\n\n.fabBackground {\n  display: flex;\n  flex-direction: column;\n  gap: 28px;\n  padding: 1rem;\n  border-right: 0.125rem solid var(--borders-neutral-solid);\n  border-left: 0.125rem solid var(--borders-neutral-solid);\n  background: var(--background-neutral-primary);\n  box-shadow: 0.25rem 0.25rem 0.375rem 0 rgba(0 0 0 / 0.25);\n  height: 440px;\n  overflow-x: hidden;\n  overflow-y: scroll;\n\n  &:last-child {\n    height: 442px;\n    border-radius: 0 0 0.25rem 0.25rem;\n    border-bottom: 0.125rem solid var(--borders-neutral-solid);\n  }\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.fabErrorBackground {\n  background: var(--background-error-extra-light) !important;\n  color: var(--text-error-secondary) !important;\n}\n\n.sectionSelector {\n  width: 180px;\n}\n\n.rubricTabGroup {\n  padding-bottom: 8px;\n  justify-content: space-between;\n  align-items: center;\n  align-self: stretch;\n  display: flex;\n}\n\n.rubricTabGroupRight {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n}\n\n.infoAlertLeft {\n  display: flex;\n  gap: 10px;\n}\n\n.infoAlertRight {\n  display: flex;\n  align-items: flex-start;\n  align-self: stretch;\n  margin: 0;\n}\n\nbutton.infoAlertRight {\n  box-shadow: none;\n  border: 1px solid transparent;\n\n  &:active,\n  &:hover {\n    box-shadow: none;\n  }\n}\n\n.settingsGroup {\n  display: flex;\n  flex-direction: column;\n  align-self: stretch;\n}\n\n.settingsContent {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  width: 100%;\n}\n\n.settingsContainers {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: space-between;\n  align-self: stretch;\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-primary);\n  background: var(--background-neutral-secondary);\n  gap: 15px;\n  padding: 20px;\n\n  p {\n    margin-bottom: 0;\n  }\n}\n\n.aiSettingsContainer {\n  align-items: unset;\n}\n\n.runAiAllStatuses {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.detailsGroup {\n  display: inline;\n  gap: 1rem;\n}\n\np.detailsVisible {\n  display: inline;\n  padding-inline-end: 1rem;\n}\n\np.detailsHidden {\n  display: none;\n}\n\n.studentDropdownOptionContainer {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.dropdownOption {\n  /* Reset's every elements apperance */\n  background: none repeat scroll 0 0 transparent;\n  border: none !important;\n  border-radius: 0;\n  border-spacing: 0;\n  list-style: none outside none;\n  margin: 0;\n  text-decoration: none;\n  text-indent: 0;\n  box-shadow: none;\n  flex-grow: 1;\n\n  display: flex;\n  align-items: center;\n  cursor: pointer;\n  color: var(--text-neutral-primary);\n\n  padding: 0.3125rem 1rem;\n  gap: 16px;\n\n  span {\n    @include typography.body-three;\n    color: inherit;\n    margin-bottom: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  &:active {\n    border: 0 !important;\n  }\n\n  &:hover {\n    color: var(--text-neutral-primary);\n    text-decoration: none;\n    box-shadow: none;\n  }\n}\n\n.unselectableDropdownOption {\n  div {\n    cursor: default !important;\n    span {\n      font-style: italic;\n    }\n  }\n\n  &:hover {\n    background-color: inherit !important;\n  }\n\n  &:active {\n    background-color: inherit !important;\n    span {\n      color: inherit !important;\n    }\n  }\n}\n\n.statusBlob {\n  border-radius: 20px;\n  padding: 0 10px;\n  height: 26px;\n  min-height: 26px;\n  min-width: 82px;\n  max-width: 82px;\n  display: flex;\n  align-items: center;\n}\n\n.greenStatusBlob {\n  background-color: var(--background-success-extra-light);\n}\n\n.yellowStatusBlob {\n  background-color: var(--background-warning-light);\n}\n\n.purpleStatusBlob {\n  background-color: var(--background-brand-purple-light);\n}\n\n.redStatusBlob {\n  background-color: var(--background-error-extra-light);\n}\n\n.grayStatusBlob {\n  background-color: var(--background-neutral-tertiary);\n}\n\n.announcementDialog {\n  flex-direction: column;\n  display: flex;\n  align-items: center;\n  text-align: center;\n  max-width: 670px;\n  margin: 12px;\n\n  h2 {\n    margin: 8px 0 20px 0;\n  }\n}\n\n.announcementModal {\n  max-width: 682px !important;\n  max-height: 90% !important;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n@media screen and (max-width: 980px) {\n  .announcementModal {\n    width: 90% !important; /* Set width to 90% of the viewport width */\n  }\n}\n\n.announcementImage {\n  margin-top: 20px;\n  margin-bottom: 20px;\n  max-width: 400px;\n  max-height: 218px;\n  border-radius: 4px;\n}\n\n.announcementBody {\n  max-width: 551px;\n}\n",'@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.03rem;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.03rem;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.4;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.48;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.54;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.64;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.04rem;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: 0.813rem;\n  line-height: 1.64;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: 0.688rem;\n  line-height: 1.76;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/custom-icons.min.css';\n","@use 'variables' as variables;\n@use 'typography.module' as typography;\n@use 'font.scss' as font;\n\n// Typography - Label styles\n@mixin label-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin label-one {\n  @include label-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin label-two {\n  @include label-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin label-three {\n  @include label-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n@mixin label-four {\n  @include label-common;\n  font-size: 0.625rem;\n  line-height: 1.8;\n}\n\n// Typography - Link styles (Link Body styles)\n@mixin link-body-common {\n  @include font.main-font-semi-bold;\n  text-decoration: underline;\n}\n\n@mixin link-body-one {\n  @include link-body-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin link-body-two {\n  @include link-body-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin link-body-three {\n  @include link-body-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin link-body-four {\n  @include link-body-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Typography Button text styles\n@mixin button-text-common {\n  @include font.main-font-semi-bold;\n  margin-bottom: 0.5rem;\n}\n\n@mixin button-one-text {\n  @include button-text-common;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n@mixin button-two-text {\n  @include button-text-common;\n  font-size: 1rem;\n  line-height: 1.48;\n}\n\n@mixin button-three-text {\n  @include button-text-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin button-four-text {\n  @include button-text-common;\n  font-size: 0.75rem;\n  line-height: 1.64;\n}\n\n// Common field styles\n@mixin field-helper-section-common {\n  display: flex;\n  align-items: baseline;\n  align-self: stretch;\n}\n\n@mixin field-helper-section-l {\n  @include typography.body-two;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-m {\n  @include typography.body-three;\n  margin-bottom: 0;\n  gap: 0.375rem;\n}\n\n@mixin field-helper-section-s {\n  @include typography.body-four;\n  margin-bottom: 0;\n  gap: 0.25rem;\n}\n\n@mixin field-helper-section-black {\n  color: var(--text-neutral-primary);\n}\n\n@mixin field-helper-section-black-disabled {\n  color: var(--text-neutral-disabled);\n}\n\n@mixin field-helper-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-helper-section-white-disabled {\n  color: var(--neutral-gray-70);\n}\n\n@mixin field-error-section-black {\n  color: var(--text-error-primary);\n}\n\n@mixin field-error-section-white {\n  color: var(--text-neutral-inverse);\n}\n\n@mixin field-read-only-black-colors {\n  color: var(--text-neutral-primary);\n  border-color: var(--borders-neutral-disabled);\n  background-color: var(--background-neutral-secondary);\n}\n\n@mixin field-read-only-white-colors {\n  color: var(--text-neutral-inverse);\n  border-color: var(--neutral-gray-70);\n  background-color: var(--neutral-white-alpha-10);\n}\n\n// Focus styles\n@mixin focus-styles {\n  outline: var(--borders-brand-teal-primary) solid 2px;\n  outline-offset: 0.125rem;\n}\n\n// Transition styles\n@mixin transition-all {\n  transition: all 0.2s ease;\n}\n\n// Icon styles\n@mixin icon-dimensions($font-size, $line-height: 1.25) {\n  font-size: $font-size;\n  line-height: $line-height;\n  width: calc(#{$font-size} * #{$line-height});\n}\n\n// Border styles\n@mixin border-styles(\n  $border-color: var(--borders-neutral-primary),\n  $border-width: 1px,\n  $border-style: solid,\n  $border-radius: variables.$regular-border-radius\n) {\n  border: $border-width $border-style $border-color;\n  border-radius: $border-radius;\n}\n"],sourceRoot:""}]),a.locals={"heading-xxl":"vdKIv5IKVXV_GbS0H4pP",wrapper:"yofqumXhTsKcaIlIGNHF","heading-xl":"dNnED2yVkk2gFo1X7Bly","heading-lg":"KIVohC1vvyNdN9C83JWH","heading-md":"opnh8Z0_OcGyFlZpBUCA","heading-sm":"CvEhIBhojAeb_Z4eXj2v","heading-xs":"yc50VHTiOocKhFEQS51w","body-one":"G7JSO17n4_DPfkG_HmnO","body-two":"ZYPpppD1fXro3WjewVVT","body-three":"OhWSfX_pAWgQB9Wb5iLn","body-four":"LHX8r4u977WDDApUhFA2","overline-one":"nZq4mEyKRka_pUH1OX13","overline-two":"b7mYM27s7i_tk_EflAw9","overline-three":"IFN_PoXcItjHHkjN9pBA",strong:"diTit74wYKhWqcUa1dTX",em:"yi0trYM99k6iagrL779w",figcaption:"vvHq1S82hcKbcBreuRy6","no-margin":"F_UhbOPnRPyAH9l9ecRO",floatingActionButton:"SG0OeN1BJboN_wKvB1jK",pulse:"QPlALJnn1On05LdueOSH",taOverlay:"GrYL8e_XNezJdKN9bPly",countOverlay:"yhBGpw4hj1QCh1B_6ZLQ",countText:"sWiSwujKzNzpfhxQ2se8",dismissableAlert:"SlssyMsIVfBQbqOTCUN9",dismissableAlertText:"Xqn6gDf_uGgD_5pqHJhp",alertCloseButton:"ZfIrDqRDg1yeRu8Zyeiw",viewScoresButton:"hU0RnZyjDey8M5Cwc5fa",viewScoresText:"r4fiya2dXTsxS7GRxnco",rubricContainer:"imKW1u60kBnQFcsi9CoA",settings:"mdgadomfjsLFtiYZRzbA",settingsVisible:"STdms8UB4WuohkQbWnK2",settingsHidden:"BbEd9loh1l44eIcWkoWR",aiAssessmentOptions:"DfsWkXKl