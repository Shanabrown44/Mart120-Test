herd-onboarding-container .shepherd-text{flex:1;min-width:0;order:1;color:var(--neutral-base-white);padding:0;margin-bottom:0}.custom-shepherd-onboarding-container .shepherd-header{order:2;flex-shrink:0;padding:0 !important}.custom-shepherd-onboarding-container.shepherd-has-title .shepherd-content .shepherd-header{background-color:rgba(0,0,0,0);padding:0;margin-bottom:0}.custom-shepherd-onboarding-container .shepherd-cancel-icon{position:static;color:var(--neutral-base-white)}.custom-shepherd-onboarding-container .shepherd-cancel-icon:hover{color:#c8c8c8}.custom-shepherd-onboarding-container .shepherd-footer{flex-basis:100%;order:3;padding:0;gap:8px;justify-content:flex-end}.custom-shepherd-onboarding-container.shepherd-element>.shepherd-arrow:before{background-color:var(--neutral-base-black)}.onboarding-syllabus-review-level-step{width:276px}.onboarding-progress-table-step{width:240px}.onboarding-step-text-stack{display:flex;flex-direction:column}.onboarding-step-supportive-text{color:var(--neutral-white-alpha-60);font-size:12px;margin-top:8px}',"",{version:3,sources:["webpack://./src/sharedComponents/productTour/shepherd.scss","webpack://./../frontend/packages/component-library-styles/variables.scss"],names:[],mappings:"AAMA,kBACE,YAAA,CAGF,kCACE,YAAA,CAMF,wCACE,YCFe,CDKjB,qBACE,4BAAA,CACA,YAAA,CAEA,mCACE,mDAAA,CACA,kBAAA,CAGF,6BACE,UAAA,CACA,iBAAA,CACA,UAAA,CACA,WAAA,CACA,qBAAA,CACA,uFAAA,CASA,yBAAA,CACA,2DAAA,CACA,mBAAA,CAGA,oEAAA,CACA,sBAAA,CACA,4EAAA,CAEA,sCAAA,CAIJ,uFAGE,6BACE,YAAA,CAAA,CAIJ,uCACE,6BACE,cAAA,CAAA,CAIJ,yCACE,GACE,0BAAA,CAGF,IACE,4BAAA,CAGF,KACE,0BAAA,CAAA,CAKJ,sEACE,mCAAA,CACA,iCAAA,CACA,kDAAA,CACA,yCAAA,CACA,iBAAA,CAEA,kLACE,kDAAA,CACA,SAAA,CACA,iBAAA,CAGF,4LACE,kCAAA,CACA,iBAAA,CACA,QAAA,CACA,UAAA,CAEA,wMACE,iCAAA,CAGF,wNACE,mDAAA,CACA,kBAAA,CAIJ,0GACE,YAAA,CAGF,oGACE,SAAA,CACA,kBAAA,CACA,kCAAA,CAGF,wGACE,SAAA,CACA,OAAA,CAGF,4EACE,iBAAA,CACA,eAAA,CACA,gBAAA,CAGF,wGACE,QAAA,CACA,gBAAA,CACA,eAAA,CACA,cAAA,CACA,eAAA,CAGF,oIACE,mDAAA,CACA,kBAAA,CAIF,sIACE,iDAAA,CACA,qCAAA,CAEA,gLACE,gDAAA,CAGF,sUAEE,6CAAA,CACA,0CAAA,CAKJ,0IACE,6CAAA,CACA,kDAAA,CACA,iCAAA,CAEA,oLACE,mDAAA,CACA,6CAAA,CACA,iCAAA,CAGF,8UAGE,4CAAA,CACA,kCAAA,CACA,kDAAA,CAKJ,0PAEE,kDAAA,CASJ,+BACE,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,iBAAA,CACA,OAAA,CAEA,4DACE,cAAA,CACA,aAAA,CAIJ,0FAEE,qBAAA,CACA,mBAAA,CAGF,yBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,QAAA,CAGF,yBACE,aAAA,CACA,cAAA,CACA,iFAAA,CAQA,oBAAA,CACA,4BAAA,CACA,qCAAA,CAGF,sBACE,MAAA,CAIF,mBACE,YAAA,CACA,qBAAA,CACA,OAAA,CACA,eAAA,CAGF,aACE,iBAAA,CACA,8CAAA,CACA,iBAAA,CACA,wBAAA,CACA,+BAAA,CACA,mCAAA,CACA,cAAA,CACA,eAAA,CACA,cAAA,CACA,eAAA,CACA,4BAAA,CAEA,kCACE,0CAAA,CAGF,sBACE,cAAA,CAIJ,uBACE,oBAAA,CACA,oCAAA,CACA,iCAAA,CAGF,yBACE,oBAAA,CACA,qCAAA,CACA,aAAA,CAGF,eACE,eAAA,CACA,mCAAA,CACA,cAAA,CACA,eAAA,CACA,4BAAA,CAIF,sCAGE,0CAAA,CACA,+BAAA,CAIA,wDACE,YAAA,CACA,kBAAA,CACA,cAAA,CACA,sBAAA,CACA,2BAAA,CACA,OAAA,CAIF,qDACE,MAAA,CACA,WAAA,CACA,OAAA,CACA,+BAAA,CACA,SAAA,CACA,eAAA,CAIF,uDACE,OAAA,CACA,aAAA,CACA,oBAAA,CAGF,4FACE,8BAAA,CACA,SAAA,CACA,eAAA,CAIF,4DACE,eAAA,CACA,+BAAA,CAEA,kEACE,aAAA,CAKJ,uDACE,eAAA,CACA,OAAA,CACA,SAAA,CACA,OAAA,CACA,wBAAA,CAGF,8EACE,0CAAA,CAIJ,uCACE,WAAA,CAGF,gCACE,WAAA,CAGF,4BACE,YAAA,CACA,qBAAA,CAGF,iCACE,mCAAA,CACA,cAAA,CACA,cAAA",sourcesContent:["@import 'shepherd.js/dist/css/shepherd.css';\n@import 'color.scss';\n@import '@code-dot-org/component-library-styles/variables.scss';\n\n// Keep Shepherd below our modal stack ($zindex-modal-backdrop, $zindex-modal)\n// so dialogs that open during a tour appear on top.\n.shepherd-element {\n  z-index: $zindex-modal-backdrop - 2;\n}\n\n.shepherd-modal-overlay-container {\n  z-index: $zindex-modal-backdrop - 5;\n}\n\n// Opt-in for steps that attach to an element inside an open modal.\n// Add 'tour-step-above-modal' to the step's `classes` to restore\n// the step above the modal stack.\n.shepherd-element.tour-step-above-modal {\n  z-index: $zindex-popover;\n}\n\n.tour-step-highlight {\n  position: relative !important;\n  outline: none;\n\n  &:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: 2px;\n  }\n\n  &::before {\n    content: '';\n    position: absolute;\n    inset: -3px;\n    padding: 3px;\n    border-radius: inherit;\n    background: linear-gradient(\n      90deg,\n      #15c5f9,\n      #2b72ff,\n      #8f20ec,\n      #c710c2,\n      #e50976,\n      #15c5f9\n    );\n    background-size: 300% 300%;\n    animation: tour-highlight-gradient-shift 12s linear infinite;\n    pointer-events: none;\n    // Mask punches a hole in the interior so only the 3px border ring is painted,\n    // regardless of whether the highlighted element has a background.\n    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n    mask-composite: exclude;\n    -webkit-mask: linear-gradient(#000 0 0) content-box,\n      linear-gradient(#000 0 0);\n    -webkit-mask-composite: destination-out;\n  }\n}\n\n@supports not (\n  (mask-composite: exclude) or (-webkit-mask-composite: destination-out)\n) {\n  .tour-step-highlight::before {\n    content: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tour-step-highlight::before {\n    animation: none;\n  }\n}\n\n@keyframes tour-highlight-gradient-shift {\n  0% {\n    background-position: 0% 50%;\n  }\n\n  50% {\n    background-position: 100% 50%;\n  }\n\n  100% {\n    background-position: 0% 50%;\n  }\n}\n\n// Shared styles for all shepherd step containers.\n%shepherd-step-container-base {\n  font-family: var(--font-family-main);\n  color: var(--text-neutral-primary);\n  background-color: var(--background-neutral-primary);\n  box-shadow: 0 12px 40px rgb(28 45 94 / 16%);\n  border-radius: 8px;\n\n  &.shepherd-has-title .shepherd-content .shepherd-header {\n    background-color: var(--background-neutral-primary);\n    padding: 0;\n    margin-bottom: 8px;\n  }\n\n  &.shepherd-has-title .shepherd-content .shepherd-cancel-icon {\n    color: var(--text-neutral-tertiary);\n    position: absolute;\n    top: 12px;\n    right: 12px;\n\n    &:hover {\n      color: var(--text-neutral-primary);\n    }\n\n    &:focus-visible {\n      outline: 2px solid var(--borders-brand-teal-primary);\n      outline-offset: 2px;\n    }\n  }\n\n  .shepherd-content {\n    padding: 24px;\n  }\n\n  .shepherd-text {\n    padding: 0;\n    margin-bottom: 16px;\n    color: var(--text-neutral-tertiary);\n  }\n\n  .shepherd-footer {\n    padding: 0;\n    gap: 8px;\n  }\n\n  h3 {\n    font-size: 1.25rem;\n    font-weight: 500;\n    line-height: 28px;\n  }\n\n  .shepherd-button {\n    margin: 0;\n    padding: 8px 16px;\n    transition: none;\n    font-size: 16px;\n    font-weight: 600;\n  }\n\n  .shepherd-button:focus-visible {\n    outline: 2px solid var(--borders-brand-teal-primary);\n    outline-offset: 2px;\n  }\n\n  // Aligned with purple primary button styles.\n  .custom-shepherd-button-primary {\n    background: var(--background-brand-purple-primary);\n    color: var(--text-neutral-white-fixed);\n\n    &:not(:disabled):hover {\n      background: var(--background-brand-purple-strong);\n    }\n\n    &:disabled,\n    &[aria-disabled='true'] {\n      background: var(--background-neutral-disabled);\n      color: var(--text-neutral-disabled-inverse);\n    }\n  }\n\n  // Aligned with secondary black button styles.\n  .custom-shepherd-button-secondary {\n    border: 1px solid var(--borders-neutral-solid);\n    background-color: var(--background-neutral-primary);\n    color: var(--text-neutral-primary);\n\n    &:not(:disabled):hover {\n      background-color: var(--background-neutral-tertiary);\n      border: 1px solid var(--borders-neutral-solid);\n      color: var(--text-neutral-primary);\n    }\n\n    &:disabled,\n    &[aria-disabled='true'],\n    &[aria-disabled='true']:hover {\n      border-color: var(--borders-neutral-disabled);\n      color: var(--text-neutral-disabled);\n      background-color: var(--background-neutral-primary);\n    }\n  }\n\n  // The default style for the bottom arrow is a gray color, we want white.\n  &.shepherd-element.shepherd-has-title[data-popper-placement^='bottom']\n    > .shepherd-arrow:before {\n    background-color: var(--background-neutral-primary);\n  }\n}\n\n// Style the shepherd step container to approximately match the dsco popover.\n.custom-shepherd-step-container {\n  @extend %shepherd-step-container-base;\n}\n\n.onboarding-completion-content {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  gap: 8px;\n\n  .onboarding-completion-emoji {\n    font-size: 48px;\n    line-height: 1;\n  }\n}\n\n.onboarding-completion-step .shepherd-footer,\n.onboarding-stacked-buttons .shepherd-footer {\n  flex-direction: column;\n  align-items: stretch;\n}\n\n.onboarding-step-content {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.onboarding-sparkle-icon {\n  flex-shrink: 0;\n  margin-top: 2px;\n  background: linear-gradient(\n    to right,\n    #15c5f9,\n    #2b72ff,\n    #8f20ec,\n    #c710c2,\n    #e50976\n  );\n  background-clip: text;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.onboarding-step-text {\n  flex: 1;\n}\n\n// Quiz step: column of answer option buttons.\n.quiz-options-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.quiz-option {\n  padding: 10px 16px;\n  border: 1px solid var(--neutral-white-alpha-30);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--neutral-base-white);\n  font-family: var(--font-family-main);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  text-align: left;\n  transition: border-color 0.15s;\n\n  &:not(:disabled):hover {\n    border-color: var(--neutral-white-alpha-70);\n  }\n\n  &:disabled {\n    cursor: default;\n  }\n}\n\ndiv .quiz-option-wrong {\n  border-color: #e53e3e;\n  background-color: rgb(229 62 62 / 15%);\n  color: var(--accent-strawberry-40);\n}\n\ndiv .quiz-option-correct {\n  border-color: #38a169;\n  background-color: rgb(56 161 105 / 15%);\n  color: #68d391;\n}\n\n.quiz-feedback {\n  margin-top: 12px;\n  font-family: var(--font-family-main);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--neutral-gray-50);\n}\n\n// Onboarding tour step container styles.\n.custom-shepherd-onboarding-container {\n  @extend %shepherd-step-container-base;\n\n  background-color: var(--neutral-base-black);\n  color: var(--neutral-base-white);\n\n  // Lay out the content as a flex row so the sparkle+text and the X button\n  // all sit on the same line, with the footer wrapping beneath.\n  .shepherd-content {\n    display: flex;\n    flex-direction: row;\n    flex-wrap: wrap;\n    align-items: flex-start;\n    padding: 12px 14px 14px 14px;\n    gap: 8px;\n  }\n\n  // Text takes all available width and renders first.\n  .shepherd-text {\n    flex: 1;\n    min-width: 0;\n    order: 1;\n    color: var(--neutral-base-white);\n    padding: 0;\n    margin-bottom: 0;\n  }\n\n  // Header only contains the cancel icon here; push it to the right.\n  .shepherd-header {\n    order: 2;\n    flex-shrink: 0;\n    padding: 0 !important;\n  }\n\n  &.shepherd-has-title .shepherd-content .shepherd-header {\n    background-color: transparent;\n    padding: 0;\n    margin-bottom: 0;\n  }\n\n  // Take the cancel icon out of absolute positioning so it sits inline.\n  .shepherd-cancel-icon {\n    position: static;\n    color: var(--neutral-base-white);\n\n    &:hover {\n      color: rgb(200 200 200);\n    }\n  }\n\n  // Footer wraps to a second row and aligns buttons to the right.\n  .shepherd-footer {\n    flex-basis: 100%;\n    order: 3;\n    padding: 0;\n    gap: 8px;\n    justify-content: flex-end;\n  }\n\n  &.shepherd-element > .shepherd-arrow:before {\n    background-color: var(--neutral-base-black);\n  }\n}\n\n.onboarding-syllabus-review-level-step {\n  width: 276px;\n}\n\n.onboarding-progress-table-step {\n  width: 240px;\n}\n\n.onboarding-step-text-stack {\n  display: flex;\n  flex-direction: column;\n}\n\n.onboarding-step-supportive-text {\n  color: var(--neutral-white-alpha-60);\n  font-size: 12px;\n  margin-top: 8px;\n}\n","// Design System wide common variables\n\n$form-field-width: 18.75rem;\n\n// Border radius\n$regular-border-radius: 0.25rem;\n\n// z-index values\n// These values match Bootstrap's z-index values\n// See: https://getbootstrap.com/docs/5.0/layout/z-index/\n$zindex-dropdown: 1000;\n$zindex-sticky: 1020;\n$zindex-fixed: 1030;\n$zindex-modal-backdrop: 1040;\n$zindex-offcanvas: 1050;\n$zindex-modal: 1060;\n$zindex-popover: 1070;\n$zindex-tooltip: 1080;\n"],sourceRoot:""}]);const c=l},,,,,,,,,,,,,,,,(e,t)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.isChordEvent=function(e){return"chord"===e.type}},(e,t)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.isInstrumentEvent=function(e){return"instrument"===e.type}},(e,t)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.isSoundEvent=function(e){return"sound"===e.type}},,,,,,,,,,,(e,t,n)=>{"use strict";n.r(t),n.d(t,{default:()=>A});var r=n(19),o=n.n(r),i=n(20),a=n.n(i),s=n(21),l=n.n(s),c=n(22),u=n.n(c),d=n(23),p=n.n(d),h=n(24),f=n.n(h),m=n(5604),g={};g.styleTagTransform=f(),g.setAttributes=u(),g.insert=l().bind(null,"head"),g.domAPI=a(),g.insertStyleElement=p();o()(m.A,g);const A=m.A&&m.A.locals?m.A.locals:void 0},,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".VL0kO7hsa9VqMvL6M4Lu{width:100%;position:relative;box-sizing:border-box}.if_5lorUd6x1xkqUMNOC{background:#f7f8fa;border:1px solid #d1d4d8;border-radius:4px;overflow:hidden;display:flex}@media screen and (max-width: 993px){.if_5lorUd6x1xkqUMNOC{flex-wrap:wrap}}.if_5lorUd6x1xkqUMNOC .tDmeTCgunZRymLuomvyj{margin:1.25rem;width:calc(50% - 1.25rem)}@media(max-width: 993px){.if_5lorUd6x1xkqUMNOC .tDmeTCgunZRymLuomvyj{display:none}}.if_5lorUd6x1xkqUMNOC .D5WVNzNrwdqlhd5rmZB5{width:calc(50% + 1.5rem);padding-block:1.25rem 1.5rem;padding-inline:0 1.5rem}@media screen and (max-width: 993px){.if_5lorUd6x1xkqUMNOC .D5WVNzNrwdqlhd5rmZB5{width:100%;padding:1.25rem 1.5rem}}.if_5lorUd6x1xkqUMNOC .iXiaVriR4iqyFdX1v35w{display:flex;flex-wrap:wrap;gap:1.25rem}.if_5lorUd6x1xkqUMNOC .eLvCFIs16ovGQDaVGR2M{flex-direction:column}","",{version:3,sources:["webpack://./src/templates/studioHomepages/twoColumnActionBlock.module.scss","webpack://./../shared/css/color.scss"],names:[],mappings:"AAIA,sBACE,UAAA,CACA,iBAAA,CACA,qBAAA,CAGF,sBACE,kBC6Lc,CD5Ld,wBAAA,CACA,iBAAA,CACA,eAAA,CACA,YAAA,CAEA,qCAPF,sBAQI,cAAA,CAAA,CAGF,4CACE,cAAA,CACA,yBAAA,CAEA,yBAJF,4CAKI,YAAA,CAAA,CAIJ,4CACE,wBAAA,CACA,4BAAA,CACA,uBAAA,CAEA,qCALF,4CAMI,UAAA,CACA,sBAAA,CAAA,CAIJ,4CACE,YAAA,CACA,cAAA,CACA,WAAA,CAEA,4CACE,qBAAA",sourcesContent:["@import 'color';\n\n$breakpoint: 993px;\n\n.container {\n  width: 100%;\n  position: relative;\n  box-sizing: border-box;\n}\n\n.actionBlockWrapper {\n  background: $light_gray_50;\n  border: 1px solid $light_gray_200;\n  border-radius: 4px;\n  overflow: hidden;\n  display: flex;\n\n  @media screen and (max-width: $breakpoint) {\n    flex-wrap: wrap;\n  }\n\n  .image {\n    margin: 1.25rem;\n    width: calc(50% - 1.25rem);\n\n    @media (max-width: $breakpoint) {\n      display: none;\n    }\n  }\n\n  .contentWrapper {\n    width: calc(50% + 1.5rem);\n    padding-block: 1.25rem 1.5rem;\n    padding-inline: 0 1.5rem;\n\n    @media screen and (max-width: $breakpoint) {\n      width: 100%;\n      padding: 1.25rem 1.5rem;\n    }\n  }\n\n  .buttonsContainer {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1.25rem;\n\n    &VerticalButtons {\n      flex-direction: column;\n    }\n  }\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B6;\n$light_gray_500: #989EA5;\n$light_gray_600: #858C94;\n$light_gray_700: #727A83;\n$light_gray_800: #5F6872;\n$light_gray_900: #4C5661;\n$light_gray_950: #394450;\n\n$light_affirmative_100: #E2F1E2;\n$light_affirmative_500: #3EA33E;\n$light_affirmative_700: #2D742D;\n\n$light_negative_100: #FBE0DD;\n$light_negative_500: #E5311A;\n$light_negative_700: #B24949;\n\n$light_caution_100: #FEF7DF;\n$light_caution_500: #F9CB28;\n$light_caution_700: #C7A220;\n\n$light_accent_100: #FAD7D7;\n$light_accent_500: #ED6060;\n$light_accent_700: #D84C4C;\n\n$light_aqua_100: #CEFFFD;\n$light_aqua_500: #3CFFF8;\n$light_aqua_700: #30CCC6;\n\n$light_orange_100: #FFEDCC;\n$light_orange_500: #FFA400;\n$light_orange_700: #CC8300;\n\n$light_info_100: #DCEFFB;\n$light_info_500: #1892E3;\n$light_info_700: #1375B6;\n\n$light_white: #FFFFFF;\n\n$light_black: #292F36;\n\n$light_black_opacity_90: rgba(41, 47, 54, 0.90);\n$light_black_opacity-80: rgba(41, 47, 54, 0.80);\n$light_black_opacity-70: rgba(41, 47, 54, 0.70);\n$light_black_opacity-60: rgba(41, 47, 54, 0.60);\n$light_black_opacity-50: rgba(41, 47, 54, 0.50);\n$light_black_opacity-40: rgba(41, 47, 54, 0.40);\n$light_black_opacity-30: rgba(41, 47, 54, 0.30);\n$light_black_opacity-20: rgba(41, 47, 54, 0.20);\n$light_black_opacity-10: rgba(41, 47, 54, 0.10);\n"],sourceRoot:""}]),a.locals={container:"VL0kO7hsa9VqMvL6M4Lu",actionBlockWrapper:"if_5lorUd6x1xkqUMNOC",image:"tDmeTCgunZRymLuomvyj",contentWrapper:"D5WVNzNrwdqlhd5rmZB5",buttonsContainer:"iXiaVriR4iqyFdX1v35w",buttonsContainerVerticalButtons:"eLvCFIs16ovGQDaVGR2M"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".UqoZlxFZBC6Dcu0aCBqf{display:flex;flex-direction:column;align-items:flex-start;gap:1rem;min-width:600px;max-width:800px;padding:1.5rem 2rem;border-radius:.5rem;box-shadow:0 6px 18px 0 rgba(0,0,0,.3);overflow:auto}.UqoZlxFZBC6Dcu0aCBqf hr{width:100%;height:.0625rem;margin:0;border:0;flex-shrink:0;background:var(--borders-neutral-primary)}.UqoZlxFZBC6Dcu0aCBqf h3,.UqoZlxFZBC6Dcu0aCBqf p{margin:0;color:var(--text-neutral-primary)}.ZPNWeV5rwEjXG7gQmZo3{display:grid;grid-template-columns:1fr auto 1fr;align-self:stretch;gap:1.25rem}.y9fdJ4JYedzDvehBiFvO{display:flex;flex-direction:column;align-items:flex-start;gap:1rem}.JmAouqg9obfN0TEQUhBw{display:flex;flex-direction:column;align-items:center;gap:.25rem}.puCt_OHQi10lYbDxm7YQ{width:.0625rem;flex:1;background:var(--borders-neutral-primary)}.l5j6vFybhFxeMANI6TWb{display:flex;align-items:flex-end;gap:.75rem}.DUF1Ss2XJiS3pEQlXqt4{height:2.5rem}.h0xQ37XKADxt4hQjL7bN select{width:160px}.iIWoBh7WIk7j1KM15IYZ{text-align:center}","",{version:3,sources:["webpack://./src/templates/sign-in-or-age-dialog.module.scss"],names:[],mappings:"AAIA,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CAEA,eAAA,CACA,eAAA,CACA,mBAAA,CAEA,mBAAA,CACA,sCAAA,CACA,aAAA,CAEA,yBACE,UAAA,CACA,eAAA,CACA,QAAA,CACA,QAAA,CACA,aAAA,CACA,yCAAA,CAGF,iDAEE,QAAA,CACA,iCAAA,CAIJ,sBACE,YAAA,CACA,kCAAA,CACA,kBAAA,CACA,WAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,sBAAA,CACA,QAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,UAAA,CAGF,sBACE,cAAA,CACA,MAAA,CACA,yCAAA,CAGF,sBACE,YAAA,CACA,oBAAA,CACA,UAAA,CAMF,sBACE,aAAA,CAIF,6BACE,WAAA,CAIF,sBACE,iBAAA",sourcesContent:["/* Built on CustomDialog rather than Modal because Modal fixes its content into\n   a single column, and this dialog's two columns are the design. The box rules\n   below mirror the design system's modal.module.scss so it still looks like one\n   of the family. */\n.dialog {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n\n  min-width: 600px;\n  max-width: 800px;\n  padding: 1.5rem 2rem;\n\n  border-radius: 0.5rem;\n  box-shadow: 0 6px 18px 0 rgb(0 0 0 / 0.3);\n  overflow: auto;\n\n  hr {\n    width: 100%;\n    height: 0.0625rem;\n    margin: 0;\n    border: 0;\n    flex-shrink: 0;\n    background: var(--borders-neutral-primary);\n  }\n\n  h3,\n  p {\n    margin: 0;\n    color: var(--text-neutral-primary);\n  }\n}\n\n.columns {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-self: stretch;\n  gap: 1.25rem;\n}\n\n.column {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 1rem;\n}\n\n.orDivider {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.orLine {\n  width: 0.0625rem;\n  flex: 1;\n  background: var(--borders-neutral-primary);\n}\n\n.ageRow {\n  display: flex;\n  align-items: flex-end;\n  gap: 0.75rem;\n}\n\n/* SimpleDropdown is a fixed 2.5rem; a medium button lands ~2px taller. */\n\n/* A class, not a `button` selector: MUI renders the sign-in href as an anchor. */\n.action {\n  height: 2.5rem;\n}\n\n/* On the select, so SimpleDropdown's arrow stays at its right edge. */\n.ageDropdown select {\n  width: 160px;\n}\n\n/* Dialog leaves its text start-aligned but centres its button. */\n.tooYoungDialog {\n  text-align: center;\n}\n"],sourceRoot:""}]),a.locals={dialog:"UqoZlxFZBC6Dcu0aCBqf",columns:"ZPNWeV5rwEjXG7gQmZo3",column:"y9fdJ4JYedzDvehBiFvO",orDivider:"JmAouqg9obfN0TEQUhBw