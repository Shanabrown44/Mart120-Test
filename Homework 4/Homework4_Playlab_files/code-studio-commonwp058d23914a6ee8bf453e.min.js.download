ACE,kBAAA,CAEA,+CACE,+BAAA,CAIJ,4CACE,WAAA,CACA,YAAA,CACA,qBAAA,CACA,gBAAA,CACA,mBAAA,CACA,YAAA,CAEA,kEACE,WAAA,CACA,YAAA,CACA,mBAAA,CAEA,yBALF,kEAMI,kBAAA,CACA,UAAA,CAEA,8FACE,WAAA,CAAA,CAIJ,yBAdF,kEAeI,qBAAA,CACA,YAAA,CAAA,CAIJ,kEACE,2BAAA,CAGF,kEACE,YAAA,CACA,qBAAA,CACA,WAAA,CAEA,oEACE,eAAA,CAGF,wFACE,YAAA,CACA,qBAAA,CACA,UAAA,CACA,WAAA,CAEA,+FACE,mBAAA,CACA,+CAAA,CACA,iBAAA,CACA,kBAAA,CACA,oBC5gBc,CD+gBhB,+FACE,cAAA,CAEA,oGACE,aAAA,CACA,gBAAA,CACA,sBAAA,CACA,eAAA,CACA,kBAAA,CACA,UAAA,CAGF,8GACE,eAAA,CAKF,iGACE,4BAAA,CACA,6BAAA,CAIJ,0GACE,QAAA,CACA,SAAA,CACA,qBAAA,CAON,wDACE,WAAA,CAIJ,gDACE,UAAA,CAIJ,sBACE,YAAA,CACA,mBAAA,CACA,mBAAA,CAEA,4CACE,iBAAA,CAIJ,sBACE,gCAAA,CAGF,6BACE,WAAA,CACA,eAAA,CAGF,sBACE,kBAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,kBAAA,CACA,gBAAA,CAEA,4CACE,oBAAA,CACA,qBAAA,CAGF,wBACE,sBAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,YAAA,CACA,oDAAA,CACA,gBAAA,CACA,oBC1mBsB,CD2mBtB,+CAAA,CAEA,wBACE,kDAAA,CAIJ,sBACE,gCAAA,CAGF,sBACE,mBAAA,CACA,gCAAA,CAGF,sBACE,kBAAA,CACA,iBAAA,CACA,kBAAA,CAEA,wBACE,oCAAA,CACA,4CAAA,CACA,eAAA,CAIJ,sBACE,YAAA,CACA,kBAAA,CACA,kBAAA,CACA,6BAAA,CACA,oDAAA,CACA,oBC7oBsB,CD8oBtB,sBAAA,CACA,sBAAA,CAEA,4CACE,YAAA,CACA,kBAAA,CACA,kBAAA,CACA,WAAA,CAEA,kEACE,+BAAA,CACA,iBAAA,CAGF,kEACE,cAAA,CAEA,oEACE,iCAAA",sourcesContent:['@use \'font.scss\' as font;\n\n// Please note (!): Mixins and variables form this file are listed in README.MD. Please keep it up to date. (any update)\n// to this files should be reflected in README.MD file.\n\n/* This file is being copied and adopted to shared/css/typography.scss\n   Updating styles in this file will require a manual sync of the that file.\n*/\n\n// This stylesheet can be imported to maintain typographic\n// consistency across Dashboard and Pegasus sites.\n\n// Includes heading, paragraph, and caption styles.\n\n// We\'re using mixins to style semantic tags and also creating\n// identical classes for potential use on other elements if needed.\n\n// ----------------------------------------\n// v 2.0.2\n// ----------------------------------------\n\n// Sizes\n// Most of the typography elements have a set of different sizes (defined by "-one", "-two", "-three", "-four" suffixes).\n// (Not applicable to Headings and elements without those suffixes)\n// Common rule for all of those sizes are following:\n// 1. "-one" is bigger size.\n// 2. "-two" is a DEFAULT size, used in most of cases.\n// 3. "-three" is smaller size.\n// 4. "-four" is the smallest size.\n\n// Values\n// font-size uses rem\n// - works when the root font-size is 100% which uses the\n// browser default font-size of 16px (3rem = 16 x 3 = 48px)\n\n// margin uses em\n// - sets the margin relative to the parent element rather than the root\n// example:\n//  Imagine that we have h1 with font-size: 3rem (48px) and we want to set margin-bottom to it.\n//    - Setting margin-bottom to 0.5rem == 8px (html.font_size * 0.5) >>> rem is relative to root element (html tag) which is 16px\n//    - Setting margin-bottom to 0.5em == 24px (h1.font-size * 0.5) >>> em is relative to element itself or it\'s parent.\n//      Our h1 element has a font-size of 3rem (48px), so 0.5em will be equal to 48 * 0.5 = 24px margin-bottom.\n\n// Read more about rem vs em:\n// https://www.digitalocean.com/community/tutorials/css-rem-vs-em-units\n\n// line-height uses unitless numbers\n// - this multiplies the line-height by the element\'s font-size\n// and is the preferred way to set line-height according to Mozilla\n// https://developer.mozilla.org/en-US/docs/Web/CSS/line-height\n\n// ----------------------------------------\n\n// Heading styles\n// Heading mixins are used to maintain accessible heading hierarchy\n// when design calls for a different style (semantic h3, h5 styling).\n\n// Use .heading-[xx] classes on single elements in the markup.\n// This is an h3 heading that will look like an h5.\n// - example: h3.heading-sm\n\n// Use @include [mixin-name] in stylesheets for widespread use.\n\n/* — example: all h3s in a ul need to look like h5s\n    ul.icon-list {\n      h3 { @include heading-sm }\n    }\n*/\n\n@mixin heading-common {\n  color: var(--text-neutral-primary);\n  margin: 0 0 0.5em 0;\n}\n\n@mixin heading-xxl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 3rem;\n  line-height: 1.08;\n  letter-spacing: -0.03rem;\n}\n\n@mixin heading-xl {\n  @include heading-common;\n  font-family: var(--font-family-heading);\n  font-weight: var(--font-weight-semi-bold);\n  font-size: 2.375rem;\n  line-height: 1.05;\n  letter-spacing: -0.03rem;\n}\n\n@mixin heading-lg {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.75rem;\n  line-height: 1.29;\n}\n\n@mixin heading-md {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.5rem;\n  line-height: 1.33;\n}\n\n@mixin heading-sm {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.375rem;\n  line-height: 1.36;\n}\n\n@mixin heading-xs {\n  @include heading-common;\n  @include font.main-font-semi-bold;\n  font-size: 1.25rem;\n  line-height: 1.4;\n}\n\n// Paragraph styles\n@mixin paragraph-common {\n  @include font.main-font-regular;\n  color: var(--text-neutral-primary);\n  margin-bottom: 1em;\n}\n\n@mixin body-one {\n  @include paragraph-common;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.4;\n}\n\n@mixin body-two {\n  @include paragraph-common;\n  font-size: var(--font-size-body-md);\n  line-height: 1.48;\n}\n\n@mixin body-three {\n  @include paragraph-common;\n  font-size: var(--font-size-body-sm);\n  line-height: 1.54;\n}\n\n@mixin body-four {\n  @include paragraph-common;\n  font-size: var(--font-size-body-xs);\n  line-height: 1.64;\n}\n\n// Overline styles\n@mixin overline-common {\n  @include paragraph-common;\n  @include font.main-font-semi-bold;\n  text-transform: uppercase;\n  letter-spacing: 0.04rem;\n}\n\n@mixin overline-one {\n  @include overline-common;\n  font-size: 0.875rem;\n  line-height: 1.54;\n}\n\n@mixin overline-two {\n  @include overline-common;\n  font-size: 0.813rem;\n  line-height: 1.64;\n}\n\n@mixin overline-three {\n  @include overline-common;\n  font-size: 0.688rem;\n  line-height: 1.76;\n}\n\n// Strong and Em styles\n@mixin strong {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n@mixin em {\n  font-style: italic;\n}\n\n// Caption styles\n@mixin figcaption {\n  @include font.main-font-semi-bold;\n  color: var(--text-neutral-primary);\n  font-size: 0.875rem;\n  line-height: 1.54;\n  margin: 0.5em 0 1em;\n}\n\n// ----------------------------------------\n\n// Headings\n.heading-xxl {\n  @include heading-xxl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xxl;\n    }\n  }\n}\n.heading-xl {\n  @include heading-xl;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xl;\n    }\n  }\n}\n.heading-lg {\n  @include heading-lg;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-lg;\n    }\n  }\n}\n.heading-md {\n  @include heading-md;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-md;\n    }\n  }\n}\n.heading-sm {\n  @include heading-sm;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-sm;\n    }\n  }\n}\n.heading-xs {\n  @include heading-xs;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      @include heading-xs;\n    }\n  }\n}\n\n// Paragraphs\n// Use on larger paragraphs\n.body-one {\n  @include body-one;\n  &.wrapper {\n    p,\n    li {\n      @include body-one;\n    }\n  }\n}\n\n// Use on default paragraphs\n.body-two {\n  @include body-two;\n  &.wrapper {\n    p,\n    li {\n      @include body-two;\n    }\n  }\n}\n\n// Use on course block descriptions or anywhere\n// else that needs smaller paragraph text\n.body-three {\n  @include body-three;\n  &.wrapper {\n    p,\n    li {\n      @include body-three;\n    }\n  }\n}\n\n// Use on smallest paragraph text\n.body-four {\n  @include body-four;\n  &.wrapper {\n    p,\n    li {\n      @include body-four;\n    }\n  }\n}\n\n// Overlines\n// Use on small uppercase labels or descriptions\n// (Bigger size)\n.overline-one {\n  @include overline-one;\n  &.wrapper {\n    p,\n    li {\n      @include overline-one;\n    }\n  }\n}\n\n// (Default size)\n.overline-two {\n  @include overline-two;\n  &.wrapper {\n    p,\n    li {\n      @include overline-two;\n    }\n  }\n}\n\n// (Smaller size)\n.overline-three {\n  @include overline-three;\n  &.wrapper {\n    p,\n    li {\n      @include overline-three;\n    }\n  }\n}\n\n// Use in paragraphs to bold text\nstrong,\n.strong {\n  @include strong;\n  &.wrapper strong {\n    @include strong;\n  }\n}\n\n// Use in paragraphs to italicize text\n\nem,\n.em {\n  @include em;\n  &.wrapper em {\n    @include em;\n  }\n}\n\n// Captions\n// Use on figcaption elements that accompany images or videos\nfigcaption,\n.figcaption {\n  @include figcaption;\n  &.wrapper figcaption {\n    @include figcaption;\n  }\n}\n\n// Use with typography elements to remove margins\n.no-margin {\n  margin: 0;\n  &.wrapper {\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6,\n    p,\n    li {\n      margin: 0;\n    }\n\n    ol,\n    ul {\n      margin-bottom: 0;\n    }\n  }\n}\n',"// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/custom-icons.min.css';\n","@import 'color', 'breakpoints', 'style-constants';\n@import '@code-dot-org/component-library-styles/variables.scss';\n@import '@code-dot-org/component-library-styles/typography.module';\n\n@mixin link-style {\n  color: var(--text-neutral-primary);\n  text-decoration: underline;\n  font-weight: 500;\n}\n\nbody {\n  background-color: var(--background-neutral-secondary) !important;\n}\n\nmain.wrapper {\n  padding-block: 0.625rem;\n}\n\ninput {\n  width: 100%;\n  box-sizing: border-box;\n  height: 46px !important;\n  text-indent: 0.25rem;\n}\n\nselect {\n  padding-top: 11px !important;\n  padding-bottom: 11px !important;\n  height: 46px !important;\n  font-weight: 400 !important;\n}\n\np,\nlabel {\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n}\n\n.gradeSelectChips {\n  label {\n    width: auto !important;\n    padding-top: 0.25rem !important;\n    padding-bottom: 0.25rem !important;\n  }\n}\n\nlabel {\n  width: 100%;\n  align-items: start !important;\n  gap: 0 0.5rem !important;\n}\n\nspan:not(:global(.MuiButton-icon)) {\n  margin-bottom: 0.125rem !important;\n}\n\n.typeHeaderBanner {\n  margin-block: 1.875rem 2.5rem !important;\n\n  h1 {\n    margin-bottom: 0 !important;\n  }\n}\n\n.errorMessage {\n  margin-top: 0.4375rem;\n  color: var(--text-error-primary);\n}\n\n// Login Type Selection page\n\n.newSignupFlow {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  padding-block-end: 2rem;\n  margin-inline: auto;\n  max-width: 100%;\n\n  a {\n    @include link-style;\n  }\n\n  .containerWrapper {\n    display: flex;\n    justify-content: space-between;\n    width: 100%;\n    background-color: var(--background-neutral-primary);\n    padding: 30px;\n    gap: 16px;\n    border-radius: $regular-border-radius;\n    border: 1px solid var(--borders-neutral-primary);\n    margin-bottom: 1rem;\n    box-sizing: border-box;\n    max-width: 970px;\n\n    @media (max-width: 800px) {\n      flex-direction: column;\n      align-items: center;\n      max-width: 400px;\n    }\n  }\n\n  .dividerContainer {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    margin: 0 20px;\n\n    .verticalDividerTop,\n    .verticalDividerBottom {\n      width: 1px;\n      background-color: var(--background-neutral-quaternary);\n      height: 50%;\n    }\n\n    .verticalDividerTop {\n      margin-bottom: 1rem;\n    }\n\n    .verticalDividerBottom {\n      margin-top: 1rem;\n    }\n\n    .dividerText {\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      text-transform: uppercase;\n      font-weight: 600;\n    }\n\n    @media (max-width: 800px) {\n      flex-direction: row;\n      width: 100%;\n      margin: 10px 0;\n\n      .dividerText {\n        position: static;\n        transform: none;\n        margin: 10px 0;\n      }\n\n      .verticalDividerTop,\n      .verticalDividerBottom {\n        width: 50%;\n        height: 1px;\n      }\n\n      .verticalDividerTop {\n        margin: 0 1rem 0 0;\n      }\n\n      .verticalDividerBottom {\n        margin: 0 0 0 1rem;\n      }\n    }\n  }\n\n  .container {\n    flex: 1;\n    margin: 0 10px;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    text-align: start;\n\n    input {\n      width: 100%;\n      box-sizing: border-box;\n      height: auto;\n    }\n\n    img {\n      margin-right: 0.5rem;\n      width: 2rem;\n    }\n\n    form {\n      margin-bottom: 0;\n      width: 100%;\n\n      button {\n        width: 100%;\n        margin: 0 0 0.5rem 0;\n      }\n    }\n\n    .ssoSignUpTypes {\n      display: flex;\n      flex-direction: column;\n    }\n\n    .validationMessage {\n      display: flex;\n      align-items: center;\n      margin-top: 0.125rem;\n\n      i {\n        margin-right: 0.5rem;\n      }\n\n      .teal {\n        color: var(--text-brand-teal-primary);\n      }\n\n      .lightGray {\n        color: var(--text-neutral-placeholder);\n      }\n\n      .red {\n        color: var(--text-error-primary);\n      }\n\n      p {\n        margin-bottom: 0;\n      }\n    }\n\n    .shortButton {\n      width: auto;\n      margin-top: 2rem;\n    }\n\n    .googleButton {\n      background-color: $google_brand_color;\n      color: $white;\n\n      &:hover {\n        background-color: darken($google_brand_color, 10%);\n      }\n    }\n\n    .microsoftButton {\n      background-color: $microsoft_brand_color;\n      color: $black;\n\n      &:hover {\n        background-color: darken($microsoft_brand_color, 10%);\n      }\n    }\n\n    .facebookButton {\n      background-color: $facebook_brand_color;\n      color: $white;\n\n      &:hover {\n        background-color: darken($facebook_brand_color, 10%);\n      }\n    }\n\n    .cleverButton {\n      background-color: $clever_brand_color;\n      color: $white;\n\n      &:hover {\n        background-color: darken($clever_brand_color, 10%);\n      }\n    }\n\n    .classlinkButton {\n      background-color: $classlink_brand_color;\n      color: $white;\n\n      &:hover {\n        background-color: darken($classlink_brand_color, 10%);\n      }\n    }\n\n    .greyTextbox {\n      margin-top: 1rem;\n      background-color: var(--background-neutral-secondary);\n      padding: 1rem;\n      border-radius: $regular-border-radius;\n      box-sizing: border-box;\n\n      .buttonContainer {\n        display: flex;\n        flex-direction: row;\n      }\n\n      @media (max-width: 850px) {\n        .buttonContainer {\n          flex-direction: column;\n          align-items: stretch;\n\n          div {\n            margin-inline: auto;\n          }\n        }\n      }\n\n      .iconContainer {\n        margin-bottom: 0.75rem;\n\n        img {\n          height: 38px;\n          width: 38px;\n          padding: 0.5rem;\n          background: var(--background-neutral-primary);\n          border: 1px solid var(--borders-neutral-primary);\n          border-radius: $regular-border-radius;\n        }\n      }\n\n      p {\n        margin-bottom: 0.25rem;\n      }\n\n      .subheader {\n        font-weight: 600;\n      }\n\n      img {\n        height: 18px;\n        width: 18px;\n      }\n\n      i {\n        float: right;\n        margin: 0.625rem 0 0.5rem 0.5rem;\n        font-size: 1rem;\n        color: var(--text-neutral-placeholder);\n      }\n\n      span {\n        font-weight: 600;\n        font-size: 0.875rem;\n        color: var(--text-neutral-primary);\n      }\n\n      a,\n      :global(.MuiButton-root) {\n        box-shadow: none;\n        margin: 0.5rem 0.5rem 0 0;\n        padding-inline: 14px;\n        height: 37px;\n        transition: all 0.2s ease-in-out;\n      }\n    }\n  }\n\n  .headers {\n    margin-bottom: 1.5rem;\n  }\n\n  .signUpWithTitle {\n    margin-bottom: 0.25rem;\n  }\n\n  .inputContainer {\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 1.125rem;\n  }\n}\n\n// Account Type Selection page\n\n.accountTypeContentContainer {\n  max-width: $content-width;\n  margin: auto;\n  font-size: 1rem;\n\n  .cardWrapper {\n    display: flex;\n    flex-flow: row wrap;\n    gap: 1.5rem;\n\n    @media (max-width: $width-sm) {\n      flex-direction: column;\n    }\n\n    & > div {\n      width: unset;\n      flex: 1;\n      justify-content: space-between;\n    }\n  }\n\n  .freeCurriculumWrapper {\n    text-align: center;\n    margin-top: 6rem;\n    margin-bottom: 2rem;\n\n    @media (max-width: $width-sm) {\n      margin-bottom: 4rem;\n    }\n\n    i {\n      font-size: 1.375rem;\n      color: var(--text-neutral-placeholder);\n      margin-bottom: 0.5rem;\n    }\n\n    p {\n      font-size: 0.875rem;\n\n      a {\n        @include link-style;\n      }\n    }\n\n    // Styled here to look like a text link\n    .dialogButton {\n      @include body-three;\n      margin: unset !important;\n      padding: unset !important;\n      background: none;\n      color: var(--text-neutral-tertiary);\n      text-decoration: underline !important;\n      transition: all 0.2s ease-in-out;\n\n      &:hover {\n        color: var(--text-neutral-primary);\n        background: none;\n      }\n\n      & > span {\n        font-weight: 400;\n      }\n    }\n  }\n}\n\n.dialogContainer {\n  padding: 1.5rem 2rem 1.875rem;\n  display: flex;\n  flex-direction: column;\n\n  .contentWrapper {\n    border-block: 1px solid var(--borders-neutral-primary);\n    padding-block: 1rem;\n    margin-bottom: 1.25rem;\n\n    .markdownDesc {\n      margin-bottom: 0.875rem;\n\n      p {\n        @include body-three;\n\n        a {\n          @include link-style;\n        }\n      }\n    }\n  }\n\n  button {\n    align-self: end;\n  }\n}\n\n// Finish Teacher/Student Account pages\n\n.finishAccountContainer {\n  max-width: $content-width;\n  display: grid;\n  margin: 4rem 4rem 1rem 4rem;\n  padding: 30px;\n  text-align: center;\n  background-color: var(--background-neutral-primary);\n  border-radius: $regular-border-radius;\n  border: 1px solid var(--borders-neutral-primary) !important;\n\n  .headerTextContainer {\n    margin-bottom: 30px;\n\n    h2 {\n      margin-bottom: 0.25rem !important;\n    }\n  }\n\n  .inputContainer {\n    width: 400px;\n    display: flex;\n    flex-direction: column;\n    text-align: start;\n    justify-self: center;\n    gap: 1.125rem;\n\n    .firstAndLastNameContainer {\n      width: 400px;\n      display: flex;\n      justify-self: center;\n\n      @media (min-width: ($width-sm + 1px)) {\n        flex-direction: row;\n        gap: 0.75rem;\n\n        .firstAndLastNameField > label {\n          min-width: 0;\n        }\n      }\n\n      @media (max-width: $width-sm) {\n        flex-direction: column;\n        gap: 1.125rem;\n      }\n    }\n\n    .displayNameInput {\n      margin: 0.375rem 0 !important;\n    }\n\n    .signupSourcesContainer {\n      display: flex;\n      flex-direction: column;\n      gap: 0.125rem;\n\n      > p {\n        font-weight: 600;\n      }\n\n      .sourcesDropdown {\n        display: flex;\n        flex-direction: column;\n        width: 100%;\n        gap: 0.125rem;\n\n        :focus {\n          outline-style: solid;\n          outline-color: var(--borders-brand-teal-primary);\n          outline-width: 2px;\n          outline-offset: 2px;\n          border-radius: $regular-border-radius;\n        }\n\n        > button {\n          height: 2.75rem;\n\n          span {\n            display: block;\n            text-align: start;\n            text-overflow: ellipsis;\n            overflow: hidden;\n            white-space: nowrap;\n            width: 100%;\n          }\n\n          i:last-of-type {\n            font-weight: 400;\n          }\n        }\n\n        ul {\n          label {\n            padding-top: 0.5rem !important;\n            align-items: center !important;\n          }\n        }\n\n        div:first-of-type {\n          top: 100%;\n          padding: 0;\n          box-sizing: border-box;\n        }\n      }\n    }\n  }\n\n  .requiredLabel {\n    span::after {\n      content: '*';\n    }\n  }\n\n  .dropdownContainer div {\n    width: 100%;\n  }\n}\n\n.finishSignUpButtonContainer {\n  display: grid;\n  margin-top: 1.125rem;\n  justify-content: end;\n\n  .finishSignUpButton {\n    width: fit-content;\n  }\n}\n\n.teacherKeepMeUpdated {\n  margin-bottom: 0.375rem !important;\n}\n\n.required::after {\n  content: '*';\n  font-weight: 600;\n}\n\n.displayNameSubtext {\n  margin-top: 0.125rem;\n}\n\n.emailOptInFootnote {\n  margin-top: 0.5rem;\n}\n\n.inlineContainer {\n  white-space: nowrap;\n  margin-top: 0.5rem;\n\n  .inlineItem {\n    display: inline-block;\n    vertical-align: middle;\n  }\n\n  a {\n    color: unset !important;\n  }\n}\n\n.parentInfoContainer {\n  display: flex;\n  flex-direction: column;\n  gap: 1.125rem;\n  background-color: var(--background-neutral-secondary);\n  padding: 1.125rem;\n  border-radius: $regular-border-radius;\n  border: 1px solid var(--borders-neutral-primary);\n\n  i {\n    background-color: var(--background-neutral-primary);\n  }\n}\n\n.parentKeepMeUpdated {\n  margin-bottom: 0.125rem !important;\n}\n\n.studentQuestionLabel {\n  margin-top: 1.125rem;\n  margin-bottom: 0.375rem !important;\n}\n\n.tosAndPrivacy {\n  align-items: center;\n  text-align: center;\n  margin-bottom: 4rem;\n\n  a {\n    text-decoration: underline !important;\n    color: var(--text-neutral-primary) !important;\n    font-weight: 700;\n  }\n}\n\n.errorSigningUpMessage {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: space-between;\n  background-color: var(--background-error-extra-light);\n  border-radius: $regular-border-radius;\n  padding: 0.625rem 0.75rem;\n  margin-bottom: 1.125rem;\n\n  .errorMessageWithXMark {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    gap: 0.625rem;\n\n    .xIcon {\n      color: var(--text-error-primary);\n      font-size: 0.875rem;\n    }\n\n    .errorMessageText {\n      margin-top: 2px;\n\n      a {\n        color: var(--text-neutral-primary);\n      }\n    }\n  }\n}\n","// Design System wide common variables\n\n$form-field-width: 18.75rem;\n\n// Border radius\n$regular-border-radius: 0.25rem;\n\n// z-index values\n// These values match Bootstrap's z-index values\n// See: https://getbootstrap.com/docs/5.0/layout/z-index/\n$zindex-dropdown: 1000;\n$zindex-sticky: 1020;\n$zindex-fixed: 1030;\n$zindex-modal-backdrop: 1040;\n$zindex-offcanvas: 1050;\n$zindex-modal: 1060;\n$zindex-popover: 1070;\n$zindex-tooltip: 1080;\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===\n\n$light_primary_100: #BFE4E8;\n$light_primary_500: #0093A4;\n$light_primary_700: #007785;\n\n$light_secondary_100: #E2D4EE;\n$light_secondary_500: #8C52BA;\n$light_secondary_700: #6C468A;\n\n$light_gray_50: #F7F8FA;\n$light_gray_100: #EAECEF;\n$light_gray_200: #D1D4D8;\n$light_gray_300: #BEC2C7;\n$light_gray_400: #ABB0B