","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:600;font-style:normal;font-size:16px;margin:4px 0 0 10px;padding:.3em}.oJLj1hxsqjE3PKJjEG5j{margin-bottom:7px}button.Fj_BbXrEUVOtePlC2zOT{margin:5px;font-size:unset}button.Fj_BbXrEUVOtePlC2zOT i{color:var(--text-neutral-primary);margin-right:10px}button.Fj_BbXrEUVOtePlC2zOT h3{display:inline-block;margin-top:.5em}button.Fj_BbXrEUVOtePlC2zOT:focus-visible{outline:2px solid var(--borders-brand-teal-primary);outline-offset:2px;border-radius:2px}.vajb8ulFNRr0J7yZdNEG{flex-direction:column;text-align:center;padding:36px;font-family:var(--font-family-main);font-weight:var(--font-weight-medium)}.vajb8ulFNRr0J7yZdNEG .RR2tT42zplInP5SlDyMv{margin:14px}.ZwdTsYMHGyBvV3rAc_6x{padding-bottom:36px;padding-left:0;padding-top:0;display:flex;justify-content:center}.hTYouImso36SNx1PBgAA{display:flex;align-items:center;margin-bottom:8px}.hTYouImso36SNx1PBgAA button .g6TRNv5bQe5S_pfA9AYJ{margin-left:5px}.kgmOpue8HAibgolfsnT3{margin-left:5px;margin-top:-5px}.FOoCkKUaNoBQaC6Mo5WD{margin-bottom:16px}',"",{version:3,sources:["webpack://./../frontend/packages/component-library-styles/typography.module.scss","webpack://./../frontend/packages/component-library-styles/font.scss","webpack://./src/templates/sectionsRefresh/sections-refresh.module.scss","webpack://./../frontend/packages/component-library-styles/mixins.scss","webpack://./../shared/css/font.scss"],names:[],mappings:"AAsMA,sBAhIE,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,uBAAA,CAyHE,oRAnIF,iCAAA,CACA,iBAAA,CAKA,sCAAA,CACA,wCAAA,CACA,cAAA,CACA,gBAAA,CACA,uBAAA,CAmIF,sBA7IE,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA,CACA,uBAAA,CA6HE,oRAhJF,iCAAA,CACA,iBAAA,CAcA,sCAAA,CACA,wCAAA,CACA,kBAAA,CACA,gBAAA