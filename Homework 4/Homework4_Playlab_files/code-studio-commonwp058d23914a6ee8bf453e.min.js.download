ets\n\n// Height of workspace headers (above actual blockly/droplet space, beneath\n// site header)\n$workspace-headers-height: 30px;\n\n// Width of horizontal and vertical resize bars\n$resize-bar-width: 13px;\n\n// Opacity of elements that are dragged out to be deleted\n$delete-opacity: 0.5;\n\n// Width of pegasus content as of 2017 redesign\n$content-width: 970px;\n"],sourceRoot:""}]),a.locals={cardIcon:"Dr1fmvxt9ZFYBNWkcifI",cardContainer:"BthDHzi60uYUt4Qa_ADd",cardContent:"MfPc2IpfGpweee76aQ_x",button:"raNrjKVaxIpQWnmtzcJo",cardSecondaryButton:"FDrog52CQ32epfLXgO_s",contentContainer:"aQ4FqJN0z7IeAYzspZzO",welcomeContainer:"vif14zmFMAX_JtU1PWkx",welcomeIconContainer:"DLVW8rRninMI_fkgCNqB",exchangeIcon:"zcfXluqpOURJURLya4rg",titleContainer:"hRhjGg5rMItKzCF7D9JQ",titleDesc:"hXf57OTioKL_I7AahQs2",newAccountForm:"KwQuL_fkXPgR7xvSDRQ4"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,'.nR55wKbFIX9B2Q8SoEmH{border:1px solid var(--borders-neutral-strong);border-radius:2px;width:214px;background-color:var(--background-neutral-secondary)}.nR55wKbFIX9B2Q8SoEmH a.yyiE3bgXGKFEKA9nNJZL{text-decoration:none}.XkY0F8zw1rKQLMmGMlGk{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Noto Sans KR","Noto Sans Myanmar","Noto Sans Sinhala","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Thai","Noto Sans Thaana","Noto Sans Math",sans-serif;font-weight:400;font-style:normal;padding-left:15px;padding-right:10px;padding-bottom:10px;font-size:.6875rem;color:var(--text-neutral-primary)}.p2AdyyD0R6bL6v6fd8LA{font-family:"Geist","Noto Sans","Noto Sans Arabic","Noto Sans Armenian","Noto Sans Bengali","Noto Sans SC","Noto Sans TC","Noto Sans Devanagari","Noto Sans Georgian","Noto Sans Hebrew","Noto Sans JP","Noto Sans Kannada","Noto Sans Khmer","Not