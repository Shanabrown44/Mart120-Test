ut off by the\n  // vertical scrollbar.\n  padding-inline-end: 12px;\n}\n\n.summaryEntryPoint.isStandalone {\n  padding-top: 40px;\n}\n\n.summaryEntryPoint.noQuestionContent {\n  margin-left: 50px;\n}\n\n.button {\n  float: left;\n}\n\n[dir="rtl"] .button {\n  float: right;\n}\n\n.responseIcon {\n  float: left;\n  padding: 1px 8px;\n\n  height: 30px; // button height;\n  line-height: 30px;\n\n  /* stylelint-disable selector-pseudo-class-no-unknown */\n  :global(.fa-user) {\n    vertical-align: middle;\n    font-size: 30px;\n    color: var(--background-brand-teal-primary);\n  }\n  /* stylelint-enable selector-pseudo-class-no-unknown */\n}\n\n[dir="rtl"] .responseIcon {\n  float: right;\n}\n\n.responseCounter {\n  float: left;\n  padding: 2px 0;\n\n  height: 38px; // button height;\n  line-height: 34px;\n\n  p {\n    margin: 0;\n  }\n\n  span.counter {\n    display: inherit;\n    line-height: 16px;\n  }\n\n  span.text {\n    display: block;\n    line-height: 16px;\n  }\n}\n\n[dir="rtl"] .responseCounter {\n  float: right;\n\n  // Since the `X/Y` counter doesn\'t have anything to get translated, explicitly\n  // set the text direction when in RTL mode.\n  span.counter {\n    direction: rtl;\n  }\n}\n'],sourceRoot:""}]),a.locals={summaryEntryPoint:"f6runZ81nWmx5rMD5d1c",isStandalone:"raIUkokuCqiDvvaPB5SA",noQuestionContent:"YSRUtzKyaRp_4_CQNMzQ",button:"Qi2OX4FC2OIPh9n_TK78",responseIcon:"Ap3xrp0XyXMCfBSIMo9x",responseCounter:"b0cKawcGybYdVLzmQhpj",counter:"ohTLOJTEx2v9Osruv4w5",text:"_rN7TSLxdfH7ec4OxWla"};const s=a},,,(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,":root,[data-theme=Light]{--background-accent-orange-light: var(--accent-orange-10);--background-accent-orange-primary: var(--accent-orange-50);--background-accent-orange-strong: var(--accent-orange-70);--background-accent-strawberry-light: var(--accent-strawberry-10);--background-accent-strawberry-primary: var(--accent-strawberry-50);--background-accent-str