QAAA,CAMJ,sBACE,YAAA,CACA,kDAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,YAAA,CACA,oDAAA,CACA,6BAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,OAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,OAAA,CAGF,sBACE,cAAA,CACA,eAAA,CACA,gBAAA,CACA,mBAAA,CACA,wBAAA,CACA,kBAAA,CACA,oCAAA,CAGF,sBACE,YAAA,CACA,OAAA,CAGF,sBACE,mBAAA,CACA,kBAAA,CACA,WAAA,CACA,aAAA,CACA,gBAAA,CACA,6BAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,kBAAA,CAGF,sBACE,gDAAA,CACA,sCAAA,CACA,mCAAA,CAGF,sBACE,6CAAA,CACA,mCAAA,CACA,gCAAA,CAGF,sBACE,gDAAA,CACA,sCAAA,CACA,mCAAA,CAGF,sBACE,sDAAA,CACA,4CAAA,CACA,yCAAA,CAGF,sBACE,QAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,iCAAA,CAGF,sBACE,QAAA,CACA,cAAA,CACA,gBAAA,CACA,iCAAA,CAKF,sBACE,YAAA,CACA,qBAAA,CACA,MAAA,CACA,WAAA,CACA,iCAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,QAAA,CACA,WAAA,CACA,cAAA,CACA,qDAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,OAAA,CACA,eAAA,CAEA,iCACE,wBAAA,CAIJ,sBACE,YAAA,CACA,mBAAA,CACA,MAAA,CACA,YAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,MAAA,CACA,WAAA,CAKF,sBACE,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,OAAA,CACA,MAAA,CACA,WAAA,CAGF,sBACE,cAAA,CACA,eAAA,CACA,gBAAA,CACA,oBAAA,CACA,wBAAA,CAGF,sBACE,cAAA,CACA,gBAAA,CACA,kBAAA,CAKF,sBACE,YAAA,CACA,cAAA,CACA,gBAAA,CACA,iCAAA",sourcesContent:['// Styles for the Tutor+ project page: the side panel (AssessmentPanel),\n// the work area (ProjectStage), the details footer (ProjectDetailsCard),\n// and the page frame with its top bar (ProjectView).\n\n// --- Side panel (AI assessment / feedback) ---\n\n.panel {\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n  width: 360px;\n  border-right: 1px solid var(--border-neutral-primary);\n}\n\n.panelHeader {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 40px;\n  padding: 8px;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 18px;\n  letter-spacing: 0.72px;\n  text-transform: uppercase;\n}\n\n.panelContent {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  flex: 1;\n  min-height: 0;\n  padding: 16px;\n  overflow-y: auto;\n}\n\n.panelSection {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.sectionLabelRow {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.sectionLabel {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 18px;\n  letter-spacing: 0.72px;\n  text-transform: uppercase;\n  color: var(--text-info-primary-fixed);\n}\n\n// "Shown to / Not shown to" visibility tag on the teacher\'s panel sections.\n.visibilityTag {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  height: 20px;\n  padding: 0 6px;\n  background-color: var(--background-neutral-tertiary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  white-space: nowrap;\n  color: var(--text-neutral-secondary);\n}\n\n// --- Feedback chat card ---\n\n.chatCard {\n  overflow: hidden;\n  border-radius: var(--shape-md);\n}\n\n.chatHeader {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 16px;\n  background-color: var(--background-info-strong);\n}\n\n.chatAvatar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 40px;\n  height: 40px;\n  background-color: var(--background-neutral-white-fixed);\n  border-radius: var(--shape-round);\n\n  img {\n    width: 30px;\n    height: 20px;\n  }\n}\n\n.chatMeta {\n  display: flex;\n  flex-direction: column;\n  color: var(--text-neutral-white-fixed);\n}\n\n.chatAuthor {\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 22px;\n}\n\n.chatTimestamp {\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.chatBody {\n  padding: 16px;\n  background-color: var(--background-neutral-secondary);\n  font-size: 12px;\n  line-height: 18px;\n\n  p {\n    margin: 0;\n  }\n}\n\n// --- Rubric (teacher only) ---\n\n.rubricItem {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 12px;\n  background-color: var(--background-neutral-secondary);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font-size: 12px;\n  line-height: 18px;\n\n  p {\n    margin: 0;\n  }\n}\n\n.rubricItemAssigned {\n  border-color: var(--border-accent-pink-primary);\n}\n\n.rubricLevelRow {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 20px;\n}\n\n.rubricLevel {\n  font-weight: 600;\n}\n\n.assignedTag {\n  display: inline-flex;\n  align-items: center;\n  height: 20px;\n  padding: 0 6px;\n  background-color: var(--background-accent-pink-light);\n  border: 1px solid var(--border-accent-pink-mid);\n  border-radius: var(--shape-sm);\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  white-space: nowrap;\n  color: var(--text-accent-pink-secondary);\n}\n\n// --- Work area (media stage) ---\n\n.projectRow {\n  display: flex;\n  align-items: stretch;\n  flex: 1;\n  min-height: 0;\n}\n\n.mediaColumn {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n}\n\n.mediaArea {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex: 1;\n  min-height: 0;\n  padding: 24px;\n}\n\n.whiteboardImage {\n  max-width: 720px;\n  max-height: 100%;\n  width: 100%;\n  object-fit: contain;\n  border-radius: var(--shape-md);\n}\n\n.storyVideo {\n  height: 100%;\n  max-height: 468px;\n  max-width: 100%;\n  border-radius: var(--shape-md);\n}\n\n.audioBar {\n  padding: 0 16px 16px;\n\n  audio {\n    display: block;\n    width: 100%;\n  }\n}\n\n// Side panel with the typed explanation on whiteboard + text projects.\n.explanation {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  flex-shrink: 0;\n  width: 260px;\n  padding: 16px;\n  border-left: 1px solid var(--border-neutral-primary);\n  overflow-y: auto;\n}\n\n.explanationCard {\n  padding: 12px;\n  background-color: var(--background-neutral-secondary);\n  border-radius: var(--shape-md);\n  font-size: 12px;\n  line-height: 18px;\n  white-space: pre-wrap;\n\n  p {\n    margin: 0;\n  }\n}\n\n// --- Project details footer ---\n\n.detailsWrapper {\n  padding: 16px;\n  border-top: 1px solid var(--border-neutral-primary);\n}\n\n.detailsCard {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  padding: 12px;\n  background-color: var(--background-neutral-secondary);\n  border-radius: var(--shape-md);\n}\n\n.detailsMeta {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.detailsMetaRow {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.unitLabel {\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  letter-spacing: 0.6px;\n  text-transform: uppercase;\n  white-space: nowrap;\n  color: var(--text-info-primary-fixed);\n}\n\n.tags {\n  display: flex;\n  gap: 4px;\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  height: 20px;\n  padding: 0 6px;\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  white-space: nowrap;\n}\n\n.tagWarning {\n  background-color: var(--background-warning-light);\n  border-color: var(--border-warning-mid);\n  color: var(--text-warning-secondary);\n}\n\n.tagInfo {\n  background-color: var(--background-info-light);\n  border-color: var(--border-info-mid);\n  color: var(--text-info-secondary);\n}\n\n.tagSuccess {\n  background-color: var(--background-success-light);\n  border-color: var(--border-success-mid);\n  color: var(--text-success-secondary);\n}\n\n.tagOrange {\n  background-color: var(--background-accent-orange-light);\n  border-color: var(--border-accent-orange-mid);\n  color: var(--text-accent-orange-secondary);\n}\n\n.studentName {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 24px;\n  color: var(--text-brand-secondary);\n}\n\n.projectPrompt {\n  margin: 0;\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--text-neutral-primary);\n}\n\n// --- Page frame ---\n\n.projectView {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n  color: var(--text-neutral-primary);\n}\n\n.topBar {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  height: 40px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--border-neutral-primary);\n}\n\n.topBarSide {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 180px;\n\n  &:last-child {\n    justify-content: flex-end;\n  }\n}\n\n.contentRow {\n  display: flex;\n  align-items: stretch;\n  flex: 1;\n  min-height: 0;\n}\n\n.stage {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n}\n\n// --- Version / project navigation ---\n\n.versionControls {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  flex: 1;\n  min-width: 0;\n}\n\n.versionLabel {\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 18px;\n  letter-spacing: 0.72px;\n  text-transform: uppercase;\n}\n\n.projectCount {\n  font-size: 12px;\n  line-height: 18px;\n  white-space: nowrap;\n}\n\n// --- Loading / error ---\n\n.statusText {\n  padding: 24px;\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--text-neutral-primary);\n}\n'],sourceRoot:""}]),a.locals={panel:"vueSShwLZLRE0S_zNFEg",panelHeader:"AsdeUDWjFdcnnL71wvWy",panelContent:"T7zpHwYyI3oiskOJ_aIZ",panelSection:"DyFGQFan9AiBNEczYQtu",sectionLabelRow:"KDSQTqwdQixJJfuEMbNa",sectionLabel:"hjcS11kXqrDA964nj47u",visibilityTag:"hV0CnQUkZSnmm8r5UJEE",chatCard:"n4jdl2Uij04P7oEkL3ik",chatHeader:"ng6uXYLRrMkuW4Vwn0GY",chatAvatar:"LkITOPkPE4vzYshx657H",chatMeta:"AqsQDS7QUCPXpOdt2mTC",chatAuthor:"dZ3Ofdx_aQ24nyiTbdFD",chatTimestamp:"VYBQeNe9QHVLkhdZl5sW",chatBody:"hhDLEaMavtZWdrFVE9Ks",rubricItem:"C7BTCg3IoQaZYPYaNMQI",rubricItemAssigned:"dnXPagg_Fp0tHhaNHW6s",rubricLevelRow:"DriKnP5dlJuDkLKBTuOQ",rubricLevel:"SM04R6DsGP5keG2cTcmp",assignedTag:"hIHa4l__C5Qwz_W5Ss9W",projectRow:"R1USfch8ZaYqftYom0EB",mediaColumn:"PK7YFzkJtfix6zmAMj6a",mediaArea:"HPKObBaz4JdLOpQKGjMZ",whiteboardImage:"CtuEYtW2eACcwIYhnj4B",storyVideo:"d0mGGDUMy2zxK