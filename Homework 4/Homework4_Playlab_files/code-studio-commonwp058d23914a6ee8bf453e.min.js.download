A,iBACA,CAAA,iBACA,CAAA,iCAEA,YACE,CAAA,+BACA,CAAA,wDACA,CAAA,yBAGF,eACE,CAAA,sBAIJ,yDACE,CAAA,4CACA,CAAA,sBAGF,WACE,CAAA,sBAGF,kBACE,CAAA,6BACA,CAAA,kBACA,CAAA,kBACA,CAAA,YACA,CAAA,sBAGF,YACE,CAAA,sBACA,CAAA,kBACA,CAAA,sBAGF,YACE,CAAA,QACA,CAAA,sBAGF,YACE,CAAA,sBACA,CAAA,kBACA,CAAA,QACA,CAAA,4BAGF,eACE,CAAA,8BACA,CAAA,qEAEA,eAEE,CAAA,sBAIJ,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,QACA,CAAA,UACA,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,6BACA,CAAA,kBACA,CAAA,iBACA,CAAA,+CACA,CAAA,8CACA,CAAA,QACA,CAAA,YACA,CAAA,wBAEA,eACE,CAAA,sBAIJ,iBACE,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,kBACA,CAAA,sBAGF,cACE,CAAA,QACA,CAAA,uBAGF,cACE,CAAA,uBACA,CAAA,uBAGF,YACE,CAAA,sBAGF,YACE,CAAA,qBACA,CAAA,6BACA,CAAA,sBAGF,+CAEE,CAAA,sBACA,CAAA,eACA,CAAA,gBACA,CAAA,4BACA,CAAA,QACA,CAAA,oBACA,CAAA,aACA,CAAA,eACA,CAAA,WACA,CAAA,YAEA,CAAA,kBACA,CAAA,cACA,CAAA,iCACA,CAAA,qBAEA,CAAA,QACA,CAAA,2BAEA,mCEr2CA,CAAA,sCACA,CAAA,iBACA,CAAA,iCD8EA,CAAA,iBACA,CAAA,kCAiBA,CAAA,gBACA,CAAA,aDowCE,CAAA,eACA,CAAA,eACA,CAAA,sBACA,CAAA,6BAGF,mBACE,CAAA,4BAGF,iCACE,CAAA,oBACA,CAAA,eACA,CAAA,0BAKF,yBACE,CAAA,+BACA,iBACE,CAAA,4BAIJ,mCACE,CAAA,6BAGF,mCACE,CAAA,kCACA,wBACE,CAAA,sBAKN,kBACE,CAAA,cACA,CAAA,WACA,CAAA,eACA,CAAA,cACA,CAAA,cACA,CAAA,YACA,CAAA,kBACA,CAAA,sBAGF,sDACE,CAAA,sBAGF,gDACE,CAAA,sBAGF,qDACE,CAAA,sBAGF,oDACE,CAAA,sBAGF,mDACE,CAAA,sBAGF,qBACE,CAAA,YACA,CAAA,kBACA,CAAA,iBACA,CAAA,eACA,CAAA,WACA,CAAA,yBAEA,mBACE,CAAA,sBAIJ,0BACE,CAAA,yBACA,CAAA,YACA,CAAA,kBACA,CAAA,sBACA,CAAA,qCAGF,sBACE,oBACE,CAAA,CAAA,sBAIJ,eACE,CAAA,kBACA,CAAA,eACA,CAAA,gBACA,CAAA,iBACA,CAAA,sBAGF,eACE",sourcesContent:["@use '@code-dot-org/component-library-styles/typography.module.scss' as\n  typography;\n@import '@code-dot-org/component-library-styles/font';\n@import '@code-dot-org/component-library-styles/mixins';\n\n@keyframes pulse {\n  0% {\n    transform: scale(0.9);\n  }\n  70% {\n    transform: scale(1);\n    box-shadow: 0 0 0 50px rgba(90 153 212 / 0);\n  }\n  100% {\n    transform: scale(0.9);\n    box-shadow: 0 0 0 0 rgba(90 153 212 / 0);\n  }\n}\n\n.floatingActionButton {\n  position: fixed;\n  left: 10px;\n  bottom: 48px;\n\n  height: 55px;\n  width: 55px;\n  background-size: 55px;\n  padding: 0;\n\n  border-width: 0;\n  border-radius: 30px;\n\n  img {\n    opacity: 1;\n    border-radius: 30px;\n  }\n}\n\n.pulse {\n  animation: pulse 1.5s 1.7;\n  box-shadow: 0 0 0 0 rgba(90 153 212 / 0.5);\n}\n\n.taOverlay {\n  position: fixed;\n  left: 51px;\n  bottom: 97px;\n\n  height: 22px;\n  width: 32px;\n  background-size: 32px;\n  padding: 0;\n\n  border-width: 2px;\n  border-color: var(--borders-neutral-light);\n  border-radius: 15px;\n  border-style: solid;\n}\n\n.countOverlay {\n  position: fixed;\n  left: 51px;\n  bottom: 97px;\n\n  border-radius: 100px;\n  border-width: 2px;\n  border-color: var(--borders-neutral-light);\n  border-style: solid;\n\n  display: inline-flex;\n  height: 26px;\n  min-width: 26px;\n  padding: 2px 2px;\n  justify-content: center;\n  align-items: center;\n  flex-shrink: 0;\n\n  background: var(--background-error-primary);\n}\n\np.countText {\n  margin-top: 1px;\n  margin-bottom: 0 !important;\n  padding: 0 2px;\n\n  strong {\n    span {\n      color: var(--text-neutral-white-fixed, #fff);\n    }\n  }\n  font-variant-ligatures: no-common-ligatures;\n}\n\n.dismissableAlert {\n  position: fixed;\n  left: 86px;\n  bottom: 55px;\n  z-index: 2000;\n\n  display: flex;\n  width: 352px;\n  max-width: 352px;\n  padding: 12px;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 20px;\n\n  border-radius: 4px;\n  border: 1px solid var(--borders-neutral-primary);\n  background: var(--background-neutral-primary);\n\n  box-shadow: 0 4px 4px 0 rgb(0 0 0 / 0.25);\n}\n\n.dismissableAlertText {\n  max-width: 266px;\n  margin-top: 4px;\n  margin-left: 4px;\n  margin-bottom: -24px;\n\n  color: var(--text-neutral-primary, #292f36);\n  font-variant-ligatures: no-common-ligatures;\n}\n\n.alertCloseButton {\n  // Clear default button styles\n  background: none;\n  color: inherit;\n  border: none;\n  padding: 0;\n  font: inherit;\n  cursor: pointer;\n  outline: inherit;\n  box-shadow: none;\n\n  position: absolute;\n  top: 1rem;\n  inset-inline-end: 1rem; // Logical property for right in LTR, left in RTL\n\n  i {\n    color: var(--text-neutral-quaternary);\n    font-size: 1.1875rem;\n    line-height: 1.4844rem;\n    width: 1.4844rem;\n  }\n\n  &:hover {\n    box-shadow: none;\n    background: none;\n    color: inherit;\n    border: none;\n    padding: 0;\n    font: inherit;\n    cursor: pointer;\n    outline: inherit;\n\n    i {\n      color: var(--text-neutral-tertiary);\n    }\n  }\n\n  &:focus {\n    outline: var(--borders-brand-teal-primary) solid 2px;\n    outline-offset: 2px;\n  }\n}\n\n.viewScoresButton {\n  min-height: 35px;\n  width: 318px;\n\n  display: flex;\n  padding: 5px 16px;\n  justify-content: center;\n  align-items: center;\n  gap: 8px;\n  flex: 1 0 0;\n\n  border-radius: 4px;\n  background: var(--background-brand-aqua-primary) !important;\n}\n\n.viewScoresText {\n  color: var(--text-neutral-primary);\n  font-variant-ligatures: no-common-ligatures;\n\n  /* Button/Button 3 */\n  font-family: var(--font-family-main);\n  font-size: 14px;\n  font-style: normal;\n  font-weight: 600;\n  line-height: 154%; /* 21.56px */\n}\n\n.rubricContainer {\n  position: fixed;\n  left: 10px;\n  bottom: 123px;\n  z-index: 2000;\n  width: 760px;\n}\n\n.settings {\n  width: 762px;\n  min-height: 350px;\n  padding: 16px 16px 32px 16px;\n  gap: 16px;\n\n  border-radius: 0 0 4px 4px;\n  border-right: 2px solid var(--borders-neutral-solid);\n  border-bottom: 2px solid var(--borders-neutral-solid);\n  border-left: 2px solid var(--borders-neutral-solid);\n  background: var(--background-neutral-secondary);\n  box-shadow: 4px 4px 6px 0 rgb(0 0 0 / 0.25);\n\n  h2 {\n    margin-bottom: 0;\n  }\n}\n\n.settingsVisible {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.settingsHidden {\n  display: none;\n}\n\n.