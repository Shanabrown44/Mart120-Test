er-radius:var(--shape-round);box-shadow:0 4px 12px rgba(0,0,0,.4)}.IB995agUqW1StIqTdIma{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;background:none;border:none;border-radius:var(--shape-round);font-size:24px;line-height:1;cursor:pointer}.IB995agUqW1StIqTdIma:hover{background-color:var(--background-neutral-tertiary)}.vEs2rmNX5rO_65VYpHtf{display:inline-flex;align-items:center;gap:4px;height:24px;padding:2px 10px;background-color:var(--background-neutral-primary);border:1px solid var(--border-neutral-secondary);border-radius:var(--shape-round);font-family:inherit;font-size:12px;line-height:18px;color:var(--text-neutral-primary)}.XO4SO6J34CdfZcDnPmvw{cursor:pointer}.XO4SO6J34CdfZcDnPmvw:hover:not(:disabled){background-color:var(--background-neutral-tertiary)}.XO4SO6J34CdfZcDnPmvw:disabled{cursor:default;opacity:.7}.gMRjwS7ACoUQoStxky12{background-color:var(--background-selected-primary);border-color:var(--background-selected-primary);color:var(--text-selected-primary)}.gMRjwS7ACoUQoStxky12:hover:not(:disabled){background-color:var(--background-selected-primary)}.fjCuLIz4h9pj4PoLUjSg{font-weight:400}","",{version:3,sources:["webpack://./src/aiTutor/views/gallery/challenge-gallery.module.scss"],names:[],mappings:"AAMA,sBACE,YAAA,CACA,mBAAA,CACA,6BAAA,CACA,kDAAA,CACA,mCAAA,CACA,iCAAA,CAGF,sBACE,MAAA,CACA,WAAA,CACA,sBAAA,CAGF,sBACE,kBAAA,CAGF,sBACE,QAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,oBAAA,CACA,wBAAA,CACA,qCAAA,CAGF,sBACE,cAAA,CACA,sCAAA,CACA,iBAAA,CACA,eAAA,CACA,gBAAA,CACA,iCAAA,CAGF,sBACE,kBAAA,CAGF,sBACE,YAAA,CACA,oBAAA,CACA,QAAA,CACA,mBAAA,CACA,kBAAA,CACA,qDAAA,CAGF,sBACE,QAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,oBAAA,CACA,wBAAA,CACA,iCAAA,CAGF,sBACE,cAAA,CACA,gBAAA,CACA,oCAAA,CAGF,sBACE,YAAA,CACA,8CAAA,CACA,QAAA,CAGF,sBACE,YAAA,CACA,8CAAA,CACA,QAAA,CAGF,sBACE,cAAA,CACA,gBAAA,CACA,iCAAA,CAKF,sBACE,YAAA,CACA,qBAAA,CACA,aAAA,CACA,QAAA,CACA,WAAA,CACA,cAAA,CACA,oDAAA,CACA,oDAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,QAAA,CACA,cAAA,CAIF,sBACE,QAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,oBAAA,CACA,wBAAA,CACA,oCAAA,CAGF,sBACE,UAAA,CAEA,6BACE,UAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,OAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,eAAA,CACA,cAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,OAAA,CACA,QAAA,CACA,SAAA,CACA,eAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,QAAA,CACA,UAAA,CACA,yBAAA,CACA,eAAA,CACA,WAAA,CACA,cAAA,CACA,gBAAA,CACA,gBAAA,CACA,iCAAA,CACA,cAAA,CAEA,2CACE,mDAAA,CACA,kCAAA,CAIJ,sBACE,MAAA,CACA,WAAA,CACA,eAAA,CACA,sBAAA,CACA,kBAAA,CAGF,sBACE,eAAA,CAKF,sBACE,YAAA,CACA,qBAAA,CACA,eAAA,CACA,kDAAA,CACA,8CAAA,CACA,6BAAA,CAIF,4CACE,YAAA,CAGF,4CACE,YAAA,CAGF,sBACE,aAAA,CACA,UAAA,CACA,gBAAA,CACA,mDAAA,CAGF,sBACE,YAAA,CACA,qBAAA,CACA,OAAA,CACA,YAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,OAAA,CACA,eAAA,CAGF,sBACE,cAAA,CACA,eAAA,CACA,gBAAA,CACA,mBAAA,CACA,wBAAA,CACA,kBAAA,CACA,qCAAA,CAGF,sBACE,YAAA,CACA,OAAA,CAGF,sBACE,mBAAA,CACA,kBAAA,CACA,WAAA,CACA,aAAA,CACA,gBAAA,CACA,6BAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,kBAAA,CAGF,sBACE,8CAAA,CACA,oCAAA,CACA,iCAAA,CAGF,sBACE,oDAAA,CACA,0CAAA,CACA,uCAAA,CAGF,sBACE,gDAAA,CACA,sCAAA,CACA,mCAAA,CAGF,sBACE,sDAAA,CACA,4CAAA,CACA,yCAAA,CAGF,sBACE,QAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,iCAAA,CAGF,sBACE,aAAA,CACA,oBAAA,CAEA,4BACE,aAAA,CACA,yBAAA,CAMJ,sBACE,YAAA,CACA,cAAA,CACA,kBAAA,CACA,OAAA,CACA,eAAA,CAIF,sBACE,iBAAA,CACA,mBAAA,CAKF,sBACE,mBAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,WAAA,CACA,SAAA,CACA,eAAA,CACA,WAAA,CACA,6BAAA,CACA,cAAA,CACA,iCAAA,CACA,cAAA,CAEA,4BACE,mDAAA,CAIJ,sBACE,iBAAA,CACA,uBAAA,CACA,MAAA,CACA,SAAA,CACA,YAAA,CACA,OAAA,CACA,aAAA,CACA,oDAAA,CACA,gDAAA,CACA,gCAAA,CACA,oCAAA,CAKF,sBACE,mBAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,WAAA,CACA,SAAA,CACA,eAAA,CACA,WAAA,CACA,gCAAA,CACA,cAAA,CACA,aAAA,CACA,cAAA,CAEA,4BACE,mDAAA,CAIJ,sBACE,mBAAA,CACA,kBAAA,CACA,OAAA,CACA,WAAA,CACA,gBAAA,CACA,kDAAA,CACA,gDAAA,CACA,gCAAA,CACA,mBAAA,CACA,cAAA,CACA,gBAAA,CACA,iCAAA,CAKF,sBACE,cAAA,CAEA,2CACE,mDAAA,CAGF,+BACE,cAAA,CACA,UAAA,CAMJ,sBACE,mDAAA,CACA,+CAAA,CACA,kCAAA,CAEA,2CACE,mDAAA,CAIJ,sBACE,eAAA",sourcesContent:["// Styles for the Tutor+ project gallery: the page layout (ChallengeGallery),\n// the filter rail (GallerySidebar), the project cards (ProjectCard), and the\n// emoji reaction chips (ReactionChips).\n\n// --- Page layout ---\n\n.page {\n  display: flex;\n  align-items: stretch;\n  min-height: calc(100vh - 50px);\n  background-color: var(--background-neutral-primary);\n  font-family: var(--font-family-main);\n  color: var(--text-neutral-primary);\n}\n\n.main {\n  flex: 1;\n  min-width: 0;\n  padding: 20px 40px 40px;\n}\n\n.pageHeader {\n  margin-bottom: 24px;\n}\n\n.pageOverline {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 22px;\n  letter-spacing: 0.84px;\n  text-transform: uppercase;\n  color: var(--text-brand-primary-fixed);\n}\n\n.pageTitle {\n  margin: 4px 0 0;\n  font-family: var(--font-family-heading);\n  font-size: 2.75rem;\n  font-weight: 700;\n  line-height: 52px;\n  color: var(--text-neutral-primary);\n}\n\n.projectGroup {\n  margin-bottom: 40px;\n}\n\n.groupHeader {\n  display: flex;\n  align-items: baseline;\n  gap: 16px;\n  padding-bottom: 12px;\n  margin-bottom: 12px;\n  border-bottom: 1px solid var(--border-neutral-primary);\n}\n\n.groupTitle {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 22px;\n  letter-spacing: 0.84px;\n  text-transform: uppercase;\n  color: var(--text-neutral-primary);\n}\n\n.groupCount {\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--text-neutral-quaternary);\n}\n\n.videoGrid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, 200px);\n  gap: 16px;\n}\n\n.whiteboardGrid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, 300px);\n  gap: 16px;\n}\n\n.statusText {\n  font-size: 14px;\n  line-height: 22px;\n  color: var(--text-neutral-primary);\n}\n\n// --- Sidebar (filter rail) ---\n\n.sidebar {\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n  gap: 16px;\n  width: 260px;\n  padding: 20px 0;\n  background-color: var(--background-neutral-secondary);\n  border-right: 1px solid var(--border-neutral-primary);\n}\n\n.control {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 0 12px;\n}\n\n// Overline labels above each sidebar group.\n.panelLabel {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 22px;\n  letter-spacing: 0.84px;\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.dropdown {\n  width: 100%;\n\n  select {\n    width: 100%;\n  }\n}\n\n.unitNav {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.unitHeading {\n  display: flex;\n  align-items: center;\n  min-height: 32px;\n  padding: 0 16px;\n}\n\n.unitList {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.unitButton {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  padding: 4px 16px 4px 32px;\n  background: none;\n  border: none;\n  font-size: 16px;\n  line-height: 24px;\n  text-align: start;\n  color: var(--text-neutral-primary);\n  cursor: pointer;\n\n  &.selected {\n    background-color: var(--background-selected-primary);\n    color: var(--text-selected-primary);\n  }\n}\n\n.unitName {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.unitCount {\n  font-weight: 600;\n}\n\n// --- Project cards ---\n\n.card {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background-color: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n}\n\n// Video projects are portrait cards; whiteboard projects landscape.\n.videoCard .media {\n  height: 260px;\n}\n\n.whiteboardCard .media {\n  height: 179px;\n}\n\n.media {\n  display: block;\n  width: 100%;\n  object-fit: cover;\n  background-color: var(--background-neutral-tertiary);\n}\n\n.details {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 12px;\n}\n\n.metaRow {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 20px;\n}\n\n.unitLabel {\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  letter-spacing: 0.6px;\n  text-transform: uppercase;\n  white-space: nowrap;\n  color: var(--text-brand-primary-fixed);\n}\n\n.tags {\n  display: flex;\n  gap: 4px;\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  height: 20px;\n  padding: 0 6px;\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 16px;\n  white-space: nowrap;\n}\n\n.tagBrand {\n  background-color: var(--background-brand-light);\n  border-color: var(--border-brand-mid);\n  color: var(--text-brand-secondary);\n}\n\n.tagPink {\n  background-color: var(--background-accent-pink-light);\n  border-color: var(--border-accent-pink-mid);\n  color: var(--text-accent-pink-secondary);\n}\n\n.tagGreen {\n  background-color: var(--background-success-light);\n  border-color: var(--border-success-mid);\n  color: var(--text-success-secondary);\n}\n\n.tagOrange {\n  background-color: var(--background-accent-orange-light);\n  border-color: var(--border-accent-orange-mid);\n  color: var(--text-accent-orange-secondary);\n}\n\n.name {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 24px;\n  color: var(--text-brand-secondary);\n}\n\n.nameLink {\n  color: inherit;\n  text-decoration: none;\n\n  &:hover {\n    color: inherit;\n    text-decoration: underline;\n  }\n}\n\n// --- Reaction chips ---\n\n.reactions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 4px;\n  padding-top: 4px;\n}\n\n// The \"add reaction\" button, and the emoji picker popover it anchors.\n.addReactionWrapper {\n  position: relative;\n  display: inline-flex;\n}\n\n// A ghost icon button matching the Figma: a 32px rounded square (shape-sm),\n// no border, white thumbs-up, with a state layer on hover.\n.addReaction {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  background: none;\n  border: none;\n  border-radius: var(--shape-sm);\n  font-size: 14px;\n  color: var(--text-neutral-primary);\n  cursor: pointer;\n\n  &:hover {\n    background-color: var(--background-neutral-tertiary);\n  }\n}\n\n.picker {\n  position: absolute;\n  bottom: calc(100% + 4px);\n  left: 0;\n  z-index: 1;\n  display: flex;\n  gap: 2px;\n  padding: 0 4px;\n  background-color: var(--background-neutral-secondary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  box-shadow: 0 4px 12px rgb(0 0 0 / 40%);\n}\n\n// 32px emoji cells matching the Figma picker, each glyph ~24px so it fills\n// the cell with the designed padding.\n.pickerOption {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  background: none;\n  border: none;\n  border-radius: var(--shape-round);\n  font-size: 24px;\n  line-height: 1;\n  cursor: pointer;\n\n  &:hover {\n    background-color: var(--background-neutral-tertiary);\n  }\n}\n\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  height: 24px;\n  padding: 2px 10px;\n  background-color: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  font-family: inherit;\n  font-size: 12px;\n  line-height: 18px;\n  color: var(--text-neutral-primary);\n}\n\n// The project page's chips toggle the viewer's reaction; the gallery card\n// shows the same chips read-only, without these affordances.\n.chipInteractive {\n  cursor: pointer;\n\n  &:hover:not(:disabled) {\n    background-color: var(--background-neutral-tertiary);\n  }\n\n  &:disabled {\n    cursor: default;\n    opacity: 0.7;\n  }\n}\n\n// The viewer's own reaction: the Figma's filled \"selected\" chip — light\n// green field, navy text.\n.chipSelected {\n  background-color: var(--background-selected-primary);\n  border-color: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n\n  &:hover:not(:disabled) {\n    background-color: var(--background-selected-primary);\n  }\n}\n\n.count {\n  font-weight: 400;\n}\n"],sourceRoot:""}]),a.locals={page:"VmG7ABSjnGtVdoiUYJcA",main:"v0HJdmTJagGyuEtDmxIB",pageHeader:"t5FhXO3KnEA7juYGMmWY",pageOverline:"Nj4hbUqDoNXSoc_DHqDG",pageTitle:"Jw5VpmmQUyw1X2j6FeL4",projectGroup:"L8EfAMSihOFSMgreukc2",groupHeader:"vbjcVLIOzHEevEJLmE5g",groupTitle:"vAyu5EIgvlTDYoBQmtlJ",groupCount:"wD72BaP9WJxhkzroP3VL",videoGrid:"ZATnN58sA9yW4GOrmjTx",whiteboardGrid:"q9h6N8tDhSdWNR_cFfhr",statusText:"t6yBE3E35Yj_7YPLL9cu",sidebar:"TsjGO9OivkkY1ljMe1UK",control:"Osr5KzJTjIsX7RJmtt8t",panelLabel:"V1L1ehOsQbge3nAOrQer",dropdown:"uZ_CHnQgrjzL1H38IoiZ",unitNav:"HkaIQ5Ur2DbN9SDQVEnG",unitHeading:"XrXwGoDFwzFEki_lk4j6",unitList:"S8dsN9Tjp7PTwkwJws72",unitButton:"tbnP0nFm010ZoFd2iWK3",selected:"lQVpyVTLErujzyiN9tSr",unitName:"JxTbzkT9AADlRWbYwWaq",unitCount:"P9RxEfgMDto2jIfchCFZ",card:"y1MYNK3hpemrhquz_HyZ",videoCard:"BJPFJpMGje0NCAAOyCvA",media:"rijADwpKZ2XNaeRMLbBT",whiteboardCard:"J5G7VYFnPxFj3GMF4olP",details:"j7HlMioVAgEUZqT6o09P",metaRow:"QzJnKjCPNCgRGpfWb0XC",unitLabel:"qEC3_YRZ0B1GR5Gxq5OL",tags:"bxKpsAIUtb4uMriEpvhD",tag:"Gt6hVRQVSQtEVLaW0Hq2",tagBrand:"gK3mrQxY_DMvtY8FO0Uv",tagPink:"J7HTnUNpV66hI3mRINvD",tagGreen:"AXZOZkRNTvHrH2NWbofp",tagOrange:"N_euK8gaKLiUOrEW8AZ8",name:"em02Rl7J_naEstIeFobF",nameLink:"yXil3kF9NxCyOTQCSkfh",reactions:"MVsZUCohYIwRZc9zf7dv",addReactionWrapper:"BznRxorHJj4puC9yMPZh",addReaction:"itJfV5qu1MOiR1K5ILTC",picker:"zmAige6i3bn4eLIgLotu",pickerOption:"IB995agUqW1StIqTdIma",chip:"vEs2rmNX5rO_65VYpHtf",chipInteractive:"XO4SO6J34CdfZcDnPmvw",chipSelected:"gMRjwS7ACoUQoStxky12",count:"fjCuLIz4h9pj4PoLUjSg"};const s=a},(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(13),o=n.n(r),i=n(14),a=n.n(i)()(o());a.push([e.id,".vueSShwLZLRE0S_zNFEg{display:flex;flex-direction:column;