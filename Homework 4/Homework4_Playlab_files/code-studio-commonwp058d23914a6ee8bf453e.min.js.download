ight-radius:10px;border-width:1px;border-color:var(--tip-border);padding:5px 10px;width:222px;display:flex;align-items:center;gap:6px;cursor:pointer}.qmJTNE3MAfnnQVbKwbQw.S5elXxCyO7LupBmEWbHk{background-color:var(--tip-primary);color:var(--text-neutral-inverse)}.qmJTNE3MAfnnQVbKwbQw.S5elXxCyO7LupBmEWbHk:hover{background-color:var(--background-neutral-primary);color:var(--tip-primary)}.qmJTNE3MAfnnQVbKwbQw.vnJAjsLEUcMxGVLRe_oj{background-color:var(--background-neutral-primary);color:var(--tip-primary)}.qmJTNE3MAfnnQVbKwbQw.vnJAjsLEUcMxGVLRe_oj:hover{background-color:var(--tip-primary);color:var(--text-neutral-inverse)}._DzQuKPuqc4X7Kp1k8K5{border-style:solid;border-width:1px;border-color:var(--tip-border);background-color:var(--tip-secondary);padding:10px}.eaCVPTekMcFmw39Oprsb{margin-left:7px;margin-right:5px}.GHG5YktIupoRMoOuRIK0{margin-left:auto}',"",{version:3,sources:["webpack://./src/templates/lessonOverview/lesson-plan.module.scss","webpack://./../shared/css/color.scss","webpack://./../shared/css/font.scss"],names:[],mappings:"AAUA,sBACE,YAAA,CACA,6BAAA,CACA,aAAA,CAGF,sBACE,aAAA,CACA,aCYO,CDXP,cAAA,CACA,gBAAA,CAOA,yCACE,oBAAA,CAIJ,sBACE,YAAA,CAIA,8DACE,YAAA,CAKJ,sBACE,oBAAA,CAKF,sBACE,YAAA,CACA,kBAAA,CACA,eAAA,CAEA,yBACE,kBAAA,CAIJ,sBACE,SAAA,CACA,kBAAA,CAGF,sBACE,SAAA,CACA,wBAAA,CACA,0BAAA,CAGF,sBACE,YAAA,CACA,wBAAA,CAGF,sBACE,gBAAA,CAGF,sBAGE,iBAAA,CACA,OAAA,CACA,YAAA,CACA,cAAA,CAGF,sBACE,YAAA,CAGF,sBACE,YAAA,CACA,kBAAA,CACA,kBAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,mBAAA,CACA,6CAAA,CACA,iBAAA,CACA,gDAAA,CACA,mCAAA,CACA,kBAAA,CAKF,sBACE,YAAA,CACA,kBAAA,CAGF,sBACE,iBAAA,CAKF,sBErCE,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CFqCA,aClHc,CDqHhB,sBE/BE,yYAhFU,CAiFV,eAxEiB,CAyEjB,iBAAA,CF+BA,aC3BW,CD6BX,4BACE,yBAAA,CAIJ,sBEnDE,yYArEU,CAsEV,eA9DsB,CA+DtB,iBAAA,CFmDA,aChIc,CDmIhB,sBACE,WAAA,CAGF,sBACE,WAAA,CAKF,sBACE,oBAAA,CAGF,sBE5FE,yYA/CU,CAgDV,eA1CoB,CA2CpB,iBAAA,CF4FA,WAAA,CACA,wBC/HgB,CDkIlB,sBElGE,yYA/CU,CAgDV,eA1CoB,CA2CpB,iBAAA,CFkGA,WAAA,CAGF,sBACE,gBAAA,CAGF,sBACE,YAAA,CAGF,sBE9EE,yYAhFU,CAiFV,eAxEiB,CAyEjB,iBAAA,CFkFF,sBACE,gBAAA,CAKF,sBACE,QAAA,CAQA,yCACE,sCAAA,CAOF,yCACE,aAAA,CAIJ,sBACE,YAAA,CACA,qBAAA,CACA,UAAA,CAGF,sBACE,eAAA,CACA,iBAAA,CAGF,sBACE,iBAAA,CACA,gBAAA,CACA,0BAAA,CAGF,sBACE,iBAAA,CAKF,sBAGE,mBAAA,CAKF,sBACE,eAAA,CACA,aAAA,CAGF,sBACE,YAAA,CACA,cAAA,CAGF,sBACE,UAAA,CAKF,sBACE,iBAAA,CAGF,sBAEE,mCAAA,CACA,2BAAA,CACA,4BAAA,CACA,gBAAA,CACA,8BAAA,CACA,gBAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,OAAA,CACA,cAAA,CAOF,2CACE,mCAAA,CACA,iCAAA,CAEA,iDACE,kDAAA,CACA,wBAAA,CAIJ,2CACE,kDAAA,CACA,wBAAA,CAEA,iDACE,mCAAA,CACA,iCAAA,CAIJ,sBACE,kBAAA,CACA,gBAAA,CACA,8BAAA,CACA,qCAAA,CACA,YAAA,CAGF,sBACE,eAAA,CACA,gBAAA,CAGF,sBACE,gBAAA",sourcesContent:["@import 'color.scss';\n@import 'font.scss';\n\n// Consolidated styles for the lesson plan (lessonOverview) views. This replaces\n// the per-component inline `styles` objects and folds in the former\n// resource-list, lesson-standards, and lesson-tip CSS modules. The\n// level-details-dialog module is intentionally kept separate.\n\n// -- Shared by LessonOverview and StudentLessonOverview --------------------\n\n.header {\n  display: flex;\n  justify-content: space-between;\n  margin: 10px 0;\n}\n\n.navLink {\n  margin: 10px 0;\n  color: $purple;\n  font-size: 14px;\n  line-height: 22px;\n}\n\n// MUI's Typography root sets `margin: 0` at single-class\n// specificity, so pair our class with the MUI class to win on specificity\n// rather than on stylesheet load order.\n.headingWithMargins {\n  &:global(.MuiTypography-root) {\n    margin: 25px 0 10px 0;\n  }\n}\n\n.titleNoTopMargin {\n  margin-top: 0;\n\n  // .headingWithMargins above is also 0-2-0, so add a class to outrank it when\n  // a heading carries both, instead of depending on which rule comes last.\n  &.headingWithMargins:global(.MuiTypography-root) {\n    margin-top: 0;\n  }\n}\n\n// Bulletless list, shared by LessonStandards and LessonAgenda.\n.noBullets {\n  list-style-type: none;\n}\n\n// -- LessonOverview --------------------------------------------------------\n\n.frontPage {\n  display: flex;\n  flex-direction: row;\n  margin-top: 40px;\n\n  h2 {\n    margin-bottom: 10px;\n  }\n}\n\n.left {\n  width: 59%;\n  padding-right: 20px;\n}\n\n.right {\n  width: 41%;\n  padding: 0 10px 10px 20px;\n  border-left: solid 1px #333;\n}\n\n.dropdowns {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.printDropdown {\n  margin-right: 5px;\n}\n\n.printIcon {\n  // the icon text is a different size than the button text, so nudge it up to\n  // keep it vertically centered\n  position: relative;\n  top: 1px;\n  margin: 0 2px;\n  font-size: 16px;\n}\n\n.customText {\n  margin: 0 2px;\n}\n\n.standardsHeaderAndButton {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n}\n\n.fullCourseAlignmentButton {\n  margin-left: 50px;\n}\n\n.copyResourceWarningArea {\n  padding: 10px 10px 0;\n  border: 2px solid var(--borders-warning-light);\n  border-radius: 4px;\n  background-color: var(--background-warning-light);\n  color: var(--text-neutral-secondary);\n  margin-bottom: 10px;\n}\n\n// -- StudentLessonOverview -------------------------------------------------\n\n.headerActions {\n  display: flex;\n  align-items: center;\n}\n\n.printButton {\n  margin-right: 10px;\n}\n\n// -- LessonStandards -------------------------------------------------------\n\n.frameworkName {\n  @include main-font-semi-bold;\n  color: $dark_charcoal;\n}\n\n.categoryShortcode {\n  @include main-font-bold;\n  color: $link_color;\n\n  &:hover {\n    text-decoration: underline;\n  }\n}\n\n.standardShortcode {\n  @include main-font-semi-bold;\n  color: $dark_charcoal;\n}\n\n.summary {\n  padding: 3px;\n}\n\n.standard {\n  padding: 3px;\n}\n\n// -- LessonNavigationDropdown ----------------------------------------------\n\n.dropdown {\n  display: inline-block;\n}\n\n.section {\n  @include main-font-regular;\n  width: 300px;\n  background-color: $lightest_purple;\n}\n\n.lesson {\n  @include main-font-regular;\n  width: 300px;\n}\n\n.lessonLabelWrapper {\n  margin-left: 10px;\n}\n\n.lessonLabel {\n  margin: 0 2px;\n}\n\n.boldText {\n  @include main-font-bold;\n}\n\n// -- LessonAgenda ----------------------------------------------------------\n\n.agendaSection {\n  margin-left: 15px;\n}\n\n// -- ResourceList (formerly resource-list.module.scss) ---------------------\n\n.dropdownButton {\n  top: -2px;\n}\n\n// -- Activity --------------------------------------------------------------\n\n.activityHeader {\n  // MuiTypography-root sets `color` at the same specificity, so pair with the\n  // MUI class rather than relying on stylesheet load order.\n  &:global(.MuiTypography-root) {\n    color: var(--text-brand-purple-primary);\n  }\n}\n\n// -- ActivitySection -------------------------------------------------------\n\n.activitySectionHeader {\n  &:global(.MuiTypography-root) {\n    margin: 10px 0;\n  }\n}\n\n.textAndProgression {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n}\n\n.remarks {\n  margin-left: 5px;\n  font-style: italic;\n}\n\n.remarksBody {\n  margin-bottom: 5px;\n  padding-left: 5px;\n  border-left: 5px solid #ccc;\n}\n\n.progression {\n  margin-bottom: 5px;\n}\n\n// -- ProgressionDetails ----------------------------------------------------\n\n.progressionBox {\n  // The original inline style also set `margin: '10px, 0px'`, but the stray\n  // comma made it invalid CSS that browsers dropped; kept out here as a no-op.\n  padding: 0 10px 10px;\n}\n\n// -- LevelDetailsDialog ----------------------------------------------------\n\n.scrollContainer {\n  max-height: 60vh;\n  overflow: auto;\n}\n\n.sublevelCards {\n  display: flex;\n  flex-wrap: wrap;\n}\n\n.dialogButton {\n  margin: 5px;\n}\n\n// -- LessonTip (formerly lesson-tip.module.scss) ---------------------------\n\n.tip {\n  margin-bottom: 5px;\n}\n\n.tab {\n  // borders everywhere except the bottom\n  border-style: solid solid none solid;\n  border-top-left-radius: 10px;\n  border-top-right-radius: 10px;\n  border-width: 1px;\n  border-color: var(--tip-border);\n  padding: 5px 10px;\n  width: 222px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n}\n\n// The tab's foreground/background swap on expand and invert on hover.\n// --tip-primary is the per-tip-type strong color; it pairs against the neutral\n// surface (--background-neutral-primary) and inverse text (--text-neutral-inverse)\n// tokens, which both resolve to white in light mode and flip together in dark.\n.tab.expanded {\n  background-color: var(--tip-primary);\n  color: var(--text-neutral-inverse);\n\n  &:hover {\n    background-color: var(--background-neutral-primary);\n    color: var(--tip-primary);\n  }\n}\n\n.tab.collapsed {\n  background-color: var(--background-neutral-primary);\n  color: var(--tip-primary);\n\n  &:hover {\n    background-color: var(--tip-primary);\n    color: var(--text-neutral-inverse);\n  }\n}\n\n.box {\n  border-style: solid;\n  border-width: 1px;\n  border-color: var(--tip-border);\n  background-color: var(--tip-secondary);\n  padding: 10px;\n}\n\n.icon {\n  margin-left: 7px;\n  margin-right: 5px;\n}\n\n.caret {\n  margin-left: auto;\n}\n","// colors from https://www.dropbox.com/s/ycjiwt8vxlmv2ih/Code.org_stylesheet_v2_09.05.13.pdf\n\n// Please keep this file simple; it should only contain color definitions\n//   and aliases.  Variables defined in this file are exported to\n//   apps/src/util/color.js during the apps build process.\n\n$black: #000;\n$background_black: #121416;\n$dark_gray: #2D3139;\n$darkest_gray: #292F36;\n$dark_slate_gray: #282c34;\n$darkest_slate_gray: #25292d;\n$dark_charcoal: #4d575f;\n$charcoal: #5b6770;\n$light_gray: #949ca2;\n$lighter_gray: #c6cacd;\n$lightest_gray: #e7e8ea;\n$background_gray: #f2f2f2;\n$dimgray: #696969;\n$white: #fff;\n$default_blue: #3670b3;\n\n$dark_teal: #0094a3;\n$teal: #0093a4;\n$applab_button_teal: #1abc9c;\n$light_teal: #59cad3;\n$lightish_teal: #80d6de;\n$lighter_teal: #a6e3e8;\n$lightest_teal: #d9f3f5;\n\n$purple: #8c52ba;\n$light_purple: #a69bc1;\n$lighter_purple: #cfc9de;\n$lightest_purple: #ebe8f1;\n\n$cyan: #0094ca;\n$light_cyan: #59b9dc;\n$lighter_cyan: #a6daed;\n$lightest_cyan: #d9eff7;\n$almost_white_cyan: #f5fcff;\n\n$orange: #ffa400;\n$light_orange: #ffc459;\n$lighter_orange: #ffe0a6;\n$lightest_orange: #fff2d9;\n$dark_orange: #ff8600;\n\n$green: #b9bf15;\n$light_green: #d1d567;\n$lighter_green: #e7e9ad;\n$lightest_green: #f5f5dc;\n$highlight_green: #8afc9b;\n\n$yellow: #ffb81d;\n$light_yellow: #ffdb74;\n$lighter_yellow: #ffebb5;\n$lightest_yellow: #fff7df;\n\n$goldenrod: #daa520;\n\n$header_text: $white;\n$bkgnd_color: $teal;\n$inset_color: $lighter_gray;\n$dark_color: $purple;\n$hdr_color: $purple;\n\n// Some extra colors.\n$red: #c00;\n$lightest_red: #fcc;\n$dark_red: #d62911;\n$realgreen: #008000;\n$realyellow: #ff0;\n$mustardyellow: #efcd1c;\n$twitter_blue: #00aced;\n$x_black: #383939;\n$facebook_blue: #3b5998;\n$linkedin_blue: #0077B5;\n$dark_blue: #00647f;\n$blockly_flyout_gray: #ddd;\n$default_text: #333;\n$border_gray: #bbb;\n$border_light_gray: #d8d8d8;\n$table_header: #ececec;\n$table_light_row: #fcfcfc;\n$table_dark_row: #f4f4f4;\n\n// Progress colors.\n$level_submitted: $purple;\n$level_perfect: rgb(14, 190, 14);\n$level_passed: rgb(159, 212, 159);\n$level_attempted: $realyellow;\n$level_not_tried: #fefefe;\n$level_current: $orange;\n$level_review_rejected: $red;\n$level_review_accepted: rgb(11, 142, 11); // TODO: $level_passed;\n$assessment: $cyan;\n$workspace_running_background: #e5e5e5;\n\n// Experimental Sprite Lab validation colors.\n$dark_purple: #682A77;\n$bright_green: #0ebe0e;\n$neon_pink: #e9118f;\n\n// Links (used in apps).\n$link_color: #0596ce;\n\n// Shadow.\n$shadow: rgba(0, 0, 0, 0.3);\n\n// Colors that are taken from bootstrap, and not necessarily part of our core theme.\n$bootstrap_button_blue: #337ab7;\n$bootstrap_button_red: #d9534f;\n$bootstrap_error_background: #f2dede;\n$bootstrap_error_text: #b94a48;\n$bootstrap_v3_error_text: #a94442;\n$bootstrap_error_border: #ebccd1;\n$bootstrap_warning_background: #fcf8e3;\n$bootstrap_warning_text: #c09853;\n$bootstrap_warning_border: #faebcc;\n$bootstrap_border_color: #cccccc;\n$bootstrap_success_background: #dff0d8;\n$bootstrap_success_text: #468847;\n$bootstrap_success_border: #d6e9c6;\n\n// Colors taken from droplet, not part of our core theme.\n$droplet_light_green: #d3e965;\n$droplet_blue: #64b5f6;\n$droplet_bright_blue: #19c3e1;\n$droplet_yellow: #fff176;\n$droplet_orange: #ffb74d;\n$droplet_red: #f78183;\n$droplet_cyan: #4dd0e1;\n$droplet_pink: #f57ac6;\n$droplet_purple: #bb77c7;\n$droplet_green: #68d995;\n$droplet_white: $white;\n\n// Oceans: deep blue background.\n$oceans_deep_blue: rgb(2, 0, 28);\n\n// Dark theme background (used by default in Music Lab)\n$dark_black: #121212;\n\n// ===----===----===---- Phase 1 Colors: ----===----===----===\n// Brand\n$brand_primary_light: #E0F8F9;\n$brand_primary_default: #009EB0;\n$brand_primary_dark: #007785;\n\n$brand_secondary_light: #E0D1EC;\n$brand_secondary_default: #8C52BA;\n$brand_secondary_dark: #6C468A;\n\n$brand_accent_default: #ED6060;\n\n$brand_teal_5: #DFF2F4;\n\n//Product\n$product_affirmative_default: #3EA33E;\n\n$product_negative_light: #FDEBE9;\n$product_negative_default: #E5311A;\n$product_negative_dark: #AA2513;\n\n$product_caution_default: #F9CB28;\n\n$product_information_default: #007ACC;\n\n// Neutral\n$neutral_white: #FFFFFF;\n$neutral_light: #F7F8FA;\n$neutral_gray10: #EAEBEB;\n$neutral_dark10: #EAECEF;\n$neutral_dark20: #D1D4D8;\n$neutral_dark30: #BEC2C7;\n$neutral_dark40: #ABB0B6;\n$neutral_dark50: #989EA5;\n$neutral_dark60: #858C94;\n$neutral_dark70: #727A83;\n$neutral_dark80: #5F6872;\n$neutral_dark90: #4C5661;\n$neutral_dark: #292F36;\n\n//Brands\n$google_brand_color: #0F9D58;\n$microsoft_brand_color: #FFB900;\n$facebook_brand_color: #3B5998;\n$clever_brand_color: #1464FF;\n$classlink_brand_color: #0a4d7f;\n\n// ===----===----===---- Design system colors: ----===----===----===