NF6EzmPnzkGj{padding-left:10px;padding-right:10px;justify-content:center;margin-top:7px}","",{version:3,sources:["webpack://./src/scrapbook/scrapbook-button.module.scss"],names:[],mappings:"AAAA,sBACE,iBAAA,CACA,kBAAA,CACA,sBAAA,CAKA,cAAA",sourcesContent:[".button {\n  padding-left: 10px;\n  padding-right: 10px;\n  justify-content: center;\n  // Match the vertical offset of the user header button (.header_user, plus\n  // .user_menu/.create_menu/.help_button), which sit 7px lower than the rest of\n  // the header. header_left and header_right share the same base margin-top, so\n  // this lines the scrapbook button's top edge up with the user menu.\n  margin-top: 7px;\n}\n"],sourceRoot:""}]),a.locals={button:"CXjlFUsxNF6EzmPnzkGj"};const s=a},5675:(t,e,n)=>{"use strict";n.d(e,{A:()=>s});var o=n(13),r=n.n(o),i=n(14),a=n.n(i)()(r());a.push([t.id,".introjs-helperLayer{box-shadow:var(--neutral-black-alpha-50) 0 0 0 5000px !important}.introjs-arrow{border-width:10px}.introjs-arrow.top,.introjs-arrow.top-right,.introjs-arrow.top-middle{top:-18px}.introjs-arrow.right{right:-18px}.introjs-arrow.right-bottom{bottom:18px}.introjs-arrow.bottom,.introjs-arrow.bottom-right,.introjs-arrow.bottom-middle{bottom:-18px}.introjs-arrow.left,.introjs-arrow.left-bottom{left:-18px}.introjs-tooltip{width:400px;max-width:400px;border:1px solid var(--background-neutral-primary);box-shadow:0 3px 30px var(--background-neutral-black-fixed)}.introjs-tooltiptext{padding:0 24px}.introjs-tooltiptext p{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;font-size:.75rem}.introjs-tooltip-title{font-family:var(--font-family-main);font-weight:var(--font-weight-semi-bold);color:var(--text-neutral-primary);font-size:1rem}.introjs-tooltip-header{padding:24px 24px 0}.introjs-tooltipbuttons{padding:10px 24px}.introjs-button{font-family:var(--font-family-main);font-weight:var(--font-weight-regular);font-style:normal;padding:8px 16px 6px;font-size:.75rem;text-shadow:none;border-radius:4px}.introjs-button:focus{box-shadow:0 0 0 .2rem var(--text-neutral-tertiary)}.introjs-prevbutton{color:var(--text-brand-purple-primary);border:1px solid var(--borders-brand-purple-primary);background-color:var(--background-neutral-primary)}.introjs-prevbutton:hover,.introjs-prevbutton:active,.introjs-prevbutton:focus,.introjs-prevbutton:visited{color:var(--text-neutral-white-fixed);background-color:var(--background-brand-purple-light);text-decoration:none;box-shadow:none}.introjs-nextbutton{color:var(--text-neutral-white-fixed);border:none;background-color:var(--background-brand-purple-primary)}.introjs-nextbutton:hover,.introjs-nextbutton:active,.introjs-nextbutton:focus,.introjs-nextbutton:visited{color:var(--text-neutral-white-fixed);background-color:var(--background-brand-purple-strong);text-decoration:none;border:none;box-shadow:none}","",{version:3,sources:["webpack://./src/templates/rubrics/introjsOverrides.scss","webpack://./../frontend/packages/component-library-styles/font.scss"],names:[],mappings:"AASA,qBACE,gEAAA,CAIF,eACE,iBAAA,CAEF,sEAGE,SAAA,CAEF,qBACE,WAAA,CAEF,4BACE,WAAA,CAEF,+EAGE,YAAA,CAEF,+CAEE,UAAA,CAIF,iBACE,WAAA,CACA,eAAA,CACA,kDAAA,CACA,2DAAA,CAEF,qBACE,cAAA,CAEA,uBCLA,mCAAA,CACA,sCAAA,CACA,iBAAA,CDKE,gBAAA,CAGJ,uBACE,mCAAA,CACA,wCAAA,CACA,iCAAA,CACA,cAAA,CAEF,wBACE,mBAAA,CAEF,wBACE,iBAAA,CAIF,gBCxBE,mCAAA,CACA,sCAAA,CACA,iBAAA,CDwBA,oBAAA,CACA,gBAAA,CACA,gBAAA,CACA,iBAAA,CAEF,sBACE,mDAAA,CAIF,oBACE,sCAAA,CACA,oDAAA,CACA,kDAAA,CAEA,2GAIE,qCAAA,CACA,qDAAA,CACA,oBAAA,CACA,eAAA,CAKJ,oBACE,qCAAA,CACA,WAAA,CACA,uDAAA,CAEA,2GAIE,qCAAA,CACA,sDAAA,CACA,oBAAA,CACA,WAAA,CACA,eAAA",sourcesContent:["// code.org theme overrides for intro.js product tours.\n// Base styles ship with the library and are imported separately\n// ('intro.js/introjs.css' in RubricContainer.jsx). Only the deltas from those\n// defaults live here. Selectors mirror the library's, so this file must load\n// after the base stylesheet to win on equal specificity.\n\n@import '@code-dot-org/component-library-styles/font';\n\n// Spotlight: dim the page around the highlighted element.\n.introjs-helperLayer {\n  box-shadow: var(--neutral-black-alpha-50) 0 0 0 5000px !important;\n}\n\n// Larger tooltip arrows, repositioned to sit clear of the wider border.\n.introjs-arrow {\n  border-width: 10px;\n}\n.introjs-arrow.top,\n.introjs-arrow.top-right,\n.introjs-arrow.top-middle {\n  top: -18px;\n}\n.introjs-arrow.right {\n  right: -18px;\n}\n.introjs-arrow.right-bottom {\n  bottom: 18px;\n}\n.introjs-arrow.bottom,\n.introjs-arrow.bottom-right,\n.introjs-arrow.bottom-middle {\n  bottom: -18px;\n}\n.introjs-arrow.left,\n.introjs-arrow.left-bottom {\n  left: -18px;\n}\n\n// Wider tooltip with a code.org surface and shadow.\n.introjs-tooltip {\n  width: 400px;\n  max-width: 400px;\n  border: 1px solid var(--background-neutral-primary);\n  box-shadow: 0 3px 30px var(--background-neutral-black-fixed);\n}\n.introjs-tooltiptext {\n  padding: 0 24px;\n\n  p {\n    @include main-font-regular;\n    font-size: 0.75rem;\n  }\n}\n.introjs-tooltip-title {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-primary);\n  font-size: 1rem;\n}\n.introjs-tooltip-header {\n  padding: 24px 24px 0;\n}\n.introjs-tooltipbuttons {\n  padding: 10px 24px;\n}\n\n// Buttons: code.org typography and shape.\n.introjs-button {\n  @include main-font-regular;\n  padding: 8px 16px 6px;\n  font-size: 0.75rem;\n  text-shadow: none;\n  border-radius: 4px;\n}\n.introjs-button:focus {\n  box-shadow: 0 0 0 0.2rem var(--text-neutral-tertiary);\n}\n\n// Previous: outlined purple.\n.introjs-prevbutton {\n  color: var(--text-brand-purple-primary);\n  border: 1px solid var(--borders-brand-purple-primary);\n  background-color: var(--background-neutral-primary);\n\n  &:hover,\n  &:active,\n  &:focus,\n  &:visited {\n    color: var(--text-neutral-white-fixed);\n    background-color: var(--background-brand-purple-light);\n    text-decoration: none;\n    box-shadow: none;\n  }\n}\n\n// Next: filled purple.\n.introjs-nextbutton {\n  color: var(--text-neutral-white-fixed);\n  border: none;\n  background-color: var(--background-brand-purple-primary);\n\n  &:hover,\n  &:active,\n  &:focus,\n  &:visited {\n    color: var(--text-neutral-white-fixed);\n    background-color: var(--background-brand-purple-strong);\n    text-decoration: none;\n    border: none;\n    box-shadow: none;\n  }\n}\n","// Common site-wide font mixins\n// Note: CSS variables are defined in fontVariables.css and should be imported\n// in your main SCSS entry point or application root to ensure they're available globally.\n// To use font styles, import this file and use the mixins:\n// @use '@code-dot-org/component-library-styles/font.scss' as font;\n// .myClass { @include font.main-font-bold; }\n// For inline styles in JSX/TSX, use CSS variables directly:\n// style={{ fontFamily: 'var(--font-family-main)', fontWeight: 'var(--font-weight-bold)' }}\n\n@mixin main-font-thin {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-thin);\n  font-style: normal;\n}\n\n@mixin main-font-thin-italic {\n  @include main-font-thin;\n  font-style: italic;\n}\n\n@mixin main-font-extra-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-light);\n  font-style: normal;\n}\n\n@mixin main-font-extra-light-italic {\n  @include main-font-extra-light;\n  font-style: italic;\n}\n\n@mixin main-font-light {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-light);\n  font-style: normal;\n}\n\n@mixin main-font-light-italic {\n  @include main-font-light;\n  font-style: italic;\n}\n\n@mixin main-font-regular {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-regular);\n  font-style: normal;\n}\n\n@mixin main-font-regular-italic {\n  @include main-font-regular;\n  font-style: italic;\n}\n\n@mixin main-font-medium {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-medium);\n  font-style: normal;\n}\n\n@mixin main-font-medium-italic {\n  @include main-font-medium;\n  font-style: italic;\n}\n\n@mixin main-font-semi-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  font-style: normal;\n}\n\n@mixin main-font-semi-bold-italic {\n  @include main-font-semi-bold;\n  font-style: italic;\n}\n\n@mixin main-font-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  font-style: normal;\n}\n\n@mixin main-font-bold-italic {\n  @include main-font-bold;\n  font-style: italic;\n}\n\n@mixin main-font-extra-bold {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-extra-bold);\n  font-style: normal;\n}\n\n@mixin main-font-extra-bold-italic {\n  @include main-font-extra-bold;\n  font-style: italic;\n}\n\n@mixin main-font-black {\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-black);\n  font-style: normal;\n}\n\n@mixin main-font-black-italic {\n  @include main-font-black;\n  font-style: italic;\n}\n\n/*\n   Font Awesome S3 Bucket URLs\n   Current version: 6.6.0\n   If you are changing the location of these files,\n   see the readme in this directory for more detail on manual steps to take when uploading new files.\n */\n$font-awesome-core-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/fontawesome.min.css';\n$font-awesome-brands-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/brands.min.css';\n$font-awesome-solid-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/solid.min.css';\n$font-awesome-regular-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/regular.min.css';\n$font-awesome-v4-fonts-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-font-face.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-v4-shims-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/v4-shims.min.css';\n$font-awesome-duotone-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/duotone.min.css';\n$font-awesome-custom-icons-url: 'https://dsco.code.org/assets/font-awesome-pro/1779470619/css/custom-icons.min.css';\n"],sourceRoot:""}]);const s=a},5374:(t,e,n)=>{"use strict";
